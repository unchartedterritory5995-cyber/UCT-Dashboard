{
	"compilerOptions": {
		"baseUrl": ".",
		"target": "ES2021",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["DOM", "ES2021"],
		"allowJs": true,
		"noImplicitAny": true,
		"moduleDetection": "force",
		"importHelpers": true,
		"strict": true,
		"noImplicitReturns": true,
		"noUncheckedIndexedAccess": true,
		"inlineSourceMap": true,
		"inlineSources": true,
		"forceConsistentCasingInFileNames": true,
		"allowSyntheticDefaultImports": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["src/test/**/*.ts"]
}
