//@version=6
// UCT rendering-parity fixture — second `plot.style_baseline` script (spec §4.1 floor is ≥2, not merely >0).
// Added 2026-09-19 per controller ruling — see .superpowers/sdd/2026-09-19-pine-primitive-coverage-matrix/progress.md.
indicator(title = "Fixture: baseline coverage 2", overlay = false)
fastEma = ta.ema(close, 12)
slowEma = ta.ema(close, 26)
macdHist = (fastEma - slowEma) - ta.ema(fastEma - slowEma, 9)
plot(macdHist, title = "MACD Histogram", style = plot.style_baseline, color = color.new(color.purple, 0))
