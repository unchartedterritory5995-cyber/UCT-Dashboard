//@version=6
indicator("Supertrend + Fibonacci OTE Grid & Bands [BigBeluga]", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ＩＮＰＵＴＳ ――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――{

// Group Names
GRP_GENERAL = "General Settings"
GRP_ST      = "Supertrend Parameters"
GRP_BANDS   = "Fibonacci Bands Parameters"
GRP_COLORS  = "Main Styling & Colors"
GRP_LEVELS  = "Fibonacci Level Settings"

// General Inputs
fibMode       = input.string("OTE Grid", "Fibonacci Mode", options=["OTE Grid", "Fibonacci Bands"], group=GRP_GENERAL, tooltip="Select between drawing an anchored OTE Grid per trend or continuous Fibonacci Bands based on ATR.")
showLabels    = input.bool(true, "Show Fibonacci Labels", group=GRP_GENERAL, tooltip="Toggle right-edge text labels displaying ratio values and current price levels.")
gridLineStyle = input.string("Dotted", "Grid Line Style", options=["Solid", "Dotted", "Dashed"], group=GRP_GENERAL, tooltip="Select the visual line style for drawing the OTE Grid levels.")
proxThreshold = input.float(1.0, "Grid Highlight Distance (ATR Multiplier)", minval=0.01, step=0.05, group=GRP_GENERAL, tooltip="Sensitivity multiplier using ATR to highlight a grid level when price closes near it.")
nonOteDim     = input.bool(false, "Dim Non-OTE Levels when Far", group=GRP_GENERAL, tooltip="When enabled, non-OTE levels use a translucent version of their input color until price approaches.")

// Supertrend Inputs
stAtrPeriod   = input.int(100, "Supertrend ATR Period", minval=1, group=GRP_ST, tooltip="Lookback period for Average True Range calculation driving the Supertrend stop line.")
stFactor      = input.float(4.5, "Supertrend Multiplier", minval=0.1, step=0.1, group=GRP_ST, tooltip="Multiplier applied to ATR to adjust distance of the Supertrend stop loss line.")

// Fibonacci Bands Inputs
atrLength     = input.int(100, "Bands ATR Period", minval=1, group=GRP_BANDS, tooltip="ATR length used specifically to calculate dynamic channel width in Fibonacci Bands mode.")
outerRatio    = input.float(2.000, "Max Band ATR Multiplier", step=0.1, group=GRP_BANDS, tooltip="Multiplier controlling the max distance (1.000 ratio band) relative to ATR in Bands mode.")

// Main Visual Styling Inputs
colUp         = input.color(#26c477, "Bullish Trend", group=GRP_COLORS, tooltip="Color used for bullish trend elements, lines, and text.")
colDn         = input.color(#2692c4, "Bearish Trend", group=GRP_COLORS, tooltip="Color used for bearish trend elements, lines, and text.")
colorCloseLVL = input.color(#FFD600, "Active Fibonacci Level", group=GRP_COLORS, tooltip="Color highlight level when price is close to it")

// Bar & Candle Color Toggles
useBarColor   = input.bool(true, "Color Bars by Trend", group=GRP_COLORS, tooltip="Color the standard chart bars/candles according to the Supertrend direction.")
usePlotCandle = input.bool(true, "Plot Trend Candles", group=GRP_COLORS, tooltip="Plot custom candles colored according to the Supertrend direction.")

// Fibonacci Level Inputs (Visibility Toggle + Color Inline)
show0   = true
col0    = input.color(#787B86, "0.000 Level", group=GRP_LEVELS, inline="f0", tooltip="Toggle visibility and set color for 0.000 level.")

show236 = input.bool(true, "", group=GRP_LEVELS, inline="f0_2")
col236  = input.color(#787B86, "0.236 Level", group=GRP_LEVELS, inline="f0_2", tooltip="Toggle visibility and set color for 0.236 level.")

show382 = input.bool(true, "", group=GRP_LEVELS, inline="f1")
col382  = input.color(#787B86, "0.382 Level", group=GRP_LEVELS, inline="f1", tooltip="Toggle visibility and set color for 0.382 level.")

show50  = input.bool(true, "", group=GRP_LEVELS, inline="f1_2")
col50   = input.color(#787B86, "0.500 Level", group=GRP_LEVELS, inline="f1_2", tooltip="Toggle visibility and set color for 0.500 level.")

show618 = input.bool(true, "OTE 0.618", group=GRP_LEVELS, inline="f2")
show705 = input.bool(true, "OTE 0.705", group=GRP_LEVELS, inline="f2_2")
show786 = input.bool(true, "OTE 0.786", group=GRP_LEVELS, inline="f3")

show100 = true
col100  = input.color(#787B86, "1.000 Level", group=GRP_LEVELS, inline="f3_2", tooltip="Toggle visibility and set color for 1.000 level.")

// }
// ＣＡＬＣＵＬＡＴＩＯＮＳ――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――{

// Supertrend Core Logic
[supertrend, dir] = ta.supertrend(stFactor, stAtrPeriod)

var float trendHigh = high
var float trendLow  = low

HH = ta.highest(5)
LL = ta.lowest(5)

// Track Trend Extremes
if dir != dir[1]
    trendHigh := dir < 0 ? high : HH
    trendLow  := dir < 0 ? LL : low
else
    trendHigh := math.max(trendHigh, high)
    trendLow  := math.min(trendLow, low)

// Fibonacci Bands Calculations
float bandAtr = ta.atr(atrLength)
bool isBands  = fibMode == "Fibonacci Bands"

float bandMultiplier = dir < 0 ? 1.0 : -1.0
float totalDist       = bandMultiplier * bandAtr * outerRatio

float fibB100 = isBands and show100 ? supertrend : na
float fibB786 = isBands and show786 ? supertrend + totalDist * (1.000 - 0.786) : na
float fibB705 = isBands and show705 ? supertrend + totalDist * (1.000 - 0.705) : na
float fibB618 = isBands and show618 ? supertrend + totalDist * (1.000 - 0.618) : na
float fibB50  = isBands and show50  ? supertrend + totalDist * (1.000 - 0.500) : na
float fibB382 = isBands and show382 ? supertrend + totalDist * (1.000 - 0.382) : na
float fibB236 = isBands and show236 ? supertrend + totalDist * (1.000 - 0.236) : na
float fibB0   = isBands and show0   ? supertrend + totalDist : na

// Dynamic OTE Trend Colors
color trendBaseCol = dir < 0 ? colUp : colDn
color colOte        = color.new(trendBaseCol, 20)
color colOteFill     = color.new(trendBaseCol, 85)

// Line Style Mapping Helper
getLineStyle(style) =>
    switch style
        "Solid"  => line.style_solid
        "Dotted" => line.style_dotted
        "Dashed" => line.style_dashed
        => line.style_dotted

// Grid Line Color and Width Resolution Helper
getGridProperties(float priceLevel, color inputCol, bool isOte, float threshold) =>
    bool isNear = math.abs(close - priceLevel) <= threshold
    color baseColor = isOte ? colOte : (nonOteDim ? color.new(inputCol, 60) : inputCol)
    color finalColor = isNear ? colorCloseLVL : baseColor
    int finalWidth = isNear ? 3 : 1
    [finalColor, finalWidth]

// }
// ＰＬＯＴ ――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――{
supTrendCol = dir < 0 ? colUp : colDn

// Bar Color & Plot Candle Visuals
color trendBodyCol   = dir < 0 ? colUp : colDn
color trendBorderCol = dir < 0 ? colUp : colDn
color trendWickCol   = dir < 0 ? colUp : colDn

barcolor(useBarColor ? trendBodyCol : na, title = "Trend Bar Color")

plotcandle(usePlotCandle ? open : na,
     usePlotCandle ? high : na,
     usePlotCandle ? low : na,
     usePlotCandle ? close : na,
     title = "Trend Candle Plot",
     color = trendBodyCol,
     wickcolor = trendWickCol,
     bordercolor = trendBorderCol)

// Plot Main Supertrend Stop Loss Line & Price Stream
pSupertrend = plot(dir != dir[1] ? na : supertrend, "Supertrend Stop Loss", color = supTrendCol, linewidth = 2, style = plot.style_linebr)
pClose      = plot(close, "Close Price Stream", display = display.none)

// Gradient Fill between Supertrend and Close Price
color stFillCol    = dir < 0 ? color.new(colUp, isBands ? 100 : 80) : color.new(colDn, isBands ? 100 : 80)
color closeFillCol = dir < 0 ? color.new(colUp, 100) : color.new(colDn, 100)

fill(pSupertrend, pClose, supertrend, close, stFillCol, closeFillCol, title = "Supertrend Gradient Fill")

// Plot Fibonacci Bands
plotStl = gridLineStyle == "Dotted" ? plot.linestyle_dotted : gridLineStyle == "Dashed" ? plot.linestyle_dashed : plot.linestyle_solid

p0   = plot(fibB0,   "Fib Band 0.000 (Outer)", color=col0, style=plot.style_linebr, linestyle = plotStl)
p236 = plot(fibB236, "Fib Band 0.236", color=col236, style=plot.style_linebr, linestyle = plotStl)
p382 = plot(fibB382, "Fib Band 0.382", color=col382, style=plot.style_linebr, linestyle = plotStl)
p50  = plot(fibB50,  "Fib Band 0.500", color=col50, style=plot.style_linebr, linestyle = plotStl)
p618 = plot(fibB618, "Fib Band 0.618 (OTE)", color=colOte, style=plot.style_linebr, linestyle = plotStl)
p705 = plot(fibB705, "Fib Band 0.705 (OTE)", color=colOte, style=plot.style_linebr, linestyle = plotStl)
p786 = plot(fibB786, "Fib Band 0.786 (OTE)", color=colOte, style=plot.style_linebr, linestyle = plotStl)

fill(p618, p786, color=isBands and show618 and show786 ? colOteFill : na, title="Bands OTE Fill")

// Dynamic Right-Edge Labels for Fibonacci Bands
var label lbB0 = na, var label lbB236 = na, var label lbB382 = na
var label lbB50 = na, var label lbB618 = na, var label lbB705 = na
var label lbB786 = na, var label lbB100 = na

if isBands and showLabels and barstate.islast
    label.delete(lbB0), label.delete(lbB236), label.delete(lbB382)
    label.delete(lbB50), label.delete(lbB618), label.delete(lbB705)
    label.delete(lbB786), label.delete(lbB100)

    if show0
        lbB0   := label.new(bar_index, fibB0, "0.000 (" + str.tostring(fibB0, "#.##") + ")", color=color.new(color.black, 100), textcolor=col0, style=label.style_label_left)
    if show236
        lbB236 := label.new(bar_index, fibB236, "0.236 (" + str.tostring(fibB236, "#.##") + ")", color=color.new(color.black, 100), textcolor=col236, style=label.style_label_left)
    if show382
        lbB382 := label.new(bar_index, fibB382, "0.382 (" + str.tostring(fibB382, "#.##") + ")", color=color.new(color.black, 100), textcolor=col382, style=label.style_label_left)
    if show50
        lbB50  := label.new(bar_index, fibB50, "0.500 (" + str.tostring(fibB50, "#.##") + ")", color=color.new(color.black, 100), textcolor=col50, style=label.style_label_left)
    if show618
        lbB618 := label.new(bar_index, fibB618, "0.618 OTE (" + str.tostring(fibB618, "#.##") + ")", color=color.new(color.black, 100), textcolor=colOte, style=label.style_label_left)
    if show705
        lbB705 := label.new(bar_index, fibB705, "0.705 OTE (" + str.tostring(fibB705, "#.##") + ")", color=color.new(color.black, 100), textcolor=colOte, style=label.style_label_left)
    if show786
        lbB786 := label.new(bar_index, fibB786, "0.786 OTE (" + str.tostring(fibB786, "#.##") + ")", color=color.new(color.black, 100), textcolor=colOte, style=label.style_label_left)
    if show100
        lbB100 := label.new(bar_index, fibB100, "1.000 ST (" + str.tostring(fibB100, "#.##") + ")", color=color.new(color.black, 100), textcolor=col100, style=label.style_label_left)

// OTE Grid Drawings (Lines, Fill & Labels)
var line l0 = na, var line l236 = na, var line l382 = na
var line l50 = na, var line l618 = na, var line l705 = na
var line l786 = na, var line l100 = na
var linefill oteFill = na

var label lbl0 = na, var label lbl236 = na, var label lbl382 = na
var label lbl50 = na, var label lbl618 = na, var label lbl705 = na
var label lbl786 = na, var label lbl100 = na

if dir != dir[1] or fibMode != "OTE Grid"
    line.delete(l0), line.delete(l236), line.delete(l382)
    line.delete(l50), line.delete(l618), line.delete(l705)
    line.delete(l786), line.delete(l100)
    label.delete(lbl0), label.delete(lbl236), label.delete(lbl382)
    label.delete(lbl50), label.delete(lbl618), label.delete(lbl705)
    label.delete(lbl786), label.delete(lbl100)

if fibMode == "OTE Grid"
    float f0 = na, float f236 = na, float f382 = na
    float f50 = na, float f618 = na, float f705 = na
    float f786 = na, float f100 = na

    if dir < 0
        f0   := trendHigh
        f100 := trendLow
        float diff = f0 - f100
        f236 := f0 - diff * 0.236
        f382 := f0 - diff * 0.382
        f50  := f0 - diff * 0.500
        f618 := f0 - diff * 0.618
        f705 := f0 - diff * 0.705
        f786 := f0 - diff * 0.786
    else
        f0   := trendLow
        f100 := trendHigh
        float diff = f100 - f0
        f236 := f0 + diff * 0.236
        f382 := f0 + diff * 0.382
        f50  := f0 + diff * 0.500
        f618 := f0 + diff * 0.618
        f705 := f0 + diff * 0.705
        f786 := f0 + diff * 0.786

    styleEnum = getLineStyle(gridLineStyle)
    float proximityRange = bandAtr * proxThreshold

    // Dynamically resolve properties using trend-based colors for OTE levels
    [c0, w0]     = getGridProperties(f0, col0, false, proximityRange)
    [c236, w236] = getGridProperties(f236, col236, false, proximityRange)
    [c382, w382] = getGridProperties(f382, col382, false, proximityRange)
    [c50, w50]   = getGridProperties(f50, col50, false, proximityRange)
    [c618, w618] = getGridProperties(f618, colOte, true, proximityRange)
    [c705, w705] = getGridProperties(f705, colOte, true, proximityRange)
    [c786, w786] = getGridProperties(f786, colOte, true, proximityRange)
    [c100, w100] = getGridProperties(f100, col100, false, proximityRange)

    if dir != dir[1] or na(l0)
        l0   := show0   ? line.new(bar_index, f0, bar_index + 1, f0, color=c0, width=w0, style=styleEnum) : na
        l236 := show236 ? line.new(bar_index, f236, bar_index + 1, f236, color=c236, width=w236, style=styleEnum) : na
        l382 := show382 ? line.new(bar_index, f382, bar_index + 1, f382, color=c382, width=w382, style=styleEnum) : na
        l50  := show50  ? line.new(bar_index, f50, bar_index + 1, f50, color=c50, width=w50, style=styleEnum) : na
        l618 := show618 ? line.new(bar_index, f618, bar_index + 1, f618, color=c618, width=w618, style=styleEnum) : na
        l705 := show705 ? line.new(bar_index, f705, bar_index + 1, f705, color=c705, width=w705, style=styleEnum) : na
        l786 := show786 ? line.new(bar_index, f786, bar_index + 1, f786, color=c786, width=w786, style=styleEnum) : na
        l100 := show100 ? line.new(bar_index, f100, bar_index + 1, f100, color=c100, width=w100, style=styleEnum) : na

        if show618 and show786
            oteFill := linefill.new(l618, l786, colOteFill)

        if showLabels
            lbl0   := show0   ? label.new(bar_index + 1, f0, "0.000 (" + str.tostring(f0, "#.##") + ")", color=color.new(color.black, 100), textcolor=c0, style=label.style_label_left) : na
            lbl236 := show236 ? label.new(bar_index + 1, f236, "0.236 (" + str.tostring(f236, "#.##") + ")", color=color.new(color.black, 100), textcolor=c236, style=label.style_label_left) : na
            lbl382 := show382 ? label.new(bar_index + 1, f382, "0.382 (" + str.tostring(f382, "#.##") + ")", color=color.new(color.black, 100), textcolor=c382, style=label.style_label_left) : na
            lbl50  := show50  ? label.new(bar_index + 1, f50, "0.500 (" + str.tostring(f50, "#.##") + ")", color=color.new(color.black, 100), textcolor=c50, style=label.style_label_left) : na
            lbl618 := show618 ? label.new(bar_index + 1, f618, "0.618 OTE (" + str.tostring(f618, "#.##") + ")", color=color.new(color.black, 100), textcolor=c618, style=label.style_label_left) : na
            lbl705 := show705 ? label.new(bar_index + 1, f705, "0.705 OTE (" + str.tostring(f705, "#.##") + ")", color=color.new(color.black, 100), textcolor=c705, style=label.style_label_left) : na
            lbl786 := show786 ? label.new(bar_index + 1, f786, "0.786 OTE (" + str.tostring(f786, "#.##") + ")", color=color.new(color.black, 100), textcolor=c786, style=label.style_label_left) : na
            lbl100 := show100 ? label.new(bar_index + 1, f100, "1.000 (" + str.tostring(f100, "#.##") + ")", color=color.new(color.black, 100), textcolor=c100, style=label.style_label_left) : na
    else
        if show0
            line.set_xy1(l0, line.get_x1(l0), f0), line.set_xy2(l0, bar_index + 1, f0), line.set_color(l0, c0), line.set_width(l0, w0)
        if show236
            line.set_xy1(l236, line.get_x1(l236), f236), line.set_xy2(l236, bar_index + 1, f236), line.set_color(l236, c236), line.set_width(l236, w236)
        if show382
            line.set_xy1(l382, line.get_x1(l382), f382), line.set_xy2(l382, bar_index + 1, f382), line.set_color(l382, c382), line.set_width(l382, w382)
        if show50
            line.set_xy1(l50, line.get_x1(l50), f50), line.set_xy2(l50, bar_index + 1, f50), line.set_color(l50, c50), line.set_width(l50, w50)
        if show618
            line.set_xy1(l618, line.get_x1(l618), f618), line.set_xy2(l618, bar_index + 1, f618), line.set_color(l618, c618), line.set_width(l618, w618)
        if show705
            line.set_xy1(l705, line.get_x1(l705), f705), line.set_xy2(l705, bar_index + 1, f705), line.set_color(l705, c705), line.set_width(l705, w705)
        if show786
            line.set_xy1(l786, line.get_x1(l786), f786), line.set_xy2(l786, bar_index + 1, f786), line.set_color(l786, c786), line.set_width(l786, w786)
        if show100
            line.set_xy1(l100, line.get_x1(l100), f100), line.set_xy2(l100, bar_index + 1, f100), line.set_color(l100, c100), line.set_width(l100, w100)

        if show618 and show786 and not na(oteFill)
            linefill.set_color(oteFill, colOteFill)

        if showLabels
            if show0
                label.set_xy(lbl0, bar_index + 1, f0), label.set_text(lbl0, "0.000 (" + str.tostring(f0, "#.##") + ")"), label.set_textcolor(lbl0, c0)
            if show236
                label.set_xy(lbl236, bar_index + 1, f236), label.set_text(lbl236, "0.236 (" + str.tostring(f236, "#.##") + ")"), label.set_textcolor(lbl236, c236)
            if show382
                label.set_xy(lbl382, bar_index + 1, f382), label.set_text(lbl382, "0.382 (" + str.tostring(f382, "#.##") + ")"), label.set_textcolor(lbl382, c382)
            if show50
                label.set_xy(lbl50, bar_index + 1, f50), label.set_text(lbl50, "0.500 (" + str.tostring(f50, "#.##") + ")"), label.set_textcolor(lbl50, c50)
            if show618
                label.set_xy(lbl618, bar_index + 1, f618), label.set_text(lbl618, "0.618 OTE (" + str.tostring(f618, "#.##") + ")"), label.set_textcolor(lbl618, c618)
            if show705
                label.set_xy(lbl705, bar_index + 1, f705), label.set_text(lbl705, "0.705 OTE (" + str.tostring(f705, "#.##") + ")"), label.set_textcolor(lbl705, c705)
            if show786
                label.set_xy(lbl786, bar_index + 1, f786), label.set_text(lbl786, "0.786 OTE (" + str.tostring(f786, "#.##") + ")"), label.set_textcolor(lbl786, c786)
            if show100
                label.set_xy(lbl100, bar_index + 1, f100), label.set_text(lbl100, "1.000 (" + str.tostring(f100, "#.##") + ")"), label.set_textcolor(lbl100, c100)

// }
