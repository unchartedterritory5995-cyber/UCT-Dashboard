//@version=6
indicator("vw-w6-forin-polyline-all", overlay = false)

// PROVENANCE: written 2026-11-07 for the Pine parity programme from row W6-F1 of
// docs/pine/capture-queue-2026-11-06-w6-t6.md, whose shapes are W6-BREAKDOWN.md section 6's W6-F1 row
// (branch docs/pine-w6-breakdown): "`for p in polyline.all` after two `polyline.new` and one
// `polyline.delete`". One shape of W6-F1 per file. No licence-held text.
// NEVER COMPILED ON TRADINGVIEW: a line that does not compile IS a reading - record the error text and the line.
// QUESTION: after two polylines are made and one deleted (on the first bar), how many passes does
// `for p in polyline.all` run (P01), beside `array.size(polyline.all)` (P02)?
// Our runtime lane refuses it by name: "`polyline.all` is not yet captured" (W6-F1). A00 is the control.
// CAPTURE: NYSE:RDDT 1D, inputs at defaults.

plot(bar_index, "A00_bar_index_CONTROL")

if barstate.isfirst
    pts = array.from(chart.point.from_index(bar_index, low), chart.point.from_index(bar_index + 1, high))
    p1 = polyline.new(pts)
    p2 = polyline.new(pts)
    polyline.delete(p1)

int n = 0
for p in polyline.all
    n += 1

plot(n, "P01_passes_over_polyline_all")
plot(array.size(polyline.all), "P02_size_of_polyline_all")
