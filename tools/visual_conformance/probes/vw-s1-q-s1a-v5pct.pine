//@version=5
strategy("vw-s1-q-s1a-v5pct", overlay = false, default_qty_type = strategy.percent_of_equity, default_qty_value = 100, initial_capital = 100000)

// PROVENANCE: written 2026-11-07 for the Pine parity programme from row Q-S1a of
// docs/pine/capture-queue-2026-10-05-s1.md (run 3 of 4: v5, percent of equity 100). One behaviour, no licence-held text.
// NEVER COMPILED ON TRADINGVIEW: a line that does not compile IS a reading - record the error text and the line.
// QUESTION: the position size on the fill bar (51) and on bar 79, and the CSV contracts: v4's unstated fixed value; v6's percent-of-equity default; which price sizes a percent / cash order (bar 50's close vs bar 51's open) and how it rounds.
// CAPTURE: NYSE:RDDT 1D, inputs at defaults, Strategy properties at the script's own defaults (Properties tab untouched);
// export the Strategy Tester List of trades as CSV beside the capture (the doc's header).

plot(bar_index, "A00_bar_index_CONTROL")

if bar_index == 50
    strategy.entry("L", strategy.long)
if bar_index == 80
    strategy.close("L")
plot(strategy.position_size, "A01_position_size")
plot(strategy.opentrades > 0 ? strategy.opentrades.size(0) : na, "A02_opentrades_size_0")
