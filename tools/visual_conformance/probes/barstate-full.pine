//@version=6
indicator("UCTPROBE_BARSTATE_FULL", overlay=false)
plot(bar_index, "N01_bar_index")
sNa = bar_index % 11 == 0 ? na : 1.0
plot(ta.cum(sNa), "N02_cum_na_contributes")
plot(ta.cum(1.0), "N03_cum_one")
sLate = bar_index < 8300 ? na : 1.0
plot(ta.cum(sLate), "N04_cum_late_start")
plot(timeframe.isdaily ? 1 : 0, "N05_isdaily")
plot(timeframe.isweekly ? 1 : 0, "N06_isweekly")
plot(timeframe.ismonthly ? 1 : 0, "N07_ismonthly")
tv = (bar_index % 997) / 7.0
plot(tv, "N08_tv")
plot(str.tonumber(str.tostring(tv, "0.00")), "N09_num_0_00")
plot(str.length(str.tostring(tv, "0.00")), "N10_len_0_00")
plot(str.tonumber(str.tostring(tv, "#.##")), "N11_num_hash_hash")
plot(str.length(str.tostring(tv, "#.##")), "N12_len_hash_hash")
plot(str.tonumber(str.tostring(tv, "#")), "N13_num_hash")
plot(str.length(str.tostring(tv, "#")), "N14_len_hash")
plot(str.tonumber(str.tostring(-tv, "0.00")), "N15_neg_num_0_00")
plot(str.length(str.tostring(-tv, "#.##")), "N16_neg_len_hash")
plot(str.contains(syminfo.ticker, "/") ? 1 : 0, "N17_ticker_slash")
plot(str.contains(syminfo.tickerid, "/") ? 1 : 0, "N18_tickerid_slash")
plot(str.length(syminfo.ticker), "N19_ticker_len")
plot(str.length(syminfo.tickerid), "N20_tickerid_len")
plot(barstate.isconfirmed ? 1 : 0, "N21_isconfirmed")
plot(barstate.islast ? 1 : 0, "N22_islast")
plot(barstate.ishistory ? 1 : 0, "N23_ishistory")
plot(barstate.isrealtime ? 1 : 0, "N24_isrealtime")
plot(barstate.isnew ? 1 : 0, "N25_isnew")
plot(barstate.islastconfirmedhistory ? 1 : 0, "N26_islastconfirmedhistory")
