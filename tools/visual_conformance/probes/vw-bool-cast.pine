//@version=5
indicator("UCTPROBE_VW_BOOL_CAST_V5", overlay = false)

// ─── 2026-09-28 — A NUMBER IN A BOOL CONTEXT (Pine v5's implicit cast) ──────
//
// `pine.js::implicitBoolCast` reads a v5 numeric operand of `and`/`or`/`not`,
// a `?:`/`if` test, and a condition-role argument as `x != 0` — `na` false, 0
// false, anything else true — because TradingView's v6 migration guide says so
// verbatim. It is DOCUMENTED, NOT CAPTURED. This probe settles it.
//
// `x` cycles na → 0.0 → close, so every row has a DIFFERENT answer under each
// of the three candidate readings, and a wrong reading shows as a wrong NUMBER:
//
//   reading                 x = na     x = 0     x = close
//   cast (documented)       false      false     true
//   not na(x)               false      TRUE      true        (0 is the tell)
//   na propagates           NA         false     true        (na is the tell)
//
// B07 is the corpus form the finding came from
// (`opening-range-initial-balance-opening-price__4a7416ab01`, line 26).
//
// ⛔ CAPTURE: AMEX:SPY 1D ≥ 200 bars AND AMEX:SPY 60, extended hours OFF,
// ≥ 300 bars (B07 needs intraday bars that open at 09:30). Inputs at defaults.
// A COMPILE FAILURE on any line is itself a reading — record the error text.

plot(bar_index, "B00_bar_index_CONTROL")
x = bar_index % 3 == 0 ? na : bar_index % 3 == 1 ? 0.0 : close
plot(na(x) ? 1 : x == 0 ? 2 : 3, "B09_x_CLASS_1na_2zero_3value")
plot(x and true ? 1 : 2,  "B01_and")
plot(not x ? 1 : 2,       "B02_not")
plot(x or false ? 1 : 2,  "B03_or")
plot(x ? 1 : 2,           "B04_ternary_test")
y = 0
if x
    y := 1
else
    y := 2
plot(y, "B05_if_else")
plot(ta.valuewhen(x, bar_index, 0), "B06_valuewhen_condition_arg")
t = time(timeframe.period, "0930-1000:1234567", "GMT-4")
plot(t and not(t[1]) ? 1 : 0, "B07_corpus_time_membership_first_bar")
plot(na(t) ? 1 : 0, "B08_t_is_na_CONTROL")
