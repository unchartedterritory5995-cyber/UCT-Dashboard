//@version=6
indicator("UCTPROBE_VW_INPUT_TIME_ZONES", overlay = false)

// PROVENANCE: written 2026-11-07 for the Pine parity programme, capture queue row Q-D2
// (docs/pine/capture-queue-2026-10-31-wsd-input-kinds.md). NEVER COMPILED ON TRADINGVIEW.
// Q-D1's probe shape with zoned date strings. Each input is read as the instant (UNIX ms, T0N) and
// the first bar plotting 1 (D0N). Expected on our parser:
//   T01  "01 Jan 2000 00:00:00 GMT+10"           UTC+10      -> 946648800000
//   T02  "01 Jan 2000 00:00 +530"                UTC+05:30   -> 946665000000 (TradingView unmeasured)
//   T03  timestamp("UTC+5:30", 2000, 1, 1, 0, 0) UTC+05:30   -> 946665000000
// CAPTURE: AMEX:SPY 1D, inputs at defaults.

t1 = input.time(timestamp("01 Jan 2000 00:00:00 GMT+10"), "t1")
t2 = input.time(timestamp("01 Jan 2000 00:00 +530"), "t2")
t3 = input.time(timestamp("UTC+5:30", 2000, 1, 1, 0, 0), "t3")

plot(bar_index, "A00_bar_index_CONTROL")
plot(t1, "T01_gmt_plus_10_ms")
plot(t2, "T02_plus_530_ms")
plot(t3, "T03_utc_plus_5_30_ms")
plot(time >= t1 ? 1 : 0, "D01_time_ge_t1")
plot(time >= t2 ? 1 : 0, "D02_time_ge_t2")
plot(time >= t3 ? 1 : 0, "D03_time_ge_t3")
