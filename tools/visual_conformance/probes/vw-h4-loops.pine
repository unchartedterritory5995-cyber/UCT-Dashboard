//@version=5
// H4 (step 76) — loops on the runtime lane: three shapes, each a plot with a STATIC
// colour so the runtime document draws it. Chart: NYSE:RDDT 1D from the listing
// (a second witness: AMEX:SPY 1D). Each row is a number the engine's runtime lane
// already computes; the capture says whether TradingView prints the same.
indicator("vw-h4-loops", overlay=false)

a = input.int(5, "a")
b = input.int(8, "b")

// L1 — a counted `for` running total in a helper whose length is constant
// ARITHMETIC at the call site (`a + b` = 13), the volume-divergence-by-mm shape.
wsum(x, y) =>
    norm = 0.0
    s = 0.0
    for i = 0 to y - 1
        w = (y - i) * y
        norm := norm + w
        f = close[i] < open[i] ? -1 : 1
        s := s + x[i] * w * f
    s / norm
plot(wsum(close, a + b), "L1 wsum(close, a+b)", color=color.blue)

// L2 — a helper whose body ends in an `if` around a `for` (valueless, called for
// its effect), seeding a state array once; the kalman-price-filter shape.
var float[] st = array.new_float(3, na)
seed(p) =>
    if na(array.get(st, 0))
        for i = 0 to 2
            array.set(st, i, p)
seed(close)
for i = 0 to 2
    array.set(st, i, array.get(st, i) + 0.5 * (close - array.get(st, i)))
plot(array.get(st, 0), "L2 seeded filter", color=color.orange)

// L3 — `array.size(array.from(...))` as a loop bound (= 3 on every bar), the
// nadaraya-watson shape; and a top-level running total (ruling R7).
n = array.size(array.from(open, high, close))
t = 0.0
for i = 0 to n - 1
    t := t + close[i]
plot(t, "L3 sum of last n closes", color=color.green)
plot(n, "L3 n", color=color.gray)
