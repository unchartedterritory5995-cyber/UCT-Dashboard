    table.cell(t, 0, 6, "B06 ##.########")
    table.cell(t, 1, 6, str.tostring(v1, "##.########") + " | " + str.tostring(v2, "##.########") + " | " + str.tostring(v3, "##.########") + " | " + str.tostring(v4, "##.########") + " | " + str.tostring(v5, "##.########") + " | " + str.tostring(v6, "##.########") + " | " + str.tostring(v7, "##.########"))
    table.cell(t, 2, 6, str.tostring(v1, s06) + " | " + str.tostring(v2, s06) + " | " + str.tostring(v3, s06) + " | " + str.tostring(v4, s06) + " | " + str.tostring(v5, s06) + " | " + str.tostring(v6, s06) + " | " + str.tostring(v7, s06))
    table.cell(t, 3, 6, str.tostring(v1, b06) + " | " + str.tostring(v2, b06) + " | " + str.tostring(v3, b06) + " | " + str.tostring(v4, b06) + " | " + str.tostring(v5, b06) + " | " + str.tostring(v6, b06) + " | " + str.tostring(v7, b06))
    table.cell(t, 4, 6, str.tostring(v1, n06) + " | " + str.tostring(v2, n06) + " | " + str.tostring(v3, n06) + " | " + str.tostring(v4, n06) + " | " + str.tostring(v5, n06) + " | " + str.tostring(v6, n06) + " | " + str.tostring(v7, n06))
    table.cell(t, 0, 7, "B07 0.0000")
    table.cell(t, 1, 7, str.tostring(v1, "0.0000") + " | " + str.tostring(v2, "0.0000") + " | " + str.tostring(v3, "0.0000") + " | " + str.tostring(v4, "0.0000") + " | " + str.tostring(v5, "0.0000") + " | " + str.tostring(v6, "0.0000") + " | " + str.tostring(v7, "0.0000"))
    table.cell(t, 2, 7, str.tostring(v1, s07) + " | " + str.tostring(v2, s07) + " | " + str.tostring(v3, s07) + " | " + str.tostring(v4, s07) + " | " + str.tostring(v5, s07) + " | " + str.tostring(v6, s07) + " | " + str.tostring(v7, s07))
    table.cell(t, 3, 7, str.tostring(v1, b07) + " | " + str.tostring(v2, b07) + " | " + str.tostring(v3, b07) + " | " + str.tostring(v4, b07) + " | " + str.tostring(v5, b07) + " | " + str.tostring(v6, b07) + " | " + str.tostring(v7, b07))
    table.cell(t, 4, 7, str.tostring(v1, n07) + " | " + str.tostring(v2, n07) + " | " + str.tostring(v3, n07) + " | " + str.tostring(v4, n07) + " | " + str.tostring(v5, n07) + " | " + str.tostring(v6, n07) + " | " + str.tostring(v7, n07))
    table.cell(t, 0, 8, "B08 #")
