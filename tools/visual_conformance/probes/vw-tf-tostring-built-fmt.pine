    table.cell(t, 3, 5, str.tostring(v1, b05) + " | " + str.tostring(v2, b05) + " | " + str.tostring(v3, b05) + " | " + str.tostring(v4, b05) + " | " + str.tostring(v5, b05) + " | " + str.tostring(v6, b05) + " | " + str.tostring(v7, b05))
