//@version=5
strategy("vw-s1-q-s1l-off-grid-stop", overlay = false)

// PROVENANCE: written 2026-11-07 for the Pine parity programme from row Q-S1l of
// docs/pine/capture-queue-2026-10-05-s1.md. One behaviour, no licence-held text.
// NEVER COMPILED ON TRADINGVIEW: a line that does not compile IS a reading - record the error text and the line.
// QUESTION: an off-grid stop (close * 0.97): the CSV fill price to every decimal - rounded to the tick or not?
// CAPTURE: NYSE:RDDT 1D, inputs at defaults, Strategy properties at the script's own defaults (Properties tab untouched);
// export the Strategy Tester List of trades as CSV beside the capture (the doc's header).

plot(bar_index, "A00_bar_index_CONTROL")

if bar_index == 50
    strategy.entry("L", strategy.long)
if strategy.position_size > 0
    strategy.exit("x", "L", stop = close * 0.97)
plot(strategy.position_size, "P01_position_size")
