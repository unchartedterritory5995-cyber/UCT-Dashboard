//@version=6
indicator("vw-w3-format-number-bare", overlay = false)

// PROVENANCE: written 2026-11-07 for the Pine parity programme from the inline shape in
// docs/pine/capture-queue-2026-11-02-w3.md, W3 S1, row Q-W3-2 (shape S1-B). The code below these comments is that doc's text.
// NEVER COMPILED ON TRADINGVIEW: a line that does not compile IS a reading - record the error text and the line.
// QUESTION: whether {0,number} prints exactly as {0}: N01 = N02 and N03 = N04 on every bar, plus the four cell texts (grouping, 999.9995, -0.0004).
// CAPTURE: AMEX:SPY 1D, inputs at defaults.

plot(str.length(str.format("{0}", close)),        "N01_len_default")
plot(str.length(str.format("{0,number}", close)), "N02_len_number_bare")
plot(str.length(str.format("{0}", volume)),       "N03_len_default_volume")
plot(str.length(str.format("{0,number}", volume)),"N04_len_number_bare_volume")
if barstate.islast
    var table t = table.new(position.top_right, 1, 4)
    table.cell(t, 0, 0, str.format("{0}", 1234.5678))
    table.cell(t, 0, 1, str.format("{0,number}", 1234.5678))
    table.cell(t, 0, 2, str.format("{0}", 999.9995))
    table.cell(t, 0, 3, str.format("{0,number}", -0.0004))
