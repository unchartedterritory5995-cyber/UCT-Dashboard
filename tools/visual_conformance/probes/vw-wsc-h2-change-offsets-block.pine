//@version=6
indicator("UCTPROBE_VW_WSC_H2_CHANGE_OFFSETS_BLOCK", overlay = false, max_bars_back = 5000)

// PROVENANCE: written 2026-11-07 for the Pine parity programme, capture queue row H2
// (docs/pine/capture-queue-2026-10-31-wsc-history.md section Q3). NEVER COMPILED ON TRADINGVIEW.
// `ta.change` in a `?:` arm reads the previous RUN (vw-arm-history T05 / K03). This witnesses the
// same in an `if` BLOCK, and the offset forms: `ta.change(close)`, `ta.mom(close, 2)`,
// `ta.roc(close, 2)`, `ta.swma(close)`, under `close > open` (U*) and `bar_index % 2 == 0` (V*).
// E* are the every-bar answers.
// A warning that a call "should be called on each calculation" is fine; an error names its line:
// split that row out and capture the rest.
// CHART: the row names none (the queue marks it NEEDS_CHART); vw-arm-history, whose T05 / K03 this
// extends, was read on NYSE:RDDT 1D from the listing.

up = close > open
even = bar_index % 2 == 0

float u_change = na
float u_mom = na
float u_roc = na
float u_swma = na
if up
    u_change := ta.change(close)
    u_mom := ta.mom(close, 2)
    u_roc := ta.roc(close, 2)
    u_swma := ta.swma(close)

float v_change = na
float v_mom = na
float v_roc = na
float v_swma = na
if even
    v_change := ta.change(close)
    v_mom := ta.mom(close, 2)
    v_roc := ta.roc(close, 2)
    v_swma := ta.swma(close)

plot(bar_index, "A00_bar_index_CONTROL")
plot(up ? 1 : 0, "A01_up_CONTROL")
plot(ta.change(close), "E01_change_every_bar")
plot(ta.mom(close, 2), "E02_mom2_every_bar")
plot(ta.roc(close, 2), "E03_roc2_every_bar")
plot(ta.swma(close), "E04_swma_every_bar")
plot(u_change, "U01_change_in_up_block")
plot(u_mom, "U02_mom2_in_up_block")
plot(u_roc, "U03_roc2_in_up_block")
plot(u_swma, "U04_swma_in_up_block")
plot(v_change, "V01_change_in_even_block")
plot(v_mom, "V02_mom2_in_even_block")
plot(v_roc, "V03_roc2_in_even_block")
plot(v_swma, "V04_swma_in_even_block")
