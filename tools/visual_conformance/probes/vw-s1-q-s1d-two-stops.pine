//@version=5
strategy("vw-s1-q-s1d-two-stops", overlay = false, pyramiding = 2)

// PROVENANCE: written 2026-11-07 for the Pine parity programme from row Q-S1d of
// docs/pine/capture-queue-2026-10-05-s1.md (shape 3 of 3: two `strategy.exit` stops at the same price for two trades with different ids;
// the row gives no level: both use the bar's low, re-placed every bar, so they fill once a bar trades below it). One behaviour, no licence-held text.
// NEVER COMPILED ON TRADINGVIEW: a line that does not compile IS a reading - record the error text and the line.
// QUESTION: same-tick fill order: the CSV order and sizes, and strategy.position_size the next bar.
// CAPTURE: NYSE:RDDT 1D, inputs at defaults, Strategy properties at the script's own defaults (Properties tab untouched);
// export the Strategy Tester List of trades as CSV beside the capture (the doc's header).

plot(bar_index, "A00_bar_index_CONTROL")

if bar_index == 50
    strategy.entry("A", strategy.long)
if bar_index == 52
    strategy.entry("B", strategy.long)
if bar_index > 52 and strategy.opentrades > 0
    lvl = low
    strategy.exit("xa", "A", stop = lvl)
    strategy.exit("xb", "B", stop = lvl)
plot(strategy.position_size, "D01_position_size")
plot(strategy.opentrades, "D02_opentrades")
