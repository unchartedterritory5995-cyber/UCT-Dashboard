//@version=6
indicator("UCTPROBE_VW_FORMAT_PERCENT", overlay = true)

// PROVENANCE: written 2026-11-22 for the Pine parity programme, train e95 unit 1 (computed number formats).
// QUESTION: what `str.tostring(v, format.percent)` prints. UCT withholds every such text today (by name), because
// nothing settles: whether the value is scaled by 100 or printed as it is, how many decimals are kept (2? the
// symbol's mintick?), how a tie rounds (0.005, 0.575), the sign of a small negative (-0.004), grouping of a large
// value (1234.5, 1e6), and what `na` prints. Each row prints the same value through "#.##" beside it, the control
// the engine already serves.
// CAPTURE: NYSE:RDDT 1D and AMEX:SPY 1D, inputs at defaults; read every table cell's text.
// ROWS: P01-P12, columns: the value as written | format.percent | "#.##".

var table t = table.new(position.top_right, 3, 13, border_width = 1)
if barstate.islast
    table.cell(t, 0, 0, "value")
    table.cell(t, 1, 0, "format.percent")
    table.cell(t, 2, 0, "#.##")
    table.cell(t, 0, 1, "P01 0.126")
    table.cell(t, 1, 1, str.tostring(0.126, format.percent))
    table.cell(t, 2, 1, str.tostring(0.126, "#.##"))
    table.cell(t, 0, 2, "P02 -0.004")
    table.cell(t, 1, 2, str.tostring(-0.004, format.percent))
    table.cell(t, 2, 2, str.tostring(-0.004, "#.##"))
    table.cell(t, 0, 3, "P03 0.575")
    table.cell(t, 1, 3, str.tostring(0.575, format.percent))
    table.cell(t, 2, 3, str.tostring(0.575, "#.##"))
    table.cell(t, 0, 4, "P04 12.345")
    table.cell(t, 1, 4, str.tostring(12.345, format.percent))
    table.cell(t, 2, 4, str.tostring(12.345, "#.##"))
    table.cell(t, 0, 5, "P05 -7.5")
    table.cell(t, 1, 5, str.tostring(-7.5, format.percent))
    table.cell(t, 2, 5, str.tostring(-7.5, "#.##"))
    table.cell(t, 0, 6, "P06 0")
    table.cell(t, 1, 6, str.tostring(0.0, format.percent))
    table.cell(t, 2, 6, str.tostring(0.0, "#.##"))
    table.cell(t, 0, 7, "P07 0.005")
    table.cell(t, 1, 7, str.tostring(0.005, format.percent))
    table.cell(t, 2, 7, str.tostring(0.005, "#.##"))
    table.cell(t, 0, 8, "P08 0.0049")
    table.cell(t, 1, 8, str.tostring(0.0049, format.percent))
    table.cell(t, 2, 8, str.tostring(0.0049, "#.##"))
    table.cell(t, 0, 9, "P09 1234.5")
    table.cell(t, 1, 9, str.tostring(1234.5, format.percent))
    table.cell(t, 2, 9, str.tostring(1234.5, "#.##"))
    table.cell(t, 0, 10, "P10 1e6")
    table.cell(t, 1, 10, str.tostring(1e6, format.percent))
    table.cell(t, 2, 10, str.tostring(1e6, "#.##"))
    table.cell(t, 0, 11, "P11 0.12345678")
    table.cell(t, 1, 11, str.tostring(0.12345678, format.percent))
    table.cell(t, 2, 11, str.tostring(0.12345678, "#.##"))
    table.cell(t, 0, 12, "P12 na")
    table.cell(t, 1, 12, str.tostring(float(na), format.percent))
    table.cell(t, 2, 12, str.tostring(float(na), "#.##"))
plot(close, "A00_close_CONTROL")
