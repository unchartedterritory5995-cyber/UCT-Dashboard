//@version=6
indicator("UCTPROBE CAP5 version defaults v6", overlay = true, max_boxes_count = 10)
// CAP5 (2026-10-04) - objects triage "Captures still owed" row 14 / C37 "still not carried":
// "v6 unset box fill / cell text, v4 box border - the base default stands - a capture whose
// script leaves them unset". This file leaves them unset (its v4 twin is
// vw-cap5-version-defaults-v4.pine). Runbook: docs/pine/capture-round-5-runbook.md.
// Never compiled on TradingView: a compile error names the line - record it, delete that line.
// CAPTURE: NYSE:RDDT 1D (any depth). Read the box records' bgcolor / border_color and the
// cells' text / bgcolor / text_color as the capture stores them.
//   D01 box: nothing set        D02 box: border set, fill unset    D03 box: fill set, border unset
//   D04 cell: no text argument  D05 cell: text, no colours         D06 cell: text + bgcolor only
var table t = table.new(position.top_right, 3, 1)
if barstate.islast
    box.new(bar_index - 20, high, bar_index - 12, low)
    box.new(bar_index - 10, high * 1.02, bar_index - 4, low * 0.98, border_color = color.red)
    box.new(bar_index - 30, high * 1.04, bar_index - 24, low * 0.96, bgcolor = color.blue)
    table.cell(t, 0, 0)
    table.cell(t, 1, 0, "D05")
    table.cell(t, 2, 0, "D06", bgcolor = color.yellow)
plot(bar_index, "D00 bar_index CONTROL", display = display.data_window)
