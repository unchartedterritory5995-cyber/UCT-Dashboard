//@version=6
indicator("vw-udt-fn-global-history", overlay = false)

// PROVENANCE: written 2026-11-16 by the UDT coverage unit for queue row UDT-G1
// (docs/pine/capture-queue-2026-11-16-udt.md). No licence-held text. Never compiled on TradingView: a line
// that does not compile, or a runtime error, IS the reading (record its text and the bar it names).
// QUESTION: a function body reading a mutable GLOBAL's history, `g[n]`. Our runtime lane refuses it by name
// (`runtime:function-global-state`: "whose past a global's history inside a frame is has not been measured on
// a chart"). Is it the global's own committed series (the value at the END of an earlier bar), whatever the
// call site, the frame, or how often the function is called?
//   G01  `f() => g[1]` with `g` a `var` counter (g = bar_index + 1 at the call): bar_index?
//   G03  `m` reassigned AFTER the call each bar (m := bar_index * 10, call, m := m + 5): (bar_index - 1) * 10 + 5?
//   G04  a run-time offset, `g[bar_index % 3]`: bar_index + 1 - (bar_index % 3)?
//   G05  the function called only on even bars: the previous BAR's g (bar_index) or the previous CALL's?
//   G06  a plain (non-var) global reassigned with `:=` every bar (bolingger-bands-inside-bar-boxes' shape), [1]
// CAPTURE: NYSE:RDDT 1D from the listing, inputs at defaults (none), AFTER THE CLOSE. A00 is the control.
plot(bar_index, "A00_bar_index_CONTROL")

var float g = 0.0
g += 1
f1() =>
    g[1]
plot(f1(), "G01_var_global_hist_1_in_fn")

var float m = 0.0
m := bar_index * 10
f3() =>
    m[1]
r3 = f3()
m := m + 5
plot(r3, "G03_hist_of_global_reassigned_after_call")

f4(int n) =>
    g[n]
plot(f4(bar_index % 3), "G04_global_hist_runtime_offset")

f5() =>
    g[1]
float r5 = na
if bar_index % 2 == 0
    r5 := f5()
plot(r5, "G05_global_hist_in_fn_called_every_other_bar")

float bb = na
bb := close > open ? close : open
f6(int p) =>
    bb[p]
plot(f6(1), "G06_reassigned_global_hist_in_fn")
