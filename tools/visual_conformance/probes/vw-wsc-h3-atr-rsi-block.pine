//@version=6
indicator("UCTPROBE_VW_WSC_H3_ATR_RSI_BLOCK", overlay = false, max_bars_back = 5000)

// PROVENANCE: written 2026-11-07 for the Pine parity programme, capture queue row H3
// (docs/pine/capture-queue-2026-10-31-wsc-history.md section Q3). NEVER COMPILED ON TRADINGVIEW.
// In an `if` block, do `ta.atr(5)` and `ta.rsi(close, 5)` read the chart's previous bar (`close[1]`
// in the true range, the previous close in the RSI's change) or the previous RUN of the block?
// Under `close > open` (U*) and `bar_index % 2 == 0` (V*); E* are the every-bar answers.
// A warning that a call "should be called on each calculation" is fine; an error names its line:
// split that row out and capture the rest.
// CHART: the row names none (the queue marks it NEEDS_CHART); vw-call-site-history, whose block
// rows this extends, was read on NYSE:RDDT 1D from the listing.

up = close > open
even = bar_index % 2 == 0

float u_atr = na
float u_rsi = na
if up
    u_atr := ta.atr(5)
    u_rsi := ta.rsi(close, 5)

float v_atr = na
float v_rsi = na
if even
    v_atr := ta.atr(5)
    v_rsi := ta.rsi(close, 5)

plot(bar_index, "A00_bar_index_CONTROL")
plot(up ? 1 : 0, "A01_up_CONTROL")
plot(ta.atr(5), "E01_atr5_every_bar")
plot(ta.rsi(close, 5), "E02_rsi5_every_bar")
plot(u_atr, "U01_atr5_in_up_block")
plot(u_rsi, "U02_rsi5_in_up_block")
plot(v_atr, "V01_atr5_in_even_block")
plot(v_rsi, "V02_rsi5_in_even_block")
