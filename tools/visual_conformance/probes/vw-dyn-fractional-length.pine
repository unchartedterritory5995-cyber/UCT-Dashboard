//@version=6
indicator("UCTPROBE_VW_DYN_FRACTIONAL_LENGTH", overlay = false)

// PROVENANCE: written 2026-11-18 for the Pine parity programme (parity2, U-DYN `dynamic-history`), capture
// queue rows Q-DYN-1a/b (docs/pine/capture-queue-2026-11-18-parity2.md). NEVER COMPILED ON TRADINGVIEW.
// Siblings in older versions: `-v4`, `-v3`, `-v1` (no pragma).
//
// --- WHICH WHOLE NUMBER A FRACTIONAL LENGTH OR HISTORY OFFSET BECOMES ---
// Pine's `/` on two whole numbers keeps the fraction (`9 / 2` is 4.5). builtin:hull-moving-average passes
// `length / 2` as a `ta.wma` length, triangular-hull `40 / 3`, and builtin:detrended-price-oscillator reads
// `close[length / 2 + 1]`. Our lanes refuse each by name (`pine:window`, `pine:offset-literal`): floor, round
// half up and round half to even are all candidates. Each fractional row sits beside its two whole-number
// neighbours, so the row it equals on every bar is the rule; .5 rows at an even and an odd base split
// "half up" from "half to even". A row that does not compile is a reading: record the error and remove it.
//   W01 wma(9/2)=4.5   W02 wma(4)   W03 wma(5)
//   S01 sma(11/2)=5.5  S02 sma(5)   S03 sma(6)
//   S04 sma(13/2)=6.5  S05 sma(7)                (S03 is the 6 neighbour)
//   S06 sma(22/3)=7.33 S07 sma(8)                (S05 is the 7 neighbour)
//   W04 wma(40/3)=13.3 W05 wma(13)  W06 wma(14)
//   H01 close[21/2+1]=11.5  H02 close[11]  H03 close[12]
//   H04 close[13/2]=6.5     H05 close[7]                  (S03-style: close[6] is H06)
//   H06 close[6]
//   W07 wma(length/2) with `length = input.int(9)` (the builtin's own shape)
length = input.int(9, "length")
plot(ta.wma(close, 9 / 2), "W01_wma_9div2")
plot(ta.wma(close, 4), "W02_wma_4")
plot(ta.wma(close, 5), "W03_wma_5")
plot(ta.sma(close, 11 / 2), "S01_sma_11div2")
plot(ta.sma(close, 5), "S02_sma_5")
plot(ta.sma(close, 6), "S03_sma_6")
plot(ta.sma(close, 13 / 2), "S04_sma_13div2")
plot(ta.sma(close, 7), "S05_sma_7")
plot(ta.sma(close, 22 / 3), "S06_sma_22div3")
plot(ta.sma(close, 8), "S07_sma_8")
plot(ta.wma(close, 40 / 3), "W04_wma_40div3")
plot(ta.wma(close, 13), "W05_wma_13")
plot(ta.wma(close, 14), "W06_wma_14")
plot(close[21 / 2 + 1], "H01_close_21div2p1")
plot(close[11], "H02_close_11")
plot(close[12], "H03_close_12")
plot(close[13 / 2], "H04_close_13div2")
plot(close[7], "H05_close_7")
plot(close[6], "H06_close_6")
plot(ta.wma(close, length / 2), "W07_wma_input9div2")
