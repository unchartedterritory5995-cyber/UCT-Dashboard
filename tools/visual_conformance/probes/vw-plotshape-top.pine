plotshape(k(4), title = "triangleup huge k4", style = shape.triangleup, location = location.top, size = size.huge, color = color.new(color.blue, 0))
plotshape(k(5), title = "triangledown tiny k5", style = shape.triangledown, location = location.top, size = size.tiny, color = color.new(color.blue, 0))
