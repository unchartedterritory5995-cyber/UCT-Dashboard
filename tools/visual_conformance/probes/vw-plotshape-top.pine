//@version=6
// e99 marker probe: every plotshape shape x size at location.top, each combination on its own bar
// (bar = newest - k, k = shapeIndex*5 + sizeIndex, newest first), plus one plotchar at k = 61.
indicator("vw-plotshape-top", overlay = true, max_bars_back = 200)
k(int n) => bar_index == last_bar_index - n
plotshape(k(0), title = "triangleup tiny k0", style = shape.triangleup, location = location.top, size = size.tiny, color = color.new(color.blue, 0))
plotshape(k(1), title = "triangleup small k1", style = shape.triangleup, location = location.top, size = size.small, color = color.new(color.blue, 0))
plotshape(k(2), title = "triangleup normal k2", style = shape.triangleup, location = location.top, size = size.normal, color = color.new(color.blue, 0))
