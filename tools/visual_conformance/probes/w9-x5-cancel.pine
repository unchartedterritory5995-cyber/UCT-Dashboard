//@version=6
strategy("W9_X5_CANCEL", overlay = false, default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 2, max_labels_count = 500)

// W9-T3b, GENERATED by tools/vendor_harness/w9_probes.py: do not edit by hand (`--check` fails on a diff).
// Row W9-X5 on NYSE:RDDT 1D. Settles: strategy.cancel / cancel_all: an unfilled entry; an unfilled strategy.order and the exit waiting on it (released or kept); an open trade's bracket and an unfilled entry under cancel_all
// Capture with tools/vendor_harness/tv_capture.js (gradeMethod set; settings read back). Never the CSV, never exportData().
// The exit id on each close's label answers (b) and (c): `xo` on eo2's close means the exit bound the re-placed order; `flat` means it was released. (c): `xc` means cancel_all left the bracket; `flat` means it cancelled it.
// Both brackets are 50 ticks wide, so a live one fills on its first bar: `flat` cannot be a bracket that was merely not reached.

phase = bar_index % 60
// (a) strategy.cancel(id) on an unfilled strategy.entry: a buy limit ABOVE the market, which fills at the next open if it lives,
//     cancelled on the bar it is placed, so "no A trade" can only mean the cancel
if phase == 5
    strategy.entry("A", strategy.long, limit = math.round_to_mintick(close * 1.05), comment = "ea")
    strategy.exit("XA", "A", profit = 400, loss = 300, comment = "xa")
    strategy.cancel("A")
// (b) strategy.cancel(id) on an unfilled strategy.order; the same id re-placed later, its exit NOT called again
if phase == 20
    strategy.order("O", strategy.long, qty = 2, limit = math.round_to_mintick(close * 0.9), comment = "eo")
    strategy.exit("XO", "O", profit = 50, loss = 50, comment = "xo")
if phase == 21
    strategy.cancel("O")
if phase == 25
    strategy.order("O", strategy.long, qty = 2, comment = "eo2")
// (c) strategy.cancel_all() after a bracket bound to an open trade and an unfilled entry, on the same bar
if phase == 40
    strategy.entry("C", strategy.long, comment = "ec")
if phase == 41
    strategy.exit("XC", "C", profit = 50, loss = 50, comment = "xc")
    strategy.entry("D", strategy.long, limit = math.round_to_mintick(close * 0.9), comment = "ed")
    strategy.cancel_all()
// flat between the cases
if phase == 15 or phase == 35 or phase == 55
    strategy.close_all(comment = "flat")

plot(phase, "X01_phase")
plot(strategy.opentrades > 0 ? strategy.opentrades.size(0) : na, "X02_open_size_0")
plot(strategy.opentrades > 0 ? strategy.opentrades.entry_bar_index(0) : na, "X03_open0_entry_bar")

// ── standard set (5.1), appended by tools/vendor_harness/w9_probes.py ──
plot(time, "S01_time_CONTROL")
plot(bar_index, "S02_bar_index_CONTROL")
plot(strategy.position_size, "S03_position_size")
plot(strategy.position_avg_price, "S04_position_avg_price")
plot(strategy.opentrades, "S05_opentrades")
plot(strategy.closedtrades, "S06_closedtrades")
plot(strategy.netprofit, "S07_netprofit")
plot(strategy.equity, "S08_equity")
plot(strategy.openprofit, "S09_openprofit")
_nc = strategy.closedtrades
plot(_nc > 0 ? strategy.closedtrades.entry_time(_nc - 1) : na, "S10_c0_entry_time")
plot(_nc > 0 ? strategy.closedtrades.exit_time(_nc - 1) : na, "S11_c0_exit_time")
plot(_nc > 0 ? strategy.closedtrades.entry_bar_index(_nc - 1) : na, "S12_c0_entry_bar_index")
plot(_nc > 0 ? strategy.closedtrades.exit_bar_index(_nc - 1) : na, "S13_c0_exit_bar_index")
plot(_nc > 0 ? strategy.closedtrades.entry_price(_nc - 1) : na, "S14_c0_entry_price")
plot(_nc > 0 ? strategy.closedtrades.exit_price(_nc - 1) : na, "S15_c0_exit_price")
plot(_nc > 0 ? strategy.closedtrades.size(_nc - 1) : na, "S16_c0_size")
plot(_nc > 0 ? strategy.closedtrades.profit(_nc - 1) : na, "S17_c0_profit")
plot(_nc > 0 ? strategy.closedtrades.commission(_nc - 1) : na, "S18_c0_commission")
plot(_nc > 1 ? strategy.closedtrades.entry_time(_nc - 2) : na, "S19_c1_entry_time")
plot(_nc > 1 ? strategy.closedtrades.exit_time(_nc - 2) : na, "S20_c1_exit_time")
plot(_nc > 1 ? strategy.closedtrades.entry_bar_index(_nc - 2) : na, "S21_c1_entry_bar_index")
plot(_nc > 1 ? strategy.closedtrades.exit_bar_index(_nc - 2) : na, "S22_c1_exit_bar_index")
plot(_nc > 1 ? strategy.closedtrades.entry_price(_nc - 2) : na, "S23_c1_entry_price")
plot(_nc > 1 ? strategy.closedtrades.exit_price(_nc - 2) : na, "S24_c1_exit_price")
plot(_nc > 1 ? strategy.closedtrades.size(_nc - 2) : na, "S25_c1_size")
plot(_nc > 1 ? strategy.closedtrades.profit(_nc - 2) : na, "S26_c1_profit")
plot(_nc > 1 ? strategy.closedtrades.commission(_nc - 2) : na, "S27_c1_commission")
plot(_nc > 2 ? strategy.closedtrades.entry_time(_nc - 3) : na, "S28_c2_entry_time")
plot(_nc > 2 ? strategy.closedtrades.exit_time(_nc - 3) : na, "S29_c2_exit_time")
plot(_nc > 2 ? strategy.closedtrades.entry_bar_index(_nc - 3) : na, "S30_c2_entry_bar_index")
plot(_nc > 2 ? strategy.closedtrades.exit_bar_index(_nc - 3) : na, "S31_c2_exit_bar_index")
plot(_nc > 2 ? strategy.closedtrades.entry_price(_nc - 3) : na, "S32_c2_entry_price")
plot(_nc > 2 ? strategy.closedtrades.exit_price(_nc - 3) : na, "S33_c2_exit_price")
plot(_nc > 2 ? strategy.closedtrades.size(_nc - 3) : na, "S34_c2_size")
plot(_nc > 2 ? strategy.closedtrades.profit(_nc - 3) : na, "S35_c2_profit")
plot(_nc > 2 ? strategy.closedtrades.commission(_nc - 3) : na, "S36_c2_commission")
var int _seen = 0
if _nc > _seen
    for _i = _seen to _nc - 1
        label.new(bar_index, high, strategy.closedtrades.entry_id(_i) + ">" + strategy.closedtrades.exit_id(_i) + ":" + strategy.closedtrades.exit_comment(_i), style = label.style_label_down)
    _seen := _nc
