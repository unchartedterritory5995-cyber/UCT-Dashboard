//@version=6
indicator("UCTPROBE_VW_COND_WINDOW_EXTREMES", overlay = false)

// --- 2026-10-01 C48 - `ta.highest` / `ta.lowest` IN A BLOCK THAT RUNS ON SOME BARS -----
//
// `vw-call-site-history` (C01 / C02 / H04) shows these do NOT read the last N bars and
// do NOT read the last N executions of the block: neither fits. Every other windowed
// call in that capture (`ta.sma`, `ta.ema`, `x[1]`) counts EXECUTIONS. The engine
// refuses both, by name, until a capture shows which values the window holds.
//
// The source is `bar_index`, so each row PRINTS WHICH BAR its answer came from:
//   X01  ta.highest(bar_index, 3)   under `bar_index % 3 == 0`
//          last 3 bars -> bar_index ; last 3 runs -> bar_index (the newest either way)
//   X02  ta.lowest(bar_index, 3)    under `bar_index % 3 == 0`
//          last 3 bars -> bar_index - 2 ; last 3 runs -> bar_index - 6
//   X03  ta.lowest(bar_index, 5)    under `bar_index % 2 == 0`
//          last 5 bars -> bar_index - 4 ; last 5 runs -> bar_index - 8
//   X04  ta.lowest(bar_index, 3)    under `close > open` (irregular runs)
//   X05  ta.highest(0 - bar_index, 3) under `close > open` (the mirror of X04)
//   X06  ta.lowest(3) one-argument form (reads `low`) under `bar_index % 3 == 0`
//   X07  ta.highest(3) one-argument form (reads `high`) under `bar_index % 3 == 0`
//   E0x  the same call on EVERY bar, as the control each row is read against
//   R01  the bar index of the previous run of the `close > open` block (CONTROL:
//        `bar_index[1]` there is the previous RUN's, per H05 of the earlier capture)
//
// CAPTURE: NYSE:RDDT 1D from the listing AND AMEX:SPY 1D, inputs at defaults (none).

float X01 = na
float X02 = na
float X03 = na
float X04 = na
float X05 = na
float X06 = na
float X07 = na
float R01 = na
if bar_index % 3 == 0
    X01 := ta.highest(bar_index, 3)
    X02 := ta.lowest(bar_index, 3)
    X06 := ta.lowest(3)
    X07 := ta.highest(3)
if bar_index % 2 == 0
    X03 := ta.lowest(bar_index, 5)
if close > open
    X04 := ta.lowest(bar_index, 3)
    X05 := ta.highest(0 - bar_index, 3)
    R01 := bar_index[1]

plot(bar_index,                    "X00_bar_index_CONTROL")
plot(X01,                          "X01_highest_bi_3_every_3rd")
plot(X02,                          "X02_lowest_bi_3_every_3rd")
plot(X03,                          "X03_lowest_bi_5_every_2nd")
plot(X04,                          "X04_lowest_bi_3_up_bars")
plot(X05,                          "X05_highest_neg_bi_3_up_bars")
plot(X06,                          "X06_lowest_3_onearg_every_3rd")
plot(X07,                          "X07_highest_3_onearg_every_3rd")
plot(ta.highest(bar_index, 3),     "E01_highest_bi_3_every_bar")
plot(ta.lowest(bar_index, 3),      "E02_lowest_bi_3_every_bar")
plot(ta.lowest(bar_index, 5),      "E03_lowest_bi_5_every_bar")
plot(ta.lowest(3),                 "E06_lowest_3_every_bar")
plot(ta.highest(3),                "E07_highest_3_every_bar")
plot(low,                          "E08_low_CONTROL")
plot(high,                         "E09_high_CONTROL")
plot(close > open ? 1 : 0,         "E10_up_bar_CONTROL")
plot(R01,                          "R01_bar_index_prev_run")
