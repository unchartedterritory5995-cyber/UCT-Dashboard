//@version=6
indicator("vw-w3-loop-list-text", overlay = true)

// PROVENANCE: written 2026-11-07 for the Pine parity programme from the inline shape in
// docs/pine/capture-queue-2026-11-02-w3.md, W3 S1, row Q-W3-4 (shape S1-D). The code below these comments is that doc's text.
// NEVER COMPILED ON TRADINGVIEW: a line that does not compile IS a reading - record the error text and the line.
// QUESTION: a string list read by the loop counter into cells (a literal array.from list and a var list). Read the cell texts in table order.
// CAPTURE: AMEX:SPY 1D, inputs at defaults.

var string[] names = array.from("", "one", "two", "three")
if barstate.islast
    var table t = table.new(position.top_right, 5, 2)
    string[] heads = array.from("c0", "c1", "c2", "c3", "c4")
    for i = 0 to 4
        table.cell(t, i, 0, array.get(heads, i))
    for k = 1 to 3
        table.cell(t, k, 1, array.get(names, k))
