//@version=6
indicator("UCTPROBE_VW_FMT_TIE_READINGS", overlay = true, max_labels_count = 60)

// PROVENANCE: written 2026-11-15 (inv-fmt-1115). NEVER COMPILED ON TRADINGVIEW.
// str.tostring rounding READING on decimal ties that are not binary ties, plus the corners the
// engine withholds. Each label is "Tnn <what>|<text>"; read the text after the bar.
// Readings: decup = round the shortest decimal half-up; mul = round(|x|*10^k) in binary; bin = exact binary.
// CAPTURE: NYSE:RDDT 1D (tick 0.01), inputs at defaults. Every label is on the last bar.

f(id, s) => label.new(bar_index, close, id + "|" + s, style = label.style_label_left)

if barstate.islast
    f("T01 1.005 #.## decup1.01 mul1", str.tostring(1.005, "#.##"))
    f("T02 163.265 #.## decup163.27 mul163.26", str.tostring(163.265, "#.##"))
    f("T03 145.795 #.## decup145.8 mul145.79", str.tostring(145.795, "#.##"))
    f("T04 1.255 #.## decup1.26 mul1.25", str.tostring(1.255, "#.##"))
    f("T05 2.675 #.## CONTROL decup=mul 2.68 bin2.67", str.tostring(2.675, "#.##"))
    f("T06 127.705 #.## CONTROL 127.71", str.tostring(127.705, "#.##"))
    f("T07 -1.005 #.## decup-1.01 mul-1", str.tostring(-1.005, "#.##"))
    f("T08 1.005 mintick", str.tostring(1.005, format.mintick))
    f("T09 163.265 mintick", str.tostring(163.265, format.mintick))
    f("T10 0.125 mintick EXACT binary tie", str.tostring(0.125, format.mintick))
    f("T11 -0.004 mintick NEG ZERO", str.tostring(-0.004, format.mintick))
    f("T12 1234.5 mintick GROUPING", str.tostring(1234.5, format.mintick))
    f("T13 -0.004 #.## NEG ZERO", str.tostring(-0.004, "#.##"))
    f("T14 -1e-12 default NEG ZERO", str.tostring(-0.000000000001))
    f("T15 0.1 20#", str.tostring(0.1, "#.####################"))
    f("T16 123.456 16#", str.tostring(123.456, "#.################"))
    f("T17 1/3 16#", str.tostring(1.0 / 3.0, "#.################"))
    f("T18 1e21 default", str.tostring(1e21))
    f("T19 1.00000000005 default 10th-dp decimal tie", str.tostring(1.00000000005))
    f("T20 1234.5 #,###.## GROUPING", str.tostring(1234.5, "#,###.##"))
    f("T21 0.12345 percent", str.tostring(0.12345, format.percent))
    f("T22 -0.126 percent", str.tostring(-0.126, format.percent))
    f("T23 close price", str.tostring(close, format.price))
    f("T24 str.format 1.0005 decimal tie 3dp", str.format("{0}", 1.0005))
    f("T25 str.format 2.0625 exact tie 3dp", str.format("{0}", 2.0625))
    f("T26 -0.4 # NEG ZERO", str.tostring(-0.4, "#"))
    f("T27 false spelling", str.tostring(false))
    f("T28 int 5 vs 5.0", str.tostring(5) + "/" + str.tostring(5.0))
    f("T29 1e-11 default", str.tostring(0.00000000001))
    f("T30 99999.995 #.## rolls a digit", str.tostring(99999.995, "#.##"))
