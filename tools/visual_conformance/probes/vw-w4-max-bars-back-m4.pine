//@version=6
indicator("UCTPROBE_VW_W4_MBB_M4", overlay = false)

// PROVENANCE: written 2026-11-03 for the Pine parity programme, W4-T17, capture queue row M4
// (docs/pine/capture-queue-2026-10-31-wsc-history.md section Q1). NEVER COMPILED ON TRADINGVIEW.
// ONE ROW PER FILE: a Pine runtime error STOPS the script, so a row that errors would hide every
// row after it. The error text and the bar it names ARE the reading (record both); a script that
// draws is read from the plots. Does max_bars_back(x, 50) bound the offset x[60] and the built-in window ta.sma(x, 60) over x? (plain declaration, no indicator-level max_bars_back)
// CAPTURE: AMEX:SPY 1D from the listing (>= 6,000 bars for M5), inputs at defaults.

x = close * 2
max_bars_back(x, 50)

plot(bar_index, "A00_bar_index_CONTROL")
plot(x[60], "M4_x_60_after_mbb50")
plot(ta.sma(x, 60), "M4_sma_x_60_after_mbb50")
