//@version=6
strategy("W9_P2_ORDER_FILLS_NV", overlay = false, default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 2, calc_on_order_fills = true, max_labels_count = 500)

// W9-T3b, GENERATED by tools/vendor_harness/w9_probes.py: do not edit by hand (`--check` fails on a diff).
// Row W9-P2 on NYSE:RDDT 1D. Settles: calc_on_order_fills on history: does L1's fill tick run an extra execution, and where does the add it places fill: on L1's bar (the next path tick) or at the next open (no varip)
// Capture with tools/vendor_harness/tv_capture.js (gradeMethod set; settings read back). Never the CSV, never exportData().
// No varip (rule 11 refuses it in broker mode). The extra execution is witnessed by L2: placed only once a position is open.
// X02 == X01: an extra execution ran on L1's fill tick and its add filled on L1's bar (B-FILLS as served: from the next tick).
// X02 == X01 + 1 (X03 at that bar's open) says only that the add did not fill on L1's bar: either no extra execution ran, or one ran
// and its add waited for the next open. This probe cannot tell those two apart; either one refutes B-FILLS as served. W9-P2's varip twin is held.

fast = ta.sma(close, 5)
slow = ta.sma(close, 20)
up = ta.crossover(fast, slow)
dn = ta.crossunder(fast, slow)
if up
    strategy.entry("L1", strategy.long, comment = "e1")
if strategy.position_size > 0 and strategy.opentrades == 1
    strategy.entry("L2", strategy.long, comment = "e2")
if dn
    strategy.close_all(comment = "xall")

plot(strategy.opentrades > 0 ? strategy.opentrades.entry_bar_index(0) : na, "X01_open0_entry_bar")
plot(strategy.opentrades > 1 ? strategy.opentrades.entry_bar_index(1) : na, "X02_open1_entry_bar")
plot(strategy.opentrades > 1 ? strategy.opentrades.entry_price(1) : na, "X03_open1_entry_price")

