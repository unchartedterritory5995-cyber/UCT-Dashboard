//@version=6
indicator("UCTPROBE_VW_W4_MBB_M2", overlay = false, max_bars_back = 20)

// PROVENANCE: written 2026-11-03 for the Pine parity programme, W4-T17, capture queue row M2
// (docs/pine/capture-queue-2026-10-31-wsc-history.md section Q1). NEVER COMPILED ON TRADINGVIEW.
// ONE ROW PER FILE: a Pine runtime error STOPS the script, so a row that errors would hide every
// row after it. The error text and the bar it names ARE the reading (record both); a script that
// draws is read from the plots. The runtime error text and the bar it names, for a DYNAMIC offset (25) past a declared buffer (20).
// CAPTURE: AMEX:SPY 1D from the listing (>= 6,000 bars for M5), inputs at defaults.

n = bar_index > 100 ? 25 : 1

plot(bar_index, "A00_bar_index_CONTROL")
plot(close[n], "M2_close_n_declared_20")
