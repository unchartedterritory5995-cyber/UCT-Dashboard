//@version=4
strategy(title="W9_Q_S1A_SIZE_V4", overlay=false)

// W9-T3b, GENERATED by tools/vendor_harness/w9_probes.py: do not edit by hand (`--check` fails on a diff).
// Row Q-S1a on NYSE:RDDT 1D. Settles: v4 default size with none declared (position_size only: v4 has no opentrades.size)
// Capture with tools/vendor_harness/tv_capture.js (gradeMethod set; settings read back). Never the CSV, never exportData().

fast = sma(close, 5)
slow = sma(close, 20)
up = crossover(fast, slow)
dn = crossunder(fast, slow)
if up
    strategy.entry("L", strategy.long)
if dn
    strategy.close("L")

plot(close, title="X02_close")

