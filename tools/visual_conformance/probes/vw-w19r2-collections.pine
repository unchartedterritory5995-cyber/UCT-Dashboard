//@version=6
indicator("vw-w19r2-collections", overlay = false)

// W19-R2 (2026-10-05), Q-W19R2b. SPLIT 2026-11-16 by the UDT unit: run cq1-2026-11-16 (PR #1472) read this
// file as "Runtime error: Error on bar {bar_index}: In 'array.{funcName}()' function. Index {index} is out of
// bounds, array size is {size}." with the values unsubstituted, so the row that raised could not be named.
// Every row that can raise now has its own file (Q-W19R2a: vw-w19r2a-*.pine; the empty-array searches:
// vw-w19r2b-empty-*.pine). What is left here cannot raise: three searches over a NON-EMPTY sorted array.
// One question per plot; A00 is the control (it must plot on every bar).
// QUESTION: over (1, 3, 3, 3, 7): binary_search / _leftmost / _rightmost of 3 (present three times), 0 (below
// all), 5 (between), 9 (above all), 7 (the last). B01 is the one the reference leaves open (which of the three 3s).
// CAPTURE: NYSE:RDDT 1D from the listing, inputs at defaults (none), AFTER THE CLOSE.
plot(bar_index, "A00_bar_index_CONTROL")
s = array.from(1.0, 3.0, 3.0, 3.0, 7.0)
plot(array.binary_search(s, 3), "B01_search_3_present_thrice")
plot(array.binary_search(s, 0), "B02_search_0_below_all")
plot(array.binary_search(s, 5), "B03_search_5_between")
plot(array.binary_search(s, 9), "B04_search_9_above_all")
plot(array.binary_search(s, 7), "B05_search_7_the_last")
plot(array.binary_search_leftmost(s, 3), "L01_leftmost_3")
plot(array.binary_search_leftmost(s, 0), "L02_leftmost_0")
plot(array.binary_search_leftmost(s, 5), "L03_leftmost_5")
plot(array.binary_search_leftmost(s, 9), "L04_leftmost_9")
plot(array.binary_search_leftmost(s, 7), "L05_leftmost_7")
plot(array.binary_search_rightmost(s, 3), "R01_rightmost_3")
plot(array.binary_search_rightmost(s, 0), "R02_rightmost_0")
plot(array.binary_search_rightmost(s, 5), "R03_rightmost_5")
plot(array.binary_search_rightmost(s, 9), "R04_rightmost_9")
plot(array.binary_search_rightmost(s, 7), "R05_rightmost_7")
