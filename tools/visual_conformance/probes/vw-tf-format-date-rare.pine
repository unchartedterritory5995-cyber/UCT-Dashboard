//@version=6
indicator("UCTPROBE_VW_TF_FORMAT_DATE_RARE", overlay = true)

// PROVENANCE: written 2026-11-19 (Q-TF-W2-c, docs/pine/capture-queue-2026-11-20-text-format.md). Our probe, licence `probe`.
// NEVER COMPILED ON TRADINGVIEW: a line that does not compile IS a reading - record the error text and the line.
// ⛔ A pattern letter TradingView does not hold may STOP the script with a runtime error: then the error text
// is the reading, recorded with the row it names.
//
// ─── W2: `str.format("{0,date,P}", t)` - THE RARER PATTERN LETTERS ───
//
// Era, week-year, day-of-year, week-of-year, day-of-week number, the 1-24 / 0-11 hours, fractions of a second,
// and the zone letters z / X beside the Z the committed capture shows ("+0000"). Kept apart from the common letters
// (vw-tf-format-date-tokens.pine) so a letter that stops the script costs only these rows.
//
// One row per letter (`{0,date,P}`); one column per instant:
//   iA   2024-03-05 14:07:09 UTC, the instant of vw-w3-format-date (continuity)
//   iC   2023-12-31 23:59:59.999 UTC: the year's last millisecond, a Sunday
//   iD   2021-01-01 00:00:00 UTC: midnight, a Friday
//   iE   1969-12-31 23:59:59 UTC: before 1970, a negative timestamp
//   iN   2024-11-11 12:00:00 UTC: noon
//
// CAPTURE: AMEX:SPY 1D and BITSTAMP:BTCUSD 1D. Inputs at defaults.

int iA = timestamp("UTC", 2024, 3, 5, 14, 7, 9)
int iC = timestamp("UTC", 2023, 12, 31, 23, 59, 59) + 999
int iD = timestamp("UTC", 2021, 1, 1, 0, 0, 0)
int iE = timestamp("UTC", 1969, 12, 31, 23, 59, 59)
int iN = timestamp("UTC", 2024, 11, 11, 12, 0, 0)

if barstate.islast
    var table t = table.new(position.top_right, 6, 22)
    table.cell(t, 0, 0, "id P")
    table.cell(t, 1, 0, "iA")
    table.cell(t, 2, 0, "iC")
    table.cell(t, 3, 0, "iD")
    table.cell(t, 4, 0, "iE")
    table.cell(t, 5, 0, "iN")
    table.cell(t, 0, 1, "R01 G")
    table.cell(t, 1, 1, str.format("{0,date,G}", iA))
    table.cell(t, 2, 1, str.format("{0,date,G}", iC))
    table.cell(t, 3, 1, str.format("{0,date,G}", iD))
    table.cell(t, 4, 1, str.format("{0,date,G}", iE))
    table.cell(t, 5, 1, str.format("{0,date,G}", iN))
