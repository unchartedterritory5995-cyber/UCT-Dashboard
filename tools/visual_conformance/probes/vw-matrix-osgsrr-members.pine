//@version=5
indicator("UCTPROBE_VW_MATRIX_OSGSRR_MEMBERS", overlay = false)

// PROVENANCE: written 2026-11-18 for the Pine parity programme (evidence audit,
// admit:collections:matrix), capture queue rows Q-MAT-1a / Q-MAT-1b
// (docs/pine/capture-queue-2026-11-18-lang-units.md). NEVER COMPILED ON TRADINGVIEW.
//
// --- THE FOUR MATRIX MEMBERS one-sided-gaussian-support-resistance-rate-loxx USES, AND NO OTHER ---
// committed:one-sided-gaussian-support-resistance-rate-loxx__c801e68b6c (v5) builds its weights with
// `matrix.new<float>(n, n, 0.)`, fills and normalises them per column with `matrix.set` / `matrix.get`
// (a column loop that `break`s), and reads them back in another function over `matrix.rows`. These rows
// use exactly those four members, in those shapes, so a capture admits nothing beyond them. Each cell
// read is its own plot:
//   X01  a fresh 3x3 `matrix.new<float>(3, 3, 0.)`, cell (0, 0) before any set   the initial value
//   X02  `matrix.rows` of it                                                     3
//   X03..X05  cells (0, 0), (1, 2), (2, 1) after every cell is set to
//             close * (row + 1) + column                                        the set / get round trip
//   X06..X09  a 4x4 weight matrix built and column-normalised inside a function (OSGSRR's `_gaussout`
//             shape: set, accumulate the column sum with get, `break` past the diagonal, divide each
//             cell by the sum): cells (0, 0), (1, 3), (3, 3), and (3, 0), a cell no loop sets
//   X10 / X11  OSGSRR's `_smthMA` shape: a function that builds the weights, loops
//              `for i = 0 to matrix.rows(g) - 1`, and sums `matrix.get(g, i, level) * nz(src)`
//              at levels 2 and 3
// CAPTURE: NYSE:RDDT 1D and AMEX:SPY 1D from the listing, inputs at defaults (none). If a row does not
// compile, record the error text and the line, remove only that row, and capture the rest.

m = matrix.new<float>(3, 3, 0.)
plot(matrix.get(m, 0, 0), "X01_new_initial_00")
for i = 0 to 2
    for k = 0 to 2
        matrix.set(m, i, k, close * (i + 1) + k)
plot(matrix.rows(m), "X02_rows")
plot(matrix.get(m, 0, 0), "X03_get_00")
plot(matrix.get(m, 1, 2), "X04_get_12")
plot(matrix.get(m, 2, 1), "X05_get_21")

weights(len) =>
    g = matrix.new<float>(len, len, 0.)
    for k = 0 to len - 1
        sum = 0.
        for i = 0 to len - 1
            if i > k
                break
            matrix.set(g, i, k, math.exp(-(i * i) / (2.0 * (k + 1))))
            sum += matrix.get(g, i, k)
        for i = 0 to len - 1
            if i > k
                break
            matrix.set(g, i, k, matrix.get(g, i, k) / sum)
    g

smoothed(level, src, len) =>
    g = weights(len)
    s = 0.
    for i = 0 to matrix.rows(g) - 1
        s += matrix.get(g, i, level) * nz(src)
    s

w = weights(4)
plot(matrix.get(w, 0, 0), "X06_weight_00")
plot(matrix.get(w, 1, 3), "X07_weight_13")
plot(matrix.get(w, 3, 3), "X08_weight_33")
plot(matrix.get(w, 3, 0), "X09_weight_30_never_set")
plot(smoothed(2, close, 4), "X10_smoothed_level2")
plot(smoothed(3, close, 4), "X11_smoothed_level3")
