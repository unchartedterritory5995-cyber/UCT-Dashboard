//@version=5
indicator("UCTPROBE_VW_VAR_SEED_V5", overlay = false)

// ─── 2026-09-28 — WHAT A `var` IS ON BAR 0 (Q-V1) ───────────────────────────
//
// `pine.js::varSeedOf` seeds a `var`'s accumulator `na` when its update reads
// itself through HISTORY (`x[1]`), and with its initializer when it reads itself
// BARE (`x`), on the rule that `x[1]` on bar 0 is `na` and does not read the
// initializer. The rule is Pine's history operator and this repo's runtime lane
// already implements it (`vm.js` READ_HIST_SLOT) — but NO capture has observed
// bar 0 (`tests/fixtures/vendor/runtime/mutable-history-spy-1d-2026-09-08.json`
// says so under `not_observed`). This probe makes bar 0 visible on EVERY bar:
// each condition below is chosen so that bar 0's answer is carried forever.
//
//   row   rule (shipped)        alternative (x[1] on bar 0 reads the init)
//   V01   na every bar          7 every bar
//   V02   7 every bar           7 every bar            (bare — the CONTROL)
//   V03   3 every bar           7 every bar            (nz's default)
//   V04   na every bar          a count from 7         (bar 0 takes the x[1] arm)
//   V05   na every bar          7 every bar            (no `var` — plain spelling)
//   V06   na every bar          a smoothed close       (x[2] poisons bar 0)
//
// ⛔ CAPTURE: AMEX:SPY 1D, ≥ 200 bars. Inputs at defaults. Any timeframe answers
// the same question; 1D is enough. A compile failure is itself a reading.

plot(bar_index, "V00_bar_index_CONTROL")

var float a = 7.0
a := bar_index > 1e9 ? close : a[1]
plot(a, "V01_history_never_fires")

var float b = 7.0
b := bar_index > 1e9 ? close : b
plot(b, "V02_bare_never_fires_CONTROL")

var float c = 7.0
c := bar_index > 1e9 ? close : nz(c[1], 3.0)
plot(c, "V03_nz_guarded_history")

var float d = 7.0
d := bar_index % 2 == 1 ? d + 1 : d[1]
plot(d, "V04_mixed_bar0_takes_history_arm")

e = 7.0
e := bar_index > 1e9 ? close : e[1]
plot(e, "V05_plain_history_never_fires")

var float f = close
f := 0.6 * f - 0.08 * f[2] + 0.48 * close
plot(f, "V06_mixed_two_lag_unguarded")
