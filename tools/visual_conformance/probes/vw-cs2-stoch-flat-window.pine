//@version=6
indicator("UCTPROBE_VW_CS2_STOCH_FLAT_WINDOW", overlay = false)

// PROVENANCE: written 2026-11-15 (session S10, PROBES-NEXT item 1; engine 57 F3/F4, stoch:flat-window).
// NEVER COMPILED ON TRADINGVIEW before this session.
// What does ta.stoch read when its whole 10-bar window is flat (highest == lowest), and what does
// the ema over it carry? Three lead-ins to the flat run at bars 200..214, so the %K the run starts
// from is (a) whatever close gives, (b) 100 (a rising ramp into the flat level), (c) 80 (a dip and
// partial rebound). Plus a hole (na) inside the flat run at bar 215.
// CAPTURE: NYSE:RDDT 1D from the listing, inputs at defaults. Read every plot on every bar.

flat = bar_index >= 200 and bar_index < 215
x = flat ? 5000.0 : close
xr = flat ? 5000.0 : bar_index >= 190 and bar_index < 200 ? 4000.0 + (bar_index - 190) * 100.0 : close
xd = flat ? 5000.0 : bar_index >= 190 and bar_index < 200 ? 4000.0 + math.abs(bar_index - 195) * 200.0 : close
y = bar_index == 215 ? na : x

k = ta.stoch(x, x, x, 10)
kr = ta.stoch(xr, xr, xr, 10)
kd = ta.stoch(xd, xd, xd, 10)
plot(k, "K01_stoch_x")
plot(ta.ema(k, 3), "K02_ema3_stoch_x")
plot(kr, "K03_stoch_ramp_up")
plot(ta.ema(kr, 3), "K04_ema3_stoch_ramp_up")
plot(kd, "K05_stoch_dip_rebound")
plot(ta.ema(kd, 3), "K06_ema3_stoch_dip_rebound")
plot(ta.stoch(y, y, y, 10), "K07_stoch_y_hole_at_215")
// NON-VACUITY CONTROLS: the sources themselves and the bar index.
plot(x, "C01_x")
plot(xr, "C02_xr")
plot(xd, "C03_xd")
plot(bar_index, "C00_bar_index_CONTROL")
