#!/bin/sh
# UCT market-hours deploy freeze — pre-push guard.
#
# Every push to master auto-deploys the Railway WEB service (no watch paths —
# it serves the SPA bundle). A mid-market container swap drops /api/* for
# minutes. The FLOW-WORKER service (Massive OPRA options consumer) is also
# GitHub-triggered, on NARROW watch paths (the flow files listed below, set
# per-service in the Railway dashboard 2026-07-17 — NEVER in railway.json).
# A flow-worker swap gaps the options tape PERMANENTLY (OPRA does not replay;
# gaps heal only from the T+1 flat file overnight). House rule: ship
# >=4:20 PM ET or <9:15 AM ET — see the liveflow deploy-survival spec.
#
# 2026-07-13: eleven market-hours pushes caused repeated member-facing 500s +
# three tape gaps. 2026-07-16: eight market-hours flow-worker deploys (all via
# UCT_PUSH_OVERRIDE misuse while watch paths were still broad) dropped ~13.9k
# prints. This hook makes the rule mechanical.
#
# Install (shared across all worktrees):
#   cp tools/git-hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#
# Overrides — for GENUINE emergencies (site down, worse than a swap) ONLY.
# Claude sessions: do NOT set these for routine work; batch and push after
# 4:20 PM ET instead.
#   Web-only emergency:            UCT_PUSH_OVERRIDE=1 git push ...
#   Flow-touching emergency:       UCT_PUSH_OVERRIDE=1 UCT_FLOW_OVERRIDE=1 git push ...
#     (a push whose diff touches a flow-worker watched file needs BOTH — a
#      generic override must never bounce the options tape by accident)
# Test override:  UCT_HOOK_TEST_NOW="<dow 0-6> <minutes-since-midnight>"

# Flow-worker watched files — keep in sync with the Railway service settings.
FLOW_WATCHED="api/massive_ws_worker.py api/massive_processor.py api/flow_db.py \
api/bs_iv.py api/flow_worker_main.py api/live_massive_router.py api/flow_router.py \
api/flow_router_mount.py api/flow_heal_enrich.py api/flow_gap_autofill.py \
api/massive_flatfiles_worker.py api/flow_watchdog.py api/oi_snapshots.py \
api/flow_rest_backfill.py \
api/massive_stream.py api/flow_tape_spool.py api/flow_backup.py \
api/dealer_positioning.py api/flow_opt_aggregate.py railway.json requirements.txt"

pushes_master=0
flow_touched=""
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/master)
      pushes_master=1
      # Deleted ref → nothing deploys from it.
      case "$local_sha" in 0000000000000000000000000000000000000000) continue ;; esac
      # New remote ref → diff against the known remote master instead.
      base="$remote_sha"
      case "$base" in 0000000000000000000000000000000000000000) base="origin/master" ;; esac
      # FAIL CLOSED (2026-07-30). If the diff can't be computed the guard must
      # assume the worst, never wave the push through. Observed live: master had
      # moved, $remote_sha was a commit this repo did not have yet, `git diff`
      # errored, 2>/dev/null swallowed it, `changed` came back EMPTY — so the
      # flow-file scan matched nothing, flow_touched stayed empty, and a push
      # touching api/live_massive_router.py silently downgraded from "needs BOTH
      # overrides" to the generic web override and was ACCEPTED. The guard
      # disabled itself in exactly the state that follows a rejected push (stale
      # remote ref), which is when it is most needed.
      if ! changed=$(git diff --name-only "$base".."$local_sha" 2>/dev/null); then
        echo "[uct pre-push] WARN: could not diff $base..$local_sha (stale remote ref?)" >&2
        echo "[uct pre-push] treating this push as FLOW-TOUCHING (fail-closed). Run 'git fetch origin' for an accurate check." >&2
        flow_touched="$flow_touched (undetermined — diff failed)"
      fi
      for f in $changed; do
        for w in $FLOW_WATCHED; do
          [ "$f" = "$w" ] && flow_touched="$flow_touched $f"
        done
      done
      ;;
  esac
done
[ "$pushes_master" = "1" ] || exit 0

# ET clock from the Windows timezone db (DST-correct year-round).
# Output format: "<dow 0=Sun..6=Sat> <minutes-since-midnight>"
if [ -n "$UCT_HOOK_TEST_NOW" ]; then
  set -- $UCT_HOOK_TEST_NOW
else
  now=$(powershell.exe -NoProfile -Command '$et=[System.TimeZoneInfo]::ConvertTimeBySystemTimeZoneId([DateTime]::UtcNow,"Eastern Standard Time"); Write-Output ("{0} {1}" -f [int]$et.DayOfWeek, ($et.Hour*60+$et.Minute))' 2>/dev/null | tr -d '\r')
  set -- $now
fi
dow=$1
mins=$2
case "$dow" in ''|*[!0-9]*) dow=bad ;; esac
case "$mins" in ''|*[!0-9]*) dow=bad ;; esac
if [ "$dow" = "bad" ]; then
  echo "[uct pre-push] WARN: could not read the ET clock — allowing push (fail-open)" >&2
  exit 0
fi

# Freeze window: Mon(1)-Fri(5), 9:15 AM (555) through 4:19 PM (979) ET.
in_freeze=0
if [ "$dow" -ge 1 ] && [ "$dow" -le 5 ] && [ "$mins" -ge 555 ] && [ "$mins" -lt 980 ]; then
  in_freeze=1
fi
[ "$in_freeze" = "1" ] || exit 0

# --- Inside the freeze window from here ---

# A flow-worker-touching push needs BOTH overrides: a mid-session flow-worker
# swap permanently gaps the OPRA tape, so the generic web override is not enough.
if [ -n "$flow_touched" ] && [ "$UCT_FLOW_OVERRIDE" != "1" ]; then
  cat >&2 <<MSG
[uct pre-push] BLOCKED: this push touches flow-worker WATCHED files during
market hours (Mon-Fri 9:15 AM - 4:20 PM ET):
 $flow_touched

  A flow-worker redeploy drops the live Massive OPRA options tape for minutes
  and the gap is PERMANENT until the overnight T+1 flat file. 2026-07-16:
  eight mid-session deploys cost ~13,900 prints and corrupted the day's flow
  data for live members and the side-classification work.

  -> Keep committing locally; push after 4:20 PM ET.
  -> TRUE emergency on the flow path itself (feed already dead, fix in hand):
       UCT_PUSH_OVERRIDE=1 UCT_FLOW_OVERRIDE=1 git push ...
MSG
  exit 1
fi

if [ "$UCT_PUSH_OVERRIDE" = "1" ]; then
  echo "[uct pre-push] override accepted (UCT_PUSH_OVERRIDE=1) — pushing during freeze window." >&2
  echo "[uct pre-push] REMINDER: overrides are for genuine emergencies only (2026-07-16 lesson)." >&2
  exit 0
fi

cat >&2 <<'MSG'
[uct pre-push] BLOCKED: push to master during market hours (Mon-Fri 9:15 AM - 4:20 PM ET).

  Every master push swaps the Railway web container: /api/* drops for minutes
  for live members. The 2026-07-13 morning deploy storm caused member-facing
  500s and three tape gaps; 2026-07-16's override misuse cost eight more.

  -> Keep committing locally; batch the push until after 4:20 PM ET.
  -> Genuine emergency (site down, worse than a swap):
       UCT_PUSH_OVERRIDE=1 git push ...
     (if your diff touches flow files you will also need UCT_FLOW_OVERRIDE=1)
MSG
exit 1
