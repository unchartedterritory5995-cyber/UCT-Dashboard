    {
      "name": "a table reads cell by cell",
      "pm": true,
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "table",
            "content": [
              {
                "type": "tableRow",
                "content": [
                  {
                    "type": "tableCell",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "text": "a"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "tableCell",
                    "content": [
                      {
                        "type": "paragraph",
                        "content": [
                          {
                            "type": "text",
                            "text": "b"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "expected": "a b"
    },
    {
      "name": "an unknown node holding text reads as a textblock",
