            "type": "mysteryBlock",
            "content": [
              {
                "type": "text",
                "text": "alpha"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "beta"
              }
            ]
          }
        ]
      },
      "expected": "alpha beta"
    },
    {
