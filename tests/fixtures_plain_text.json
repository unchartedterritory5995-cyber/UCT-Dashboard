          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "two"
              }
            ]
          }
        ]
      },
      "expected": "one  two"
    },
    {
      "name": "a code block is one textblock",
      "pm": true,
      "doc": {
        "type": "doc",
