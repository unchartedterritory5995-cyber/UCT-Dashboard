{
  "_about": "ONE table, two readers: api/services/journal_two/notes.py::extract_plain_text (tests/test_plain_text_parity.py) and app/src/pages/journal-2-0/lib/tiptap.js::extractPlainText (lib/plainText.parity.test.js). body_plain is the notebook's search index and the text History diffs. Both serializers are ProseMirror's textBetween(0, size, ' ', leafText): runs inside one textblock join with nothing, blocks and block atoms are separated by one space. A case with \"pm\": true is also checked against the REAL textBetween over the app schema (the JS rail); \"pm\": false marks a doc the schema would refuse, which both walkers must still read.",
  "cases": [
    {
      "name": "a part-bold word is ONE word (**NV**DA)",
      "pm": true,
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "NV",
                "marks": [
                  {
                    "type": "bold"
                  }
                ]
              },
              {
                "type": "text",
                "text": "DA rallies"
              }
            ]
          }
        ]
      },
      "expected": "NVDA rallies"
    },
    {
      "name": "a highlight mid-sentence keeps single spaces",
      "pm": true,
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "This is "
              },
              {
                "type": "text",
                "text": "very important",
                "marks": [
                  {
                    "type": "highlight"
                  }
                ]
              },
              {
                "type": "text",
                "text": " to remember"
              }
            ]
          }
        ]
      },
      "expected": "This is very important to remember"
    },
    {
      "name": "a link inside a sentence",
      "pm": true,
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "see "
              },
              {
                "type": "text",
                "text": "the NVDA 10-Q",
                "marks": [
                  {
                    "type": "link",
                    "attrs": {
                      "href": "https://example.com/10q"
                    }
                  }
                ]
              },
              {
                "type": "text",
                "text": " for margins"
              }
            ]
          }
        ]
      },
      "expected": "see the NVDA 10-Q for margins"
    },
    {
      "name": "bold, italic and a link in one paragraph",
      "pm": true,
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "buy "
              },
              {
                "type": "text",
                "text": "NVDA",
                "marks": [
                  {
                    "type": "bold"
                  }
                ]
              },
              {
                "type": "text",
                "text": " on the "
              },
              {
                "type": "text",
                "text": "reclaim",
                "marks": [
                  {
                    "type": "italic"
                  }
                ]
              },
              {
                "type": "text",
                "text": ", per "
              },
              {
                "type": "text",
                "text": "notes",
                "marks": [
                  {
                    "type": "link",
                    "attrs": {
                      "href": "https://example.com/10q"
                    }
                  }
                ]
              },
              {
                "type": "text",
                "text": "."
              }
            ]
          }
        ]
      },
      "expected": "buy NVDA on the reclaim, per notes."
    },
    {
      "name": "text in nested blocks",
      "pm": true,
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "heading",
            "attrs": {
              "level": 2
            },
            "content": [
              {
                "type": "text",
                "text": "Plan"
              }
            ]
          },
          {
            "type": "bulletList",
            "content": [
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "buy "
                      },
                      {
                        "type": "text",
                        "text": "NVDA",
                        "marks": [
                          {
                            "type": "bold"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "expected": "Plan buy NVDA"
    },
    {
      "name": "a quote and a list add nothing of their own",
      "pm": true,
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "blockquote",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "quoted"
