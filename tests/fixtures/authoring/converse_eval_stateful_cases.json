  {
   "id": "stateful-supertrend",
   "group": "example",
   "turns": [
    {
     "words": "SuperTrend 10, 3",
     "expect": {
      "kind": "change",
      "outputs": [
       {
        "key": "st",
        "type": "series",
        "tree": {
         "type": "call",
         "name": "supertrend",
         "args": [
          {
           "type": "num",
           "value": 3
          },
          {
           "type": "num",
           "value": 10
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
