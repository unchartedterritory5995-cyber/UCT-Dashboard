//@version=6
indicator("NR7 Coil")

nrLen    = input.int(7,  "Narrow range lookback")
atrLen   = input.int(14, "ATR length")
trendLen = input.int(50, "Trend MA length")
baseLen  = input.int(20, "Base lookback")

rng     = high - low
narrow7 = rng < ta.lowest(rng[1], nrLen - 1)
narrow4 = rng < ta.lowest(rng[1], 3)

atrPct   = ta.atr(atrLen) / close * 100
atrQuiet = atrPct < ta.sma(atrPct, 50)

sma50    = ta.sma(close, trendLen)
sma200   = ta.sma(close, 200)
inUptrend = close > sma50 and sma50 > sma200

nearHigh = close > ta.highest(high, baseLen) * 0.95
dryVol   = volume < ta.sma(volume, 20)
liquid   = ta.sma(volume, 20) * close > 10000000

screen = narrow7 and narrow4 and atrQuiet and inUptrend and nearHigh and dryVol and liquid

plot(screen ? 1 : 0)
