//@version=6
indicator("ATR Expansion Breakout")

atrFastLen = input.int(5,  "Fast ATR")
atrSlowLen = input.int(20, "Slow ATR")
donLen     = input.int(20, "Breakout lookback")
volLen     = input.int(20, "Volume average")

atrFast   = ta.atr(atrFastLen)
atrSlow   = ta.atr(atrSlowLen)
expansion = ta.crossover(atrFast, atrSlow * 1.25)

rng           = high - low
wideBar       = rng > 1.5 * ta.sma(rng, atrSlowLen)
closeStrength = (close - low) / math.max(high - low, syminfo.mintick)

priorHigh = ta.highest(high, donLen)[1]
breakout  = close > priorHigh
volPush   = volume > 1.5 * ta.sma(volume, volLen)

ema50   = ta.ema(close, 50)
ema200  = ta.ema(close, 200)
trendOk = close > ema50 and ema50 > ema200

screen = expansion and wideBar and closeStrength > 0.7 and breakout and volPush and trendOk

plot(screen ? 1 : 0)
