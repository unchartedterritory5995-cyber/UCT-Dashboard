//@version=6
indicator("Bollinger Lower Tag")

len  = input.int(20, "BB length")
mult = input.float(2.0, "BB mult")

[mid, upper, lower] = ta.bb(close, len, mult)

pctB  = (close - lower) / (upper - lower)
width = ta.bbw(close, len, mult)

tagged     = low <= lower
closedBack = close > lower
rsiSoft    = ta.rsi(close, 14) < 35
volSpike   = volume > ta.sma(volume, 20) * 1.3
notSqueeze = width > 0.04
stillOk    = close > ta.sma(close, 100)

screen = tagged and closedBack and pctB < 0.2 and rsiSoft and volSpike and notSqueeze and stillOk
plot(screen ? 1 : 0)
