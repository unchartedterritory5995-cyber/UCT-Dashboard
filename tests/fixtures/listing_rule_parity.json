{
  "schema": "uct.listing-rule-parity/v1",
  "about": "e100 (2026-11-26): ONE listing rule, two hosts. The chart's listingSeed.js::historyFromListingOf (with listingReferenceDate on the /api/ticker-ipo payload) and its Python port api/services/listing_history.py (history_from_listing_of + listing_reference_date) must give `reference` and `rule` on every case; the server adds ONE condition, a FINAL first-trade decision, so `server` is `rule` AND first_trade_final === true. Read by app/src/components/chart/engine/__tests__/listingSeedServerParity.test.js and tests/test_listing_history.py. `chartServed` is listingSeed.js::servedFromListingOf (the chart's serving switch): it differs from `rule` only on a weekly chart, which no server lane serves from the listing yet (named, not done).",
  "cases": [
    {"name": "daily bar 0 on the final first-trade day (SPY: inception 1993-01-22, first session 1993-01-29)",
     "tf": "D", "bars": [{"t": "1993-01-29"}, {"t": "1993-02-01"}],
     "ipo": {"list_date": "1993-01-22", "first_trade_date": "1993-01-29", "first_trade_final": true},
     "reference": "1993-01-29", "rule": true, "server": true, "chartServed": true},
    {"name": "the same series against a NON-final answer: the chart serves it, the server does not",
     "tf": "D", "bars": [{"t": "1993-01-22"}],
     "ipo": {"list_date": "1993-01-22", "first_trade_date": "1993-01-22", "first_trade_final": false},
     "reference": "1993-01-22", "rule": true, "server": false, "chartServed": true},
    {"name": "daily bar 0 on list_date when first_trade_date is absent (reference falls back to list_date)",
     "tf": "D", "bars": [{"t": "2021-12-09"}],
     "ipo": {"list_date": "2021-12-09", "first_trade_final": true},
     "reference": "2021-12-09", "rule": true, "server": true, "chartServed": true},
    {"name": "malformed first_trade_date falls back to list_date",
     "tf": "D", "bars": [{"t": "2021-12-09"}],
     "ipo": {"list_date": "2021-12-09", "first_trade_date": "2021-12", "first_trade_final": true},
     "reference": "2021-12-09", "rule": true, "server": true, "chartServed": true},
    {"name": "bar 0 one session AFTER the reference: exact, never within a few days",
     "tf": "D", "bars": [{"t": "1993-02-01"}],
     "ipo": {"list_date": "1993-01-22", "first_trade_date": "1993-01-29", "first_trade_final": true},
     "reference": "1993-01-29", "rule": false, "server": false, "chartServed": false},
    {"name": "a curtain: bar 0 deep inside the symbol's life (the last 5,000 bars of SPY)",
     "tf": "D", "bars": [{"t": "2006-11-27"}],
     "ipo": {"list_date": "1993-01-22", "first_trade_date": "1993-01-29", "first_trade_final": true},
     "reference": "1993-01-29", "rule": false, "server": false, "chartServed": false},
    {"name": "bar 0 on list_date while the corroborated first trade differs: compared against first_trade_date",
     "tf": "D", "bars": [{"t": "1993-01-22"}],
     "ipo": {"list_date": "1993-01-22", "first_trade_date": "1993-01-29", "first_trade_final": true},
     "reference": "1993-01-29", "rule": false, "server": false, "chartServed": false},
    {"name": "a full ISO timestamp key reads as its date",
     "tf": "D", "bars": [{"t": "1993-01-29T00:00:00Z"}],
     "ipo": {"list_date": "1993-01-22", "first_trade_date": "1993-01-29", "first_trade_final": true},
     "reference": "1993-01-29", "rule": true, "server": true, "chartServed": true},
    {"name": "a numeric bar time is not a daily key and is never guessed",
     "tf": "D", "bars": [{"t": 728265600}],
     "ipo": {"list_date": "1993-01-22", "first_trade_date": "1993-01-29", "first_trade_final": true},
     "reference": "1993-01-29", "rule": false, "server": false, "chartServed": false},
    {"name": "reference with surrounding whitespace is trimmed",
     "tf": "D", "bars": [{"t": "2000-05-26"}],
     "ipo": {"list_date": "2000-05-22", "first_trade_date": " 2000-05-26 ", "first_trade_final": true},
     "reference": "2000-05-26", "rule": true, "server": true, "chartServed": true},
    {"name": "no listing fact at all",
     "tf": "D", "bars": [{"t": "2000-05-26"}],
     "ipo": null,
     "reference": null, "rule": false, "server": false, "chartServed": false},
    {"name": "a provider miss (list_date null)",
     "tf": "D", "bars": [{"t": "2000-05-26"}],
     "ipo": {"list_date": null, "first_trade_date": null, "first_trade_final": false},
     "reference": null, "rule": false, "server": false, "chartServed": false},
    {"name": "no bars",
     "tf": "D", "bars": [],
     "ipo": {"list_date": "2000-05-22", "first_trade_date": "2000-05-26", "first_trade_final": true},
     "reference": "2000-05-26", "rule": false, "server": false, "chartServed": false},
    {"name": "first_trade_final stated as a truthy non-boolean is not final",
     "tf": "D", "bars": [{"t": "2000-05-26"}],
     "ipo": {"list_date": "2000-05-22", "first_trade_date": "2000-05-26", "first_trade_final": "true"},
     "reference": "2000-05-26", "rule": true, "server": false, "chartServed": true},
    {"name": "intraday: never from the listing",
     "tf": "60", "bars": [{"t": "2000-05-26"}],
     "ipo": {"list_date": "2000-05-22", "first_trade_date": "2000-05-26", "first_trade_final": true},
     "reference": "2000-05-26", "rule": false, "server": false, "chartServed": false},
    {"name": "weekly: the rule is daily-only; the chart's serving switch serves the listing week, no server lane does yet",
     "tf": "W", "bars": [{"t": "2000-05-26"}],
     "ipo": {"list_date": "2000-05-22", "first_trade_date": "2000-05-26", "first_trade_final": true},
     "reference": "2000-05-26", "rule": false, "server": false, "chartServed": true},
    {"name": "monthly: never served from the listing",
     "tf": "M", "bars": [{"t": "2000-05-01"}],
     "ipo": {"list_date": "2000-05-22", "first_trade_date": "2000-05-26", "first_trade_final": true},
     "reference": "2000-05-26", "rule": false, "server": false, "chartServed": false}
  ]
}
