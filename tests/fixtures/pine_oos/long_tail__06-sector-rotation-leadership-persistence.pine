//@version=6
indicator("Sector Rotation - Leadership Persistence [Dots3Red]",
     shorttitle = "Sector Rotation [D3R]",
     overlay = false,
     max_labels_count = 500)

// COLORS
C_TXT = color.new(#f8fafc, 0)
C_DIM = color.new(#94a3b8, 0)
C_BG = color.new(#131722, 5)
C_BORD = color.new(#334155, 0)

// INPUTS
GRP_ANC = "⚓ Anchoring"
GRP_HUD = "🖥️ Dashboard"

anchor_mode = input.string("Month", "Rotation Anchor", options=["Week", "Month", "Quarter"], group=GRP_ANC,
     tooltip="Lines reset to zero at the start of each new period. Month is the standard rotation-analysis window.")
persist_check_bars = input.int(10, "Leadership Check Window (bars)", minval=3, maxval=60, group=GRP_ANC,
     tooltip="Bars ahead used to grade whether the current leader was still leading.")

show_hud = input.bool(true, "Show Dashboard", group=GRP_HUD)
hud_pos = input.string("Top Right", "Position",
     options=["Top Right","Top Left","Bottom Right","Bottom Left"], group=GRP_HUD)

// SECTOR UNIVERSE - 11 SPDR Select Sector ETFs
string[] NAMES = array.from("Tech","Financials","Energy","Health Care","Industrials","Discretionary","Staples","Utilities","Materials","Real Estate","Comm Services")
color[] COLS = array.from(
     color.new(#00f0ff,0), color.new(#00c896,0), color.new(#ffb700,0), color.new(#ff00aa,0),
     color.new(#94a3b8,0), color.new(#22c55e,0), color.new(#f97316,0), color.new(#a855f7,0),
     color.new(#eab308,0), color.new(#ef4444,0), color.new(#3b82f6,0))

int N = 11

close_1 = request.security("XLK", timeframe.period, close, lookahead=barmerge.lookahead_off)
close_2 = request.security("XLF", timeframe.period, close, lookahead=barmerge.lookahead_off)
close_3 = request.security("XLE", timeframe.period, close, lookahead=barmerge.lookahead_off)
close_4 = request.security("XLV", timeframe.period, close, lookahead=barmerge.lookahead_off)
close_5 = request.security("XLI", timeframe.period, close, lookahead=barmerge.lookahead_off)
close_6 = request.security("XLY", timeframe.period, close, lookahead=barmerge.lookahead_off)
close_7 = request.security("XLP", timeframe.period, close, lookahead=barmerge.lookahead_off)
close_8 = request.security("XLU", timeframe.period, close, lookahead=barmerge.lookahead_off)
close_9 = request.security("XLB", timeframe.period, close, lookahead=barmerge.lookahead_off)
close_10 = request.security("XLRE", timeframe.period, close, lookahead=barmerge.lookahead_off)
close_11 = request.security("XLC", timeframe.period, close, lookahead=barmerge.lookahead_off)

float[] closes = array.from(close_1, close_2, close_3, close_4, close_5, close_6, close_7, close_8, close_9, close_10, close_11)

bool new_week = ta.change(time("W")) != 0
bool new_month = ta.change(time("M")) != 0
bool new_qtr = ta.change(time("3M")) != 0

bool do_reset = switch anchor_mode
    "Week" => new_week
    "Quarter" => new_qtr
    => new_month

var float[] anchor_px = array.new<float>(N, na)

if do_reset or bar_index == 0
    for i = 0 to N - 1
        array.set(anchor_px, i, array.get(closes, i))

float[] ret_pct = array.new<float>(N, na)
for i = 0 to N - 1
    float ap = array.get(anchor_px, i)
    float cp = array.get(closes, i)
    array.set(ret_pct, i, (not na(ap) and ap != 0) ? (cp - ap) / ap * 100.0 : 0.0)

f_argmax(float[] arr) =>
    int best_i = 0
    float best_v = array.get(arr, 0)
    for i = 1 to array.size(arr) - 1
        float v = array.get(arr, i)
        if v > best_v
            best_v := v
            best_i := i
    best_i

int current_leader = f_argmax(ret_pct)

var int leader_prev = na
var int leader_since_bar = na
var int changeovers = 0
var float duration_sum = 0.0

var int grade_leader = na
var int grade_bar = na
var int persist_total = 0
var int persist_correct = 0

bool leader_changed_now = false

if barstate.isconfirmed
    if na(leader_prev)
        leader_prev := current_leader
        leader_since_bar := bar_index

    if current_leader != leader_prev
        changeovers += 1
        duration_sum += float(bar_index - leader_since_bar)
        grade_leader := leader_prev
        grade_bar := bar_index
        leader_prev := current_leader
        leader_since_bar := bar_index
        leader_changed_now := true

    if not na(grade_bar) and (bar_index - grade_bar) >= persist_check_bars
        persist_total += 1
        if current_leader == grade_leader
            persist_correct += 1
        grade_bar := na

// VISUALS
plot(array.get(ret_pct,0), "Tech", color=array.get(COLS,0), linewidth=2)
plot(array.get(ret_pct,1), "Financials", color=array.get(COLS,1), linewidth=2)
plot(array.get(ret_pct,2), "Energy", color=array.get(COLS,2), linewidth=2)
plot(array.get(ret_pct,3), "Health Care", color=array.get(COLS,3), linewidth=2)
plot(array.get(ret_pct,4), "Industrials", color=array.get(COLS,4), linewidth=1)
plot(array.get(ret_pct,5), "Discretionary", color=array.get(COLS,5), linewidth=1)
plot(array.get(ret_pct,6), "Staples", color=array.get(COLS,6), linewidth=1)
plot(array.get(ret_pct,7), "Utilities", color=array.get(COLS,7), linewidth=1)
plot(array.get(ret_pct,8), "Materials", color=array.get(COLS,8), linewidth=1)
plot(array.get(ret_pct,9), "Real Estate", color=array.get(COLS,9), linewidth=1)
plot(array.get(ret_pct,10), "Comm Services", color=array.get(COLS,10), linewidth=1)

hline(0, "Zero", color=color.new(C_DIM, 60), linestyle=hline.style_dashed)

var label[] end_labels = array.new<label>()
if barstate.islast
    if array.size(end_labels) > 0
        for i = 0 to array.size(end_labels) - 1
            label.delete(array.get(end_labels, i))
        array.clear(end_labels)
    for i = 0 to N - 1
        float rv = array.get(ret_pct, i)
        string nm = array.get(NAMES, i)
        string txt = (i == current_leader ? "★ " : "") + nm + " " + str.tostring(rv, "+#.##") + "%"
        array.push(end_labels, label.new(bar_index + 2, rv, txt,
             style=label.style_label_left,
             color=color.new(#000000, 100),
             textcolor=array.get(COLS, i),
             size=size.small))

// DASHBOARD
f_hud_pos(string s) =>
    switch s
        "Top Right" => position.top_right
        "Top Left" => position.top_left
        "Bottom Right" => position.bottom_right
        => position.bottom_left

var table hud = table.new(f_hud_pos(hud_pos), 2, 18,
     bgcolor=C_BG, border_color=C_BORD,
     border_width=1, frame_color=C_BORD, frame_width=2)

if show_hud and barstate.islast
    table.cell(hud, 0, 0, "SECTOR ROTATION [D3R]", text_color=C_TXT,
         bgcolor=color.new(#1e293b, 0), text_size=11, text_halign=text.align_center)
    table.merge_cells(hud, 0, 0, 1, 0)

    table.cell(hud, 0, 1, "Current Leader", text_color=C_DIM, bgcolor=color.new(#1e293b, 40), text_size=11)
    table.cell(hud, 1, 1, array.get(NAMES, current_leader),
         text_color=array.get(COLS, current_leader),
         bgcolor=color.new(#1e293b, 40), text_size=11, text_halign=text.align_center)

    table.cell(hud, 0, 2, "Led Since", text_color=C_DIM, bgcolor=color.new(#0f172a, 40), text_size=11)
    table.cell(hud, 1, 2, na(leader_since_bar) ? "—" : str.tostring(bar_index - leader_since_bar) + " bars ago",
         text_color=C_TXT, bgcolor=color.new(#0f172a, 40), text_size=11, text_halign=text.align_center)

    float avg_dur = changeovers > 0 ? duration_sum / float(changeovers) : na
    table.cell(hud, 0, 3, "Avg Leadership", text_color=C_DIM, bgcolor=color.new(#1e293b, 40), text_size=11)
    table.cell(hud, 1, 3, na(avg_dur) ? "—" : str.tostring(math.round(avg_dur)) + " bars (n=" + str.tostring(changeovers) + ")",
         text_color=C_TXT, bgcolor=color.new(#1e293b, 40), text_size=11, text_halign=text.align_center)

    float persist_pct = persist_total > 0 ? float(persist_correct) / float(persist_total) * 100.0 : na
    table.cell(hud, 0, 4, "Leader Persists", text_color=C_DIM, bgcolor=color.new(#0f172a, 40), text_size=11,
         tooltip="Historical odds a new leader is still leading " + str.tostring(persist_check_bars) + " bars later.")
    table.cell(hud, 1, 4, na(persist_pct) ? "—" : str.tostring(math.round(persist_pct)) + "% (n=" + str.tostring(persist_total) + ")",
         text_color=na(persist_pct) ? C_DIM : persist_pct >= 50 ? color.new(#00c896,0) : color.new(#ff4466,0),
         bgcolor=color.new(#0f172a, 40), text_size=11, text_halign=text.align_center)

    table.cell(hud, 0, 5, "Changeovers", text_color=C_DIM, bgcolor=color.new(#1e293b, 40), text_size=11)
    table.cell(hud, 1, 5, str.tostring(changeovers),
         text_color=C_TXT, bgcolor=color.new(#1e293b, 40), text_size=11, text_halign=text.align_center)

    table.cell(hud, 0, 6, "─── Legend (ranked) ───", text_color=C_DIM,
         bgcolor=color.new(#0f172a, 0), text_size=11, text_halign=text.align_center)
    table.merge_cells(hud, 0, 6, 1, 6)

    int[] rank_idx = array.new<int>(N)
    float[] rank_val = array.new<float>(N)
    for i = 0 to N - 1
        array.set(rank_idx, i, i)
        array.set(rank_val, i, array.get(ret_pct, i))
    for a = 0 to N - 2
        int best = a
        for b = a + 1 to N - 1
            if array.get(rank_val, b) > array.get(rank_val, best)
                best := b
        if best != a
            float tv = array.get(rank_val, a)
            array.set(rank_val, a, array.get(rank_val, best))
            array.set(rank_val, best, tv)
            int ti = array.get(rank_idx, a)
            array.set(rank_idx, a, array.get(rank_idx, best))
            array.set(rank_idx, best, ti)

    for r = 0 to N - 1
        int idx = array.get(rank_idx, r)
        string nm2 = array.get(NAMES, idx)
        float rv2 = array.get(rank_val, r)
        color c2 = array.get(COLS, idx)
        string mark = idx == current_leader ? "★ " : "● "
        table.cell(hud, 0, 7 + r, mark + nm2, text_color=c2, bgcolor=color.new(r % 2 == 0 ? #1e293b : #0f172a, 40), text_size=11)
        table.cell(hud, 1, 7 + r, str.tostring(rv2, "+#.##") + "%", text_color=c2,
             bgcolor=color.new(r % 2 == 0 ? #1e293b : #0f172a, 40), text_size=11, text_halign=text.align_center)

// ALERTS
alertcondition(leader_changed_now, "Sector Leadership Changed", "D3R Sector Rotation: a new sector has taken the lead")
