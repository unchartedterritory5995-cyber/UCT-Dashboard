  "cases": [
    {
      "name": "a fill starts from nothing: the payload, share off",
      "old": {},
      "payload": {
        "asOf": "2026-10-24T15:30:00Z",
        "defId": "shelf:equity-curve",
        "defRev": 1,
        "count": 3
      },
      "expected": {
        "asOf": "2026-10-24T15:30:00Z",
        "defId": "shelf:equity-curve",
        "defRev": 1,
        "count": 3,
        "share": false
      },
      "params": {
        "asOf": "2026-10-24T15:30:00Z",
        "defId": "shelf:equity-curve",
        "defRev": 1,
        "count": 3,
        "share": false
      },
      "searchText": "[widget: widget · as of 2026-10-24]"
    },
    {
      "name": "the member's current share switch is kept",
      "old": {
        "share": true,
        "asOf": "2026-10-01T00:00:00Z"
      },
      "payload": {
        "asOf": "2026-10-24T15:30:00Z"
      },
      "expected": {
        "asOf": "2026-10-24T15:30:00Z",
        "share": true
      },
      "params": {
        "asOf": "2026-10-24T15:30:00Z",
        "share": true
      },
      "searchText": "[widget: widget · as of 2026-10-24]"
    },
    {
      "name": "nothing else is copied from the old params",
      "old": {
        "share": false,
        "stale": "gone",
        "count": 9
      },
      "payload": {
        "asOf": "x",
        "count": 2
      },
      "expected": {
        "asOf": "x",
        "count": 2,
        "share": false
      },
      "params": {
        "asOf": "x",
        "count": 2,
        "share": false
      },
      "searchText": "[widget: widget]"
    },
    {
      "name": "a payload never turns sharing on",
      "old": {
        "share": false
      },
      "payload": {
        "asOf": "x",
        "share": true
      },
      "expected": {
        "asOf": "x",
        "share": false
      },
      "params": {
        "asOf": "x",
        "share": false
      },
      "searchText": "[widget: widget]"
    },
    {
      "name": "a truthy share that is not true is off",
      "old": {
        "share": "yes"
      },
      "payload": {
        "asOf": "x"
      },
      "expected": {
        "asOf": "x",
        "share": false
      },
      "params": {
        "asOf": "x",
        "share": false
      },
      "searchText": "[widget: widget]"
    },
    {
      "name": "a payload that is not an object keeps only the switch",
      "old": {},
      "payload": null,
      "expected": {
        "share": false
      },
      "params": {
        "share": false
      },
      "searchText": "[widget: widget]"
    },
    {
      "name": "old params that are not an object read as none",
      "old": null,
      "payload": {
        "asOf": "x",
        "defRef": {
          "id": "a",
          "rev": 2
        }
      },
      "expected": {
        "asOf": "x",
        "defRef": {
          "id": "a",
          "rev": 2
        },
        "share": false
      },
      "params": {
        "asOf": "x",
