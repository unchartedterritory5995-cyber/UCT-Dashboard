           {
            "type": "series",
            "name": "close"
           }
          ]
         }
        ]
       },
       {
        "type": "op",
        "name": "+",
        "args": [
         {
          "type": "op",
          "name": "+",
          "args": [
           {
            "type": "series",
            "name": "low"
           },
           {
            "type": "series",
            "name": "high"
           }
          ]
         },
         {
          "type": "op",
          "name": "+",
          "args": [
           {
            "type": "op",
            "name": "+",
            "args": [
             {
              "type": "series",
              "name": "time"
             },
             {
              "type": "series",
              "name": "dayofweek"
             }
            ]
           },
           {
            "type": "op",
            "name": "+",
            "args": [
             {
              "type": "series",
              "name": "dayopentime"
             },
             {
              "type": "op",
              "name": "+",
              "args": [
               {
                "type": "series",
                "name": "periodseconds"
               },
               {
                "type": "series",
                "name": "isintraday"
               }
              ]
             }
            ]
           }
          ]
         }
        ]
       }
      ]
     },
     {
      "type": "num",
      "value": 252
     }
    ]
   },
   "expected": 4,
   "before": 10
  },
  {
   "name": "offset over a clock column",
   "tree": {
    "type": "op",
    "name": "-",
    "args": [
     {
      "type": "series",
      "name": "time"
     },
     {
      "type": "offset",
