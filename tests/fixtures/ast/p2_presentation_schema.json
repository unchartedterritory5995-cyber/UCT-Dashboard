{
  "_": "P2 policy slice shared fixture: the presentation vocabulary and cases held equal between the BROWSER validator (app/src/components/chart/engine/defSchema.js validateDefinition -- the authority the builder saves through) and the SERVER save door (api/services/presentation_schema.py, called by user_definitions.save). Each case patches a base three-plot document (value: line, cond: hidden line, sig: markers circle). `plots` patches fields by plot key (null deletes a field); `paints` replaces the document's paints. `expect` is ok|refused; a refused case names the server `code` and the browser error must mention `browser` (a fragment of defSchema's own sentence). The server must never refuse what the browser accepts.",
  "vocab": {
    "plotStyles": ["line", "stepline", "histogram", "area", "baseline", "hlines", "markers", "band"],
    "reservedPlotStyles": ["zones", "bgband", "barcolor", "fill", "cross"],
    "markerShapes": ["circle", "square", "arrowUp", "arrowDown"],
    "markerPositions": ["aboveBar", "belowBar", "inBar"],
    "markerSizeRange": {"min": 0.25, "max": 4},
    "markerTextMax": 24,
    "paintKinds": ["bgcolor", "barcolor"],
    "colorModes": ["fixed", "sign"]
  },
  "cases": [
    {"name": "baseline", "expect": "ok"},
    {"name": "barcolor on a condition column", "paints": [{"kind": "barcolor", "colorMode": "column:cond", "colorUp": "#26a69a", "colorDown": "transparent"}], "expect": "ok"},
    {"name": "static bgcolor with opacity", "paints": [{"kind": "bgcolor", "color": "#123456", "opacity": 0.2}], "expect": "ok"},
    {"name": "Pine palette barcolor", "paints": [{"kind": "barcolor", "title": "t", "line": 3, "colorMode": "column:cond", "colorPalette": ["rgba(0, 0, 0, 0)", "#ffeb3b"]}], "expect": "ok"},
    {"name": "gradient bgcolor + packed barcolor + offset/showLast", "paints": [{"kind": "bgcolor", "colorMode": "column:value", "colorGradient": {"from": "#000000", "to": "#ffffff"}, "offset": -1}, {"kind": "barcolor", "colorMode": "column:cond", "colorPacked": {"transparency": 10}, "showLast": 5}], "expect": "ok"},
    {"name": "paint kind outside the list", "paints": [{"kind": "fill", "color": "#fff"}], "expect": "refused", "code": "paint-kind", "browser": "paints[0].kind"},
    {"name": "paint reads a column no plot declares", "paints": [{"kind": "barcolor", "colorMode": "column:nope", "colorUp": "#fff", "colorDown": "#000"}], "expect": "refused", "code": "paint-column", "browser": "which no plot declares"},
    {"name": "paint colorMode not column:", "paints": [{"kind": "barcolor", "colorMode": "sign", "colorUp": "#fff", "colorDown": "#000"}], "expect": "refused", "code": "paint-color-mode", "browser": "paints[0].colorMode"},
    {"name": "paint with no colour at all", "paints": [{"kind": "bgcolor"}], "expect": "refused", "code": "paint-colour", "browser": "must declare a colour"},
    {"name": "paint says two ways at once", "paints": [{"kind": "barcolor", "colorMode": "column:cond", "colorUp": "#fff", "colorDown": "#000", "colorPalette": ["#111", "#222"]}], "expect": "refused", "code": "paint-ways", "browser": "needs exactly one"},
    {"name": "paint opacity out of range", "paints": [{"kind": "bgcolor", "color": "#fff", "opacity": 2}], "expect": "refused", "code": "paint-field", "browser": "paints[0].opacity"},
    {"name": "paint colorPacked transparency 101", "paints": [{"kind": "barcolor", "colorMode": "column:cond", "colorPacked": {"transparency": 101}}], "expect": "refused", "code": "paint-field", "browser": "colorPacked.transparency"},
    {"name": "paint offset not whole", "paints": [{"kind": "bgcolor", "color": "#fff", "offset": 1.5}], "expect": "refused", "code": "paint-field", "browser": "paints[0].offset"},
    {"name": "paint not an object", "paints": ["#fff"], "expect": "refused", "code": "paint-shape", "browser": "paints[0]"},
    {"name": "paints not an array", "paints": {"kind": "bgcolor"}, "expect": "refused", "code": "paint-shape", "browser": "paints: expected an array"},
    {"name": "marker shape outside the list", "plots": {"sig": {"marker": {"shape": "star"}}}, "expect": "refused", "code": "marker-shape", "browser": "marker.shape"},
    {"name": "marker position outside the list", "plots": {"sig": {"marker": {"shape": "circle", "position": "top"}}}, "expect": "refused", "code": "marker-position", "browser": "marker.position"},
    {"name": "marker on a line plot", "plots": {"value": {"marker": {"shape": "circle"}}}, "expect": "refused", "code": "marker-style", "browser": "only a plot with style"},
    {"name": "marker text over 24", "plots": {"sig": {"marker": {"shape": "circle", "text": "abcdefghijklmnopqrstuvwxy"}}}, "expect": "refused", "code": "marker-text", "browser": "at most 24"},
    {"name": "marker size out of range", "plots": {"sig": {"marker": {"shape": "circle", "size": 9}}}, "expect": "refused", "code": "marker-size", "browser": "marker.size"},
    {"name": "marker every legal field", "plots": {"sig": {"marker": {"shape": "arrowDown", "position": "inBar", "size": 1, "text": "dn"}}}, "expect": "ok"},
    {"name": "reserved plot style", "plots": {"value": {"style": "cross"}}, "expect": "refused", "code": "plot-style", "browser": "SCHEMA-RESERVED"},
    {"name": "unknown plot style", "plots": {"value": {"style": "dots"}}, "expect": "refused", "code": "plot-style", "browser": "unknown plot style"},
    {"name": "every buildable non-guide style", "plots": {"value": {"style": "histogram"}, "cond": {"style": "stepline"}}, "expect": "ok"},
    {"name": "sign colour mode with both colours", "plots": {"value": {"colorMode": "sign", "colorUp": "#0f0", "colorDown": "#f00"}}, "expect": "ok"},
    {"name": "sign colour mode missing colorDown", "plots": {"value": {"colorMode": "sign", "colorUp": "#0f0"}}, "expect": "refused", "code": "color-mode-colours", "browser": "colour mode \"sign\""},
    {"name": "plot colorMode names a missing column", "plots": {"value": {"colorMode": "column:zzz", "colorUp": "#0f0", "colorDown": "#f00"}}, "expect": "refused", "code": "color-mode-column", "browser": "which no plot or event declares"},
    {"name": "plot colorMode unknown", "plots": {"value": {"colorMode": "rainbow"}}, "expect": "refused", "code": "color-mode", "browser": "unknown colour mode"},
    {"name": "plot column mode with a computed colour", "plots": {"cond": {"colorMode": "column:cond", "colorPacked": {"transparency": 20}}}, "expect": "ok"},
    {"name": "plot column mode with nothing to alternate", "plots": {"value": {"colorMode": "column:cond"}}, "expect": "refused", "code": "color-mode-colours", "browser": "must declare both colorUp and colorDown"},
    {"name": "plot palette without a column mode", "plots": {"value": {"colorPalette": ["#111", "#222"]}}, "expect": "refused", "code": "plot-colour-field", "browser": "colorPalette"},
    {"name": "plot colorUp not a string", "plots": {"value": {"colorUp": 3}}, "expect": "refused", "code": "plot-colour-field", "browser": "colorUp"}
  ]
}
