          "rs_rating_pos",
          "rs_pos_1m",
          "rs_pos_3m",
          "rs_pos_6m",
          "rs_pos_12m",
          "rs_rating_chg_20",
          "pct_vs_sma50"
        ],
        "options": [
          {
            "id": "overall",
            "label": "Overall",
            "default": true,
            "filters": [
              {
                "key": "rs_rating_pos",
                "op": "gte",
                "min": 1
              }
            ],
            "sort": {
              "key": "rs_rating_pos",
              "dir": "asc"
            }
          },
          {
            "id": "m1",
            "label": "1M",
            "filters": [
              {
                "key": "rs_pos_1m",
                "op": "gte",
                "min": 1
              }
            ],
            "sort": {
              "key": "rs_pos_1m",
              "dir": "asc"
            },
            "place": "rs_pos_1m"
          },
          {
            "id": "m3",
            "label": "3M",
            "filters": [
              {
                "key": "rs_pos_3m",
                "op": "gte",
                "min": 1
              }
            ],
            "sort": {
              "key": "rs_pos_3m",
              "dir": "asc"
            },
            "place": "rs_pos_3m"
          },
          {
            "id": "m6",
            "label": "6M",
            "filters": [
              {
                "key": "rs_pos_6m",
                "op": "gte",
                "min": 1
              }
            ],
            "sort": {
              "key": "rs_pos_6m",
              "dir": "asc"
            },
            "place": "rs_pos_6m"
          },
          {
            "id": "m12",
            "label": "12M",
            "filters": [
              {
                "key": "rs_pos_12m",
                "op": "gte",
                "min": 1
              }
            ],
            "sort": {
              "key": "rs_pos_12m",
              "dir": "asc"
            },
            "place": "rs_pos_12m"
          },
          {
            "id": "rising",
            "label": "Rising fastest",
            "filters": [
              {
                "key": "rs_rating_pos",
                "op": "gte",
                "min": 1
              },
              {
                "key": "rs_rating_chg_20",
                "op": "gte",
                "min": 1
              },
              {
                "key": "pct_vs_sma50",
                "op": "gt",
                "min": 0
              }
            ],
            "sort": {
              "key": "rs_rating_chg_20",
              "dir": "desc",
              "then": {
                "key": "rs_rating_pos",
                "dir": "asc"
              }
            }
          }
        ]
      },
      {
        "id": "show",
        "label": "Show",
        "keys": [
          "rs_rank",
          "rs_rating_prev20"
        ],
        "options": [
          {
            "id": "all",
            "label": "All",
            "default": true,
            "filters": []
          },
          {
            "id": "r90",
            "label": "90 and up",
            "filters": [
              {
                "key": "rs_rank",
                "op": "gte",
                "min": 90
              }
            ]
          },
          {
            "id": "new90",
            "label": "New to 90+",
            "filters": [
              {
                "key": "rs_rank",
                "op": "gte",
                "min": 90
              },
              {
                "key": "rs_rating_prev20",
                "op": "lt",
                "max": 90
              }
            ]
          }
        ]
      }
    ],
    "row": {
      "place": "rs_rating_pos",
      "caption": [
        "setup",
        "moving"
      ],
      "tags": [
        "flag",
        "new"
      ]
    }
  },
  {
    "id": "starter_rs_new_high",
