            ]
          },
          {
            "id": "r80",
            "label": "80",
            "filters": [
              {
                "key": "rs_rank",
                "op": "gte",
                "min": 80
              }
            ]
          },
          {
            "id": "r90",
            "label": "90",
            "filters": [
              {
                "key": "rs_rank",
                "op": "gte",
                "min": 90
              }
            ]
          }
        ]
      },
      {
        "id": "down",
        "label": "Market",
        "keys": [
          "rs_nh_red_bars_ago"
        ],
        "options": [
          {
            "id": "all",
            "label": "Any day",
            "default": true,
            "filters": []
