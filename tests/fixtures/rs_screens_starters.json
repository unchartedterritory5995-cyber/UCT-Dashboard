[
  {
    "id": "starter_rs_top_rating",
    "name": "Top RS Rating",
    "group": "Relative strength",
    "description": "Every liquid stock ranked by RS Rating, strongest first, with its exact place",
    "spec": {
      "filters": [
        {
          "key": "price",
          "op": "gte",
          "min": 10
        },
        {
          "key": "dollar_vol_30d",
          "op": "gte",
          "min": 20000000
        },
        {
          "key": "rs_rating_pos",
          "op": "gte",
          "min": 1
        },
        {
          "key": "rs_flag",
          "op": "not_in",
          "values": [
            "buyout_pending"
          ]
        },
        {
          "key": "security_type",
          "op": "not_in",
          "values": [
            "ETF"
          ]
        }
      ],
      "view": "rs_top_rating",
      "sort": {
        "key": "rs_rating_pos",
        "dir": "asc"
      }
    },
    "controls": [
      {
        "id": "rank_by",
        "label": "Rank by",
