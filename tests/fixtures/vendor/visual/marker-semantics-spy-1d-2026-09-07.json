  "script": {
    "dialect": "pine",
    "source": "//@version=5\nindicator(\"UCT marker parity probe\", overlay = true)\nma = ta.sma(close, 20)\nup = ta.crossover(close, ma)\ndn = ta.crossunder(close, ma)\nplot(ma, title = \"MA20\", color = color.blue)\nplot(up ? 1 : 0, title = \"UPFLAG\", display = display.data_window)\nplot(dn ? 1 : 0, title = \"DNFLAG\", display = display.data_window)\nplotshape(up, title = \"UP\", style = shape.triangleup, location = location.belowbar, color = color.green, text = \"U\", size = size.small)\nplotshape(dn, title = \"DN\", style = shape.triangledown, location = location.abovebar, color = color.red, text = \"D\", size = size.small)\nplotshape(up ? ma : na, title = \"ABS\", style = shape.circle, location = location.absolute, color = color.orange)\nplotchar(up, title = \"CH\", char = \"X\", location = location.abovebar, color = color.purple)\nplotshape(up or dn, title = \"DYN\", style = shape.square, location = location.belowbar, color = up ? color.aqua : color.fuchsia)\n"
  },
