//@version=4
study("Door stamp v4", overlay=false)
p1 = plot(sma(close, 10), "p1", color=color.gray)
p2 = plot(sma(close, 20), "p2", color=color.gray)
fill(p1, p2, color=color.red)
p3 = plot(sma(close, 30), "p3", color=color.gray)
p4 = plot(sma(close, 40), "p4", color=color.gray)
fill(p3, p4, color=color.red, transp=70)
