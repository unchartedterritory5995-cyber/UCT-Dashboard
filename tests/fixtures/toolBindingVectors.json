{
  "version": 1,
  "about": "Shared day-binding vectors (ruling W11-R14). Read by the server (tests/test_tool_binding_vectors.py over api/services/journal_two/tool_binding.py) and the client (lib/blocks/toolDays.js, Task 11.14). Expected values are written by hand from the market calendar; neither side derives them.",
  "bind": [
    {
      "note_day": "2026-11-22",
      "bind": "next-trading-day",
      "expected": "2026-11-23",
      "why": "Night-before prep made Sunday 2026-11-22 21:00 ET binds Monday"
    },
    {
      "note_day": "2026-11-25",
      "bind": "next-trading-day",
      "expected": "2026-11-27",
      "why": "Wednesday before Thanksgiving skips Thu 11-26; the Friday half day is a session"
    },
    {
      "note_day": "2026-11-26",
      "bind": "next-trading-day",
      "expected": "2026-11-27",
      "why": "23:30 ET on Thanksgiving (04:30 UTC Friday) still binds Fri 11-27"
    },
    {
      "note_day": "2026-10-24",
      "bind": "week",
      "expected": "2026-10-23",
      "why": "Weekend swing review on Saturday binds the Friday of the week just ended"
    },
    {
      "note_day": "2026-10-25",
      "bind": "week",
      "expected": "2026-10-23",
      "why": "Sunday still belongs to the Monday-to-Sunday week ending that day"
    },
    {
      "note_day": "2026-07-04",
      "bind": "week",
      "expected": "2026-07-02",
      "why": "Fri 2026-07-03 is the observed Independence Day holiday: binds Thursday"
    },
    {
      "note_day": "2026-10-19",
      "bind": "week",
      "expected": "2026-10-23",
      "why": "A Monday binds that week's Friday"
    },
    {
      "note_day": "2026-11-23",
      "bind": "week",
      "expected": "2026-11-27",
      "why": "Thanksgiving week ends on the Friday half day"
    },
    {
      "note_day": "2027-01-02",
      "bind": "week",
      "expected": "2026-12-31",
      "why": "New Year's Day 2027-01-01 is a Friday holiday: the week ends Thursday"
    },
    {
      "note_day": "2027-03-27",
      "bind": "week",
      "expected": "2027-03-25",
      "why": "Good Friday 2027-03-26: the week ends Thursday"
    },
    {
      "note_day": "2027-03-25",
      "bind": "next-trading-day",
      "expected": "2027-03-29",
      "why": "Thursday before Good Friday binds the Monday after, 2027-03-29"
    },
    {
      "note_day": "2026-12-31",
      "bind": "next-trading-day",
      "expected": "2027-01-04",
      "why": "New Year's Eve skips the 2027-01-01 holiday and the weekend"
    },
    {
      "note_day": "2026-12-23",
      "bind": "next-trading-day",
      "expected": "2026-12-24",
      "why": "Christmas Eve 2026-12-24 is a half day and still a session"
    },
    {
      "note_day": "2026-12-24",
      "bind": "next-trading-day",
      "expected": "2026-12-28",
      "why": "Christmas Day is a Friday holiday; the next session is Monday"
    },
    {
      "note_day": "2026-10-23",
      "bind": "next-trading-day",
      "expected": "2026-10-26",
      "why": "A Friday binds the Monday after"
    },
    {
      "note_day": "2026-10-26",
      "bind": "next-trading-day",
      "expected": "2026-10-27",
      "why": "A plain weekday binds the next weekday"
    },
    {
      "note_day": "2028-12-29",
      "bind": "next-trading-day",
      "expected": "2029-01-01",
      "why": "Past the calendar horizon (2028-12-31) weekdays count: 2029-01-01 is a Monday"
    },
    {
      "note_day": "2029-01-06",
      "bind": "week",
      "expected": "2029-01-05",
      "why": "A week wholly past the horizon ends on its Friday"
    },
    {
      "note_day": "2029-01-05",
      "bind": "next-trading-day",
      "expected": "2029-01-08",
      "why": "Past the horizon a Friday binds the Monday after"
    },
    {
      "note_day": "2026-11-27",
      "bind": "note-day",
      "expected": "2026-11-27",
      "why": "note-day is the note's own day: the half day"
    },
    {
      "note_day": "2027-01-01",
      "bind": "note-day",
      "expected": "2027-01-01",
      "why": "note-day is the note's own day even on a holiday"
    },
    {
      "note_day": "2026-10-24",
      "bind": "note-day",
      "expected": "2026-10-24",
      "why": "note-day is the note's own day even on a Saturday"
    },
    {
      "note_day": "2027-03-29",
      "bind": "note-day",
      "expected": "2027-03-29",
      "why": "The Monday after Good Friday binds itself"
    }
  ],
