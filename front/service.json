{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.web",
    "watchPatterns": [
      "app/**",
      "api/front_app.py",
      "api/services/static_assets.py",
      "api/services/build_manifest.py",
      "front/**",
      "Dockerfile.web",
      "requirements*.txt"
    ]
  },
  "deploy": {
    "startCommand": "/bin/sh -c \"exec uvicorn api.front_app:app --host 0.0.0.0 --port ${PORT:-8080} --timeout-graceful-shutdown 25 --no-access-log\"",
    "numReplicas": 2,
    "healthcheckPath": "/__front/health",
    "healthcheckTimeout": 120,
    "drainingSeconds": 30,
    "restartPolicyType": "ALWAYS"
  }
}
