{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "buildCommand": "pip install -r requirements.txt",
    "watchPatterns": [
      "api/stream_ingest_main.py",
      "api/services/ingest_runtime.py",
      "api/services/ingest_side_feeds.py",
      "api/services/ingest_feed_server.py",
      "api/services/feed_protocol.py",
      "api/services/ingest_core.py",
      "api/services/massive_reconnect.py",
      "api/services/bar_stream.py",
      "api/services/bar_broadcaster.py",
      "api/services/extended_session.py",
      "api/services/bar_rollup.py",
      "api/services/trade_conditions.py",
      "api/services/vendor_socket_guard.py",
      "api/services/bars_live_ingest.py",
      "api/services/minute_frame_publisher.py",
      "api/services/minute_frames.py",
      "api/services/live_price_source.py",
      "api/services/vendor_symbols.py",
      "api/services/massive.py",
      "api/services/massive_adapter.py",
      "api/services/bars_live_store.py",
      "api/services/nyse_calendar.py",
      "api/services/session_calendar.py",
      "api/services/snapshot_hl.py",
      "api/services/cache.py",
      "api/services/cache_policy.py",
      "api/services/log_redaction.py",
      "api/services/provider_errors.py",
      "api/services/provider_licensing_class.py",
      "api/services/yf_util.py",
      "requirements.txt",
      "railway.ingest.json"
    ]
  },
  "deploy": {
    "startCommand": "python -m api.stream_ingest_main",
    "drainingSeconds": 15,
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ALWAYS",
    "overlapSeconds": 0
  }
}
