ne class="labelLeader" x1="284.3382213195894" y1="189.80467211436812" x2="290.3382213195894" y2="223.41408696998099"></line><text class="pointLabel" x="290.3382213195894" y="223.41408696998099" text-anchor="start">XLF</text></g><g data-testid="rrg-point-XLK" data-quadrant="Leading"><polyline class="tailLine qLeading" points="280.00000000000125,190.00000000000307 280.00000000000125,190.00000000000307 280.00000000000733,189.99999999999537 280.00000000000125,190.00000000000307 280.00000000000125,190.00000000000307 279.99999999999517,190.0000000000108 280.00000000000125,190.00000000000307 280.00000000000125,190.00000000000307"></polyline><circle class="qLeading" cx="280.00000000000125" cy="190.00000000000307" r="1.6"></circle><circle class="qLeading" cx="280.00000000000125" cy="190.00000000000307" r="1.6"></circle><circle class="qLeading" cx="280.00000000000733" cy="189.99999999999537" r="1.6"></circle><circle class="qLeading" cx="280.00000000000125" cy="190.00000000000307" r="1.6"></circle><circle class="qLeading" cx="280.00000000000125" cy="190.00000000000307" r="1.6"></circle><circle class="qLeading" cx="279.99999999999517" cy="190.0000000000108" r="1.6"></circle><circle class="qLeading" cx="280.00000000000125" cy="190.00000000000307" r="1.6"></circle><circle class="qLeading" cx="280.00000000000125" cy="190.00000000000307" r="4"></circle><line class="labelLeader" x1="280.00000000000125" y1="190.00000000000307" x2="286.00000000000125" y2="243.41408696998099"></line><text class="pointLabel" x="286.00000000000125" y="243.41408696998099" text-anchor="start">XLK</text></g></svg></div><div class="tableBox"><table class="table" data-testid="terminal-rrg-table" aria-label="Rotation quadrants vs SPY"><thead><tr><th scope="col">Symbol</th><th scope="col">Quadrant</th><th scope="col">Weeks in it</th><th scope="col">RS-Ratio</th><th scope="col">RS-Momentum</th><th scope="col">vs SPY, last 8 weeks</th></tr></thead><tbody><tr data-testid="terminal-rrg-row-XLE"><td><button type="button" class="rowBtn" title="Load XLE into the linked panels"><span class="rowNum">1</span><span class="symCell">XLE</span><span class="muted"> Energy</span></button></td><td><span class="quadPill pLeading">Leading</span></td><td>13</td><td>100.25</td><td>100.00</td><td class="up">+0.4%</td></tr><tr data-testid="terminal-rrg-row-XLI"><td><button type="button" class="rowBtn" title="Load XLI into the linked panels"><span class="rowNum">2</span><span class="symCell">XLI</span><span class="muted"> Industrials</span></button></td><td><span class="quadPill pLeading">Leading</span></td><td>47</td><td>100.03</td><td>100.00</td><td class="up">+0.0%</td></tr><tr data-testid="terminal-rrg-row-XLV"><td><button type="button" class="rowBtn" title="Load XLV into the linked panels"><span class="rowNum">3</span><span class="symCell">XLV</span><span class="muted"> Healthcare</span></button></td><td><span class="quadPill pLeading">Leading</span></td><td>47</td><td>100.02</td><td>100.00</td><td class="up">+0.0%</td></tr><tr data-testid="terminal-rrg-row-XLF"><td><button type="button" class="rowBtn" title="Load XLF into the linked panels"><span class="rowNum">4</span><span class="symCell">XLF</span><span class="muted"> Financials</span></button></td><td><span class="quadPill pLeading">Leading</span></td><td>47</td><td>100.01</td><td>100.00</td><td class="up">+0.0%</td></tr><tr data-testid="terminal-rrg-row-XLK"><td><button type="button" class="rowBtn" title="Load XLK into the linked panels"><span class="rowNum">5</span><span class="symCell">XLK</span><span class="muted"> Technology</span></button></td><td><span class="quadPill pLeading">Leading</span></td><td>2</td><td>100.00</td><td>100.00</td><td>+0.0%</td></tr></tbody></table></div><p class="muted" data-testid="terminal-rrg-method">Closes through 2026-02-20 (the newest week is still forming until Friday's close). UCT's approximation, not JdK's proprietary formula: RS = 100 × price ÷ SPY; RS-Ratio = 100 × RS ÷ its 10-week average; RS-Momentum = 100 × RS-Ratio ÷ its 5-week average. Tails show the last 8 weeks. Click a row, or type its number, to open its chart beside this graph.</p></div>"`;

exports[`RRG markup > a daily graph with a leader and a laggard renders exactly as before 1`] = `"<div class="wrap" data-testid="terminal-rrg"><p class="lede" data-testid="terminal-rrg-lede">Rotation vs SPY, daily. Nothing is in Leading. </p><div class="chartBox"><svg class="chart" viewBox="0 0 560 380" role="img" aria-label="Relative rotation graph vs SPY, RS-Ratio across and RS-Momentum up, centred on 100. Weakening: SMH. Lagging: IGV."><line class="axis" x1="280.00000000000125" x2="280.00000000000125" y1="17" y2="346"></line><line class="axis" x1="34" x2="543" y1="190.00000000000307" y2="190.00000000000307"></line><text class="quadText" x="526" y="34" text-anchor="end">Leading</text><text class="quadText" x="526" y="340" text-anchor="end">Weakening</text><text class="quadText" x="38" y="340">Lagging</text><text class="quadText" x="38" y="34">Improving</text><text class="axisText" x="280" y="372" text-anchor="middle">RS-Ratio →</text><text class="axisText" x="10" y="190" transform="rotate(-90 10 190)" text-anchor="middle">RS-Momentum →</text><g data-testid="rrg-point-SMH" data-quadrant="Weakening"><polyline class="tailLine qWeakening" points="390.8863464274627,180.28607163341894 392.0443623669717,183.65012986318868 391.81956967092015,187.09188290682002 390.2160798474897,190.5679528138423 387.2526885684615,194.0368539847084 382.9653457730225,197.45667784522806 377.40833962046327,200.78430674879863 370.65072888843633,203.97875151359358"></polyline><circle class="qWeakening" cx="390.8863464274627" cy="180.28607163341894" r="1.6"></circle><circle class="qWeakening" cx="392.0443623669717" cy="183.65012986318868" r="1.6"></circle><circle class="qWeakening" cx="391.81956967092015" cy="187.09188290682002" r="1.6"></circle><circle class="qWeakening" cx="390.2160798474897" cy="190.5679528138423" r="1.6"></circle><circle class="qWeakening" cx="387.2526885684615" cy="194.0368539847084" r="1.6"></circle><circle class="qWeakening" cx="382.9653457730225" cy="197.45667784522806" r="1.6"></circle><circle class="qWeakening" cx="377.40833962046327" cy="200.78430674879863" r="1.6"></circle><circle class="qWeakening" cx="370.65072888843633" cy="203.97875151359358" r="4"></circle><text class="pointLabel" x="376.65072888843633" y="197.97875151359358" text-anchor="start">SMH</text></g><g data-testid="rrg-point-IGV" data-quadrant="Lagging"><polyline class="tailLine qLagging" points="203.0165901179911,189.99987794442572 203.0170904647321,189.9994901460659 203.01770448370118,189.99910186958965 203.01751074469325,189.99953393034158 203.01730413738684,189.99991849532202 203.01775289130853,189.99964379710778 203.01786260852788,189.99970060663807 203.01721874321075,190.0003952540258"></polyline><circle class="qLagging" cx="203.0165901179911" cy="189.99987794442572" r="1.6"></circle><circle class="qLagging" cx="203.0170904647321" cy="189.9994901460659" r="1.6"></circle><circle class="qLagging" cx="203.01770448370118" cy="189.99910186958965" r="1.6"></circle><circle class="qLagging" cx="203.01751074469325" cy="189.99953393034158" r="1.6"></circle><circle class="qLagging" cx="203.01730413738684" cy="189.99991849532202" r="1.6"></circle><circle class="qLagging" cx="203.01775289130853" cy="189.99964379710778" r="1.6"></circle><circle class="qLagging" cx="203.01786260852788" cy="189.99970060663807" r="1.6"></circle><circle class="qLagging" cx="203.01721874321075" cy="190.0003952540258" r="4"></circle><text class="pointLabel" x="209.01721874321075" y="184.0003952540258" text-anchor="start">IGV</text></g></svg></div><div class="tableBox"><table class="table" data-testid="terminal-rrg-table" aria-label="Rotation quadrants vs SPY"><thead><tr><th scope="col">Symbol</th><th scope="col">Quadrant</th><th scope="col">Sessions in it</th><th scope="col">RS-Ratio</th><th scope="col">RS-Momentum</th><th scope="col">vs SPY, last 8 sessions</th></tr></thead><tbody><tr data-testid="terminal-rrg-row-SMH"><td><button type="button" class="rowBtn" title="Load SMH into the linked panels"><span class="rowNum">1</span><span class="symCell">SMH</span></button></td><td><span class="quadPill pWeakening">Weakening</span></td><td>5</td><td>100.21</td><td>99.97</td><td class="up">+0.3%</td></tr><tr data-testid="terminal-rrg-row-IGV"><td><button type="button" class="rowBtn" title="Load IGV into the linked panels"><span class="rowNum">2</span><span class="symCell">IGV</span></button></td><td><span class="quadPill pLagging">Lagging</span></td><td>1</td><td>99.82</td><td>100.00</td><td class="down">-0.3%</td></tr></tbody></table></div><p class="muted" data-testid="terminal-rrg-method">Closes through 2025-04-23. UCT's approximation, not JdK's proprietary formula: RS = 100 × price ÷ SPY; RS-Ratio = 100 × RS ÷ its 10-session average; RS-Momentum = 100 × RS-Ratio ÷ its 5-session average. Tails show the last 8 sessions. Click a row, or type its number, to open its chart beside this graph.</p></div>"`;
