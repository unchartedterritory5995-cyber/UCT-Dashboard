exports[`RRG markup > a crowded weekly graph (moved labels, leader lines) renders exactly as before 1`] = `"<div class="wrap" data-testid="terminal-rrg"><p class="lede" data-testid="terminal-rrg-lede">Rotation vs SPY, weekly. Leading: XLE, XLI, XLV, XLF, XLK. </p><div class="chartBox"><svg class="chart" viewBox="0 0 560 380" role="img" aria-label="Relative rotation graph vs SPY, RS-Ratio across and RS-Momentum up, centred on 100. Leading: XLE, XLI, XLV, XLF, XLK."><line class="axis" x1="280.00000000000125" x2="280.00000000000125" y1="17" y2="346"></line><line class="axis" x1="34" x2="543" y1="190.00000000000307" y2="190.00000000000307"></line><text class="quadText" x="526" y="34" text-anchor="end">Leading</text><text class="quadText" x="526" y="340" text-anchor="end">Weakening</text><text class="quadText" x="38" y="340">Lagging</text><text class="quadText" x="38" y="34">Improving</text><text class="axisText" x="280" y="372" text-anchor="middle">RS-Ratio →</text><text class="axisText" x="10" y="190" transform="rotate(-90 10 190)" text-anchor="middle">RS-Momentum →</text><g data-testid="rrg-point-XLE" data-quadrant="Leading"><polyline class="tailLine qLeading" points="356.3148673051884,156.5237708269499 366.80260201975483,159.81672833961184 375.52068818396316,163.72358717324173 382.29143633873593,168.16410852833255 386.9776146069639,173.04681481860302 389.4829695609747,178.27305033734805 389.75567961030896,183.73729066933413 387.7911453030936,189.32774483237145"></polyline><circle class="qLeading" cx="356.3148673051884" cy="156.5237708269499" r="1.6"></circle><circle class="qLeading" cx="366.80260201975483" cy="159.81672833961184" r="1.6"></circle><circle class="qLeading" cx="375.52068818396316" cy="163.72358717324173" r="1.6"></circle><circle class="qLeading" cx="382.29143633873593" cy="168.16410852833255" r="1.6"></circle><circle class="qLeading" cx="386.9776146069639" cy="173.04681481860302" r="1.6"></circle><circle class="qLeading" cx="389.4829695609747" cy="178.27305033734805" r="1.6"></circle><circle class="qLeading" cx="389.75567961030896" cy="183.73729066933413" r="1.6"></circle><circle class="qLeading" cx="387.7911453030936" cy="189.32774483237145" r="4"></circle><text class="pointLabel" x="393.7911453030936" y="183.32774483237145" text-anchor="start">XLE</text></g><g data-testid="rrg-point-XLI" data-quadrant="Leading"><polyline class="tailLine qLeading" points="291.3978465418679,189.4141434417338 291.62892529379417,189.41410023331835 291.85993772764493,189.41412258914931 292.0909283798468,189.4141602007149 292.3220097230945,189.414109493224 292.5531099758327,189.41405234600882 292.7841329621168,189.414079026162 293.0151770578274,189.41408696998099"></polyline><circle class="qLeading" cx="291.3978465418679" cy="189.4141434417338" r="1.6"></circle><circle class="qLeading" cx="291.62892529379417" cy="189.41410023331835" r="1.6"></circle><circle class="qLeading" cx="291.85993772764493" cy="189.41412258914931" r="1.6"></circle><circle class="qLeading" cx="292.0909283798468" cy="189.4141602007149" r="1.6"></circle><circle class="qLeading" cx="292.3220097230945" cy="189.414109493224" r="1.6"></circle><circle class="qLeading" cx="292.5531099758327" cy="189.41405234600882" r="1.6"></circle><circle class="qLeading" cx="292.7841329621168" cy="189.414079026162" r="1.6"></circle><circle class="qLeading" cx="293.0151770578274" cy="189.41408696998099" r="4"></circle><text class="pointLabel" x="299.0151770578274" y="183.41408696998099" text-anchor="start">XLI</text></g><g data-testid="rrg-point-XLV" data-quadrant="Leading"><polyline class="tailLine qLeading" points="287.5984323516602,189.60940851954203 287.75247958556764,189.60937927082293 287.9064825074835,189.6093937326476 288.0604708066726,189.60941836519328 288.21451946023774,189.60938411658162 288.36858061680414,189.6093455744606 288.5225901633455,189.60936291870152 288.67661367954247,189.6093677716314"></polyline><circle class="qLeading" cx="287.5984323516602" cy="189.6094085195