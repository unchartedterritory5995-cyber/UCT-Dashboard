    "pct_above_100sma":  { "bull": "high", "sides": "both" },
    "pct_above_150sma":  { "bull": "high", "sides": "both" },
    "pct_above_200sma":  { "bull": "high", "sides": "both" },

    "sp500_close":       { "bull": "high", "sides": "both", "basis": "spy_day_pct" },
    "qqq_close":         { "bull": "high", "sides": "both", "basis": "qqq_day_pct" },
    "vix":               { "bull": "low",  "sides": "both", "floors": { "high": 30 } },
    "mcclellan_osc":     { "bull": "high", "sides": "both" },
