//@version=5
indicator("Volume so far today against the usual", overlay=false)
days = input.int(10, "Days in the average", minval=1, maxval=60)
slots = input.int(100, "Bars in a day, at most", minval=1, maxval=500)
newDay = ta.change(dayofmonth) != 0
// one row of `slots` values per finished day, oldest first: that day's volume so far at each bar of the day
var float[] past = array.new_float(0)
var float[] today = array.new_float(0)
var float soFar = 0.0
var int daysBegun = 0
if newDay
    // the bars before the first day change may be a part of a day: they are never stored
    if daysBegun > 0 and array.size(today) > 0
        full = array.last(today)
        for i = 0 to slots - 1
            array.push(past, i < array.size(today) ? array.get(today, i) : full)
        if array.size(past) > days * slots
            for i = 1 to slots
                array.shift(past)
    daysBegun += 1
    array.clear(today)
    soFar := 0.0
soFar += volume
array.push(today, soFar)
slot = array.size(today) - 1
stored = array.size(past) / slots
float usual = na
if daysBegun > 0 and stored == days and slot < slots
    total = 0.0
    for d = 0 to days - 1
        total += array.get(past, d * slots + slot)
    usual := total / days
pct = usual > 0 ? soFar / usual * 100 : na
plot(pct, "Volume so far (% of usual)", color=color.teal, linewidth=2)
plot(100, "Usual", color=color.gray)
