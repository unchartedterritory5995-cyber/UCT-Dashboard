//@version=5
indicator("Loop average")
n = input.int(10, "Bars")
float total = 0.0
for i = 0 to n - 1
    total += close[i]
avg = total / n
var float[] seen = array.new_float(0)
array.push(seen, avg)
if array.size(seen) > 50
    array.shift(seen)
plot(avg, "Average")
plot(array.max(seen), "Max of last 50 averages")
