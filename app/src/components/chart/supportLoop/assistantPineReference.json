 "examples": [
  {
   "id": "table-summary",
   "title": "A summary table in a corner of the chart",
   "shows": "table.new once with var, cells written on the last bar, numbers formatted with str.tostring",
   "source": "//@version=5\nindicator(\"ATR summary table\", overlay=true)\nlen = input.int(14, \"ATR length\", minval=1)\na = ta.atr(len)\nvar table t = table.new(position.top_right, 2, 3, border_width=1)\nif barstate.islast\n    table.cell(t, 0, 0, \"ATR\", text_color=color.white, bgcolor=color.gray)\n    table.cell(t, 1, 0, str.tostring(a, \"#.##\"), text_color=color.white)\n    table.cell(t, 0, 1, \"ATR %\", text_color=color.white, bgcolor=color.gray)\n    table.cell(t, 1, 1, str.tostring(a / close * 100, \"#.##\") + \"%\", text_color=color.white)\n    table.cell(t, 0, 2, \"From 50 SMA\", text_color=color.white, bgcolor=color.gray)\n    table.cell(t, 1, 2, str.tostring((close - ta.sma(close, 50)) / a, \"#.#\") + \" ATR\", text_color=color.white)\n",
   "ok": true,
   "lane": "host",
   "state": "runs",
   "headline": "Runs on the chart; not in alerts, screens or scans"
  },
  {
   "id": "labels-on-events",
   "title": "A text label on each bar where something happens",
   "shows": "label.new inside an if, the text built with str.tostring",
   "source": "//@version=5\nindicator(\"New high labels\", overlay=true)\nn = input.int(20, \"Lookback\")\nisHigh = high >= ta.highest(high, n)\nif isHigh and not isHigh[1]\n    label.new(bar_index, high, \"New \" + str.tostring(n) + \" bar high\", style=label.style_label_down, color=color.green, textcolor=color.white)\n",
   "ok": true,
   "lane": "host",
   "state": "runs",
   "headline": "Runs on the chart; not in alerts, screens or scans"
  },
  {
   "id": "lines-from-levels",
   "title": "Horizontal lines at levels that change over time",
   "shows": "var handles, line.delete before line.new, values carried with var float and :=",
   "source": "//@version=5\nindicator(\"Prior day levels\", overlay=true)\nvar line hi = na\nvar line lo = na\nnewDay = ta.change(time(\"D\")) != 0\nvar float ph = na\nvar float pl = na\nvar float dh = na\nvar float dl = na\nif newDay\n    ph := dh\n    pl := dl\n    dh := high\n    dl := low\n    line.delete(hi)\n    line.delete(lo)\n    hi := line.new(bar_index, ph, bar_index + 1, ph, extend=extend.right, color=color.red)\n    lo := line.new(bar_index, pl, bar_index + 1, pl, extend=extend.right, color=color.green)\nelse\n    dh := math.max(dh, high)\n    dl := math.min(dl, low)\n",
   "ok": true,
   "lane": "host",
   "state": "runs",
   "headline": "Runs on the chart; not in alerts, screens or scans"
  },
  {
   "id": "box-over-a-range",
   "title": "A shaded box over a range of bars",
   "shows": "one box kept in a var, deleted and redrawn on the last bar",
   "source": "//@version=5\nindicator(\"Range box\", overlay=true)\nn = input.int(20, \"Bars\")\nvar box b = na\nif barstate.islast\n    box.delete(b)\n    b := box.new(bar_index - n, ta.highest(high, n), bar_index, ta.lowest(low, n), bgcolor=color.new(color.blue, 85), border_color=color.blue)\n",
   "ok": true,
   "lane": "host",
   "state": "runs",
   "headline": "Runs on the chart; not in alerts, screens or scans"
  },
  {
   "id": "plots-colours-markers",
   "title": "Lines, a fill between them, markers, background and bar colours",
   "shows": "plot, fill, plotshape, bgcolor and barcolor with a colour chosen per bar",
   "source": "//@version=5\nindicator(\"EMA ribbon\", overlay=true)\nfast = input.int(10, \"Fast\")\nslow = input.int(21, \"Slow\")\ne1 = ta.ema(close, fast)\ne2 = ta.ema(close, slow)\np1 = plot(e1, \"Fast\", color=color.green, linewidth=2)\np2 = plot(e2, \"Slow\", color=color.red, linewidth=2)\nfill(p1, p2, color=e1 > e2 ? color.new(color.green, 80) : color.new(color.red, 80))\nplotshape(ta.crossover(e1, e2), \"Cross up\", shape.triangleup, location.belowbar, color.green)\nbgcolor(e1 > e2 and e1 > e1[1] ? color.new(color.green, 92) : na)\nbarcolor(close > e1 ? color.green : color.red)\n",
   "ok": true,
   "lane": "host",
   "state": "runs",
   "headline": "Runs fully"
  },
  {
   "id": "loops-and-arrays",
   "title": "A calculation that needs a loop and a list",
   "shows": "a for loop with +=, an array kept with var, array.push / array.shift / array.max",
   "source": "//@version=5\nindicator(\"Loop average\")\nn = input.int(10, \"Bars\")\nfloat total = 0.0\nfor i = 0 to n - 1\n    total += close[i]\navg = total / n\nvar float[] seen = array.new_float(0)\narray.push(seen, avg)\nif array.size(seen) > 50\n    array.shift(seen)\nplot(avg, \"Average\")\nplot(array.max(seen), \"Max of last 50 averages\")\n",
   "ok": true,
   "lane": "runtime",
   "state": "runs-with-notes",
   "headline": "Runs on the chart, with 1 note"
  },
  {
   "id": "pivots-with-labels",
   "title": "Swing highs marked where they happened",
   "shows": "ta.pivothigh is known `right` bars late, so the label is placed at bar_index - right",
   "source": "//@version=5\nindicator(\"Pivot highs\", overlay=true)\nleft = input.int(5, \"Left\")\nright = input.int(5, \"Right\")\nph = ta.pivothigh(high, left, right)\nif not na(ph)\n    label.new(bar_index - right, ph, str.tostring(ph, \"#.##\"), style=label.style_label_down, color=color.orange)\nplot(ta.valuewhen(not na(ph), ph, 0), \"Last pivot high\", color=color.orange, style=plot.style_stepline)\n",
   "ok": true,
   "lane": "host",
   "state": "runs",
   "headline": "Runs on the chart and in alerts; screens and scans need a threshold"
  },
  {
   "id": "higher-timeframe",
   "title": "A weekly value on a daily chart",
   "shows": "request.security on the chart's own symbol with the weekly timeframe",
   "source": "//@version=5\nindicator(\"Weekly 10 SMA\", overlay=true)\nw = request.security(syminfo.tickerid, \"W\", ta.sma(close, 10))\nplot(w, \"Weekly 10 SMA\", color=color.purple)\n",
   "ok": true,
   "lane": "host",
   "state": "runs",
   "headline": "Runs on the chart; not in alerts; screens and scans need a threshold"
  },
  {
   "id": "another-symbol",
   "title": "This stock against a benchmark",
   "shows": "request.security on a benchmark symbol at the chart's own timeframe",
   "source": "//@version=5\nindicator(\"RS vs SPY\")\ns = request.security(\"SPY\", timeframe.period, close)\nrs = close / s\nplot(rs, \"RS line\")\nplot(ta.ema(rs, 21), \"RS 21 EMA\", color=color.orange)\n",
   "ok": true,
   "lane": "host",
   "state": "runs",
   "headline": "Runs on the chart and in alerts; screens and scans need a threshold"
  },
  {
   "id": "levels-from-a-list",
   "title": "Several levels drawn from a list, with a label on each",
   "shows": "array.from, for ... in, each level's price kept in an array, lines and labels rebuilt from it on the last bar (kept in arrays, deleted before they are made again), and one value from that array PLOTTED so the run owns the drawings",
   "source": "//@version=5\nindicator(\"Fib levels\", overlay=true)\nn = input.int(100, \"Lookback\")\nhh = ta.highest(high, n)\nll = ta.lowest(low, n)\nlevels = array.from(0.0, 0.236, 0.382, 0.5, 0.618, 0.786, 1.0)\nprices = array.new_float(0)\nfor lv in levels\n    array.push(prices, hh - (hh - ll) * lv)\nvar line[] ls = array.new_line(0)\nvar label[] lbs = array.new_label(0)\nif barstate.islast\n    while array.size(ls) > 0\n        oldLine = array.pop(ls)\n        line.delete(oldLine)\n    while array.size(lbs) > 0\n        oldLabel = array.pop(lbs)\n        label.delete(oldLabel)\n    for i = 0 to array.size(prices) - 1\n        y = array.get(prices, i)\n        array.push(ls, line.new(bar_index - n, y, bar_index, y, extend=extend.right, color=color.gray))\n        array.push(lbs, label.new(bar_index, y, str.tostring(array.get(levels, i) * 100, \"#.#\") + \"%\", style=label.style_label_left, color=color.gray, textcolor=color.white))\nplot(array.get(prices, 3), \"50% level\", color=color.gray)\n",
   "ok": true,
   "lane": "runtime",
   "state": "runs-with-notes",
   "headline": "Runs on the chart, with 3 notes"
  },
  {
   "id": "heikin-ashi-candles",
