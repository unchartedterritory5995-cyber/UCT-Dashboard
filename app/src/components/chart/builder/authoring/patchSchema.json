{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uct.authoring.patch/1",
  "title": "UCT conversational authoring patch",
  "description": "The model's whole answer for ONE conversational turn: a structured patch against the current canonical definition. The engine (builder/authoring/applyPatch.js) re-validates EVERYTHING deterministically and applies atomically; this schema is a structural pre-check only. See scratchpad P2-DESIGN.md. Prose fields (note, reply, *.text) never reach the definition.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "baseRevision", "ops"],
  "properties": {
    "contract": { "const": "uct.authoring.patch/1" },
    "baseRevision": { "type": "integer", "minimum": 0 },
    "ops": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/patchOp" } },
    "assumptions": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/assumption" } },
    "questions": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/question" } },
    "note": { "type": "string", "maxLength": 600 },
    "disposition": {
      "description": "SLICE 2 — what this turn IS. change: ops apply (no questions). clarify: questions, ops []. answer: a reply about the indicator, ops [], nothing changes. unsupported: a reply naming the limit, ops [], nothing changes. The server REQUIRES it of the model; the engine applies ops only for change.",
      "enum": ["change", "answer", "clarify", "unsupported"]
    },
    "reply": {
      "description": "SLICE 2 — the assistant's words to the member (an answer, a limit, or a one-line summary of a change). Prose: never applied, never a definition, never the read-back.",
      "type": "string", "maxLength": 1200
    }
  },
  "x-uct-limits": { "maxOps": 12, "maxOutputs": 8, "maxAssumptions": 12, "maxQuestions": 3, "maxTextLength": 300, "maxLevels": 8 },
  "$defs": {
    "node": {
      "description": "THE EXISTING CANONICAL AST NODE. Placeholder: the server substitutes definition_concierge.tool_schema()['input_schema']['$defs'] (the advertised emit_formula union: num, series, op, call, offset over the closed table) plus PHASE 5's three scope wrappers (sym, tf, tf_live; bounds in crossContext.json). The engine accepts only canonical trees of those node types and proves each by print/parse round trip.",
      "x-uct-node-schema": "concierge.advertised",
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "enum": ["num", "series", "op", "call", "offset", "sym", "tf", "tf_live"] } }
    },
    "outputKey": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$", "maxLength": 40 },
    "slotId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*#(root|(\\d+|n)(\\.(\\d+|n))*)$", "maxLength": 120 },
    "label": { "type": "string", "minLength": 1, "maxLength": 60 },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "colour": { "type": "string", "pattern": "^(#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?|rgba?\\(\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*(,\\s*(0|1|0?\\.\\d+)\\s*)?\\))$" },
    "barField": { "enum": ["open", "high", "low", "close", "volume"] },
    "ticker": { "type": "string", "pattern": "^[A-Z]{1,5}(\\.[A-Z])?$" },
    "scopeTimeframe": { "enum": ["W", "M"] },
    "assumption": {
      "type": "object", "additionalProperties": false, "required": ["text"],
      "properties": {
        "slot": { "$ref": "#/$defs/slotId" },
        "output": { "$ref": "#/$defs/outputKey" },
        "text": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "question": {
      "type": "object", "additionalProperties": false, "required": ["id", "text"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,24}$" },
        "text": { "type": "string", "minLength": 1, "maxLength": 300 },
        "choices": { "type": "array", "maxItems": 6, "items": { "type": "string", "minLength": 1, "maxLength": 80 } }
      }
    },
    "createOutput": {
      "type": "object", "additionalProperties": false, "required": ["tree"],
      "properties": {
        "key": { "$ref": "#/$defs/outputKey" },
        "label": { "$ref": "#/$defs/label" },
        "tree": { "$ref": "#/$defs/node" },
        "hidden": { "type": "boolean" }
      }
    },
    "patchOp": {
      "oneOf": [
        { "$ref": "#/$defs/op_create" }, { "$ref": "#/$defs/op_rename_definition" },
        { "$ref": "#/$defs/op_add_output" }, { "$ref": "#/$defs/op_remove_output" },
        { "$ref": "#/$defs/op_rename_output" }, { "$ref": "#/$defs/op_set_output_tree" },
        { "$ref": "#/$defs/op_set_slot" }, { "$ref": "#/$defs/op_add_clause" },
        { "$ref": "#/$defs/op_remove_clause" }, { "$ref": "#/$defs/op_set_intent" },
        { "$ref": "#/$defs/op_set_placement" }, { "$ref": "#/$defs/op_set_style" },
        { "$ref": "#/$defs/op_set_marker" }, { "$ref": "#/$defs/op_remove_marker" },
        { "$ref": "#/$defs/op_set_paint" }, { "$ref": "#/$defs/op_remove_paint" },
        { "$ref": "#/$defs/op_request_info_value" }, { "$ref": "#/$defs/op_request_alert" },
        { "$ref": "#/$defs/op_cancel_request" },
        { "$ref": "#/$defs/op_set_levels" }, { "$ref": "#/$defs/op_set_fill" },
        { "$ref": "#/$defs/op_remove_fill" },
        { "$ref": "#/$defs/op_set_color_rule" }, { "$ref": "#/$defs/op_set_calculation_timeframe" },
        { "$ref": "#/$defs/op_set_table" }, { "$ref": "#/$defs/op_remove_table" },
        { "$ref": "#/$defs/op_set_input" }, { "$ref": "#/$defs/op_remove_input" },
        { "$ref": "#/$defs/op_set_color_states" }
      ]
    },
    "op_create": {
      "type": "object", "additionalProperties": false, "required": ["op", "name", "outputs"],
      "properties": {
        "op": { "const": "create" },
        "name": { "$ref": "#/$defs/name" },
        "outputs": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/createOutput" } },
        "placement": { "enum": ["pane", "price"] },
        "primary": { "$ref": "#/$defs/outputKey" },
        "inputs": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/memberInput" } }
      }
    },
    "memberInput": {
      "description": "OVERNIGHT E — a number the MEMBER sets in the indicator's settings (account size, risk %, entry, stop). A tree reads it as a series named by its key. Never invent a member's own figure: default 0 and say they set it.",
      "type": "object", "additionalProperties": false, "required": ["key", "label", "default"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,23}$" },
        "label": { "$ref": "#/$defs/label" },
        "default": { "type": "number" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "minimum": 0 }
      }
    },
    "op_rename_definition": {
      "type": "object", "additionalProperties": false, "required": ["op", "name"],
      "properties": { "op": { "const": "rename_definition" }, "name": { "$ref": "#/$defs/name" } }
    },
    "op_add_output": {
      "type": "object", "additionalProperties": false, "required": ["op", "key", "tree"],
      "properties": {
        "op": { "const": "add_output" }, "key": { "$ref": "#/$defs/outputKey" },
        "tree": { "$ref": "#/$defs/node" }, "label": { "$ref": "#/$defs/label" }, "hidden": { "type": "boolean" }
      }
    },
    "op_remove_output": {
      "type": "object", "additionalProperties": false, "required": ["op", "output"],
      "properties": { "op": { "const": "remove_output" }, "output": { "$ref": "#/$defs/outputKey" } }
    },
    "op_rename_output": {
      "type": "object", "additionalProperties": false, "required": ["op", "output", "label"],
      "properties": { "op": { "const": "rename_output" }, "output": { "$ref": "#/$defs/outputKey" }, "label": { "$ref": "#/$defs/label" } }
    },
    "op_set_output_tree": {
      "type": "object", "additionalProperties": false, "required": ["op", "output", "tree"],
      "properties": { "op": { "const": "set_output_tree" }, "output": { "$ref": "#/$defs/outputKey" }, "tree": { "$ref": "#/$defs/node" } }
    },
    "op_set_slot": {
      "description": "Set ONE parameter slot from the view: a number (value), a price field (series), PHASE 5 the symbol a sym node reads (symbol), or the period a tf / tf_live node reads (timeframe).",
      "type": "object", "additionalProperties": false, "required": ["op", "slot"],
      "properties": {
        "op": { "const": "set_slot" }, "slot": { "$ref": "#/$defs/slotId" },
        "value": { "type": "number", "minimum": 0 },
        "series": { "$ref": "#/$defs/barField" },
        "symbol": { "$ref": "#/$defs/ticker" },
        "timeframe": { "$ref": "#/$defs/scopeTimeframe" }
      },
      "oneOf": [ { "required": ["value"] }, { "required": ["series"] }, { "required": ["symbol"] }, { "required": ["timeframe"] } ]
    },
    "op_add_clause": {
      "type": "object", "additionalProperties": false, "required": ["op", "output", "join", "tree"],
      "properties": {
        "op": { "const": "add_clause" }, "output": { "$ref": "#/$defs/outputKey" },
        "join": { "enum": ["and", "or"] }, "tree": { "$ref": "#/$defs/node" }
      }
    },
    "op_remove_clause": {
      "type": "object", "additionalProperties": false, "required": ["op", "clause"],
      "properties": { "op": { "const": "remove_clause" }, "clause": { "$ref": "#/$defs/slotId" } }
    },
    "op_set_intent": {
      "type": "object", "additionalProperties": false, "required": ["op", "intent"],
      "properties": {
        "op": { "const": "set_intent" }, "intent": { "enum": ["plot", "signal", "value"] },
        "output": { "$ref": "#/$defs/outputKey" }
      }
    },
    "op_set_placement": {
      "type": "object", "additionalProperties": false, "required": ["op", "target"],
      "properties": { "op": { "const": "set_placement" }, "target": { "enum": ["pane", "price"] } }
    },
    "op_set_style": {
      "type": "object", "additionalProperties": false, "required": ["op", "output"],
      "minProperties": 3,
      "properties": {
        "op": { "const": "set_style" }, "output": { "$ref": "#/$defs/outputKey" },
        "color": { "$ref": "#/$defs/colour" },
        "width": { "type": "integer", "minimum": 1, "maximum": 4 },
        "style": { "enum": ["line", "stepline", "histogram", "area", "baseline"] },
        "lineStyle": { "enum": ["solid", "dashed", "dotted", "largeDashed"] },
        "hidden": { "type": "boolean" }
      }
    },
    "op_set_marker": {
      "type": "object", "additionalProperties": false, "required": ["op", "output", "shape"],
      "properties": {
        "op": { "const": "set_marker" }, "output": { "$ref": "#/$defs/outputKey" },
        "shape": { "enum": ["circle", "square", "arrowUp", "arrowDown"] },
        "position": { "enum": ["aboveBar", "belowBar", "inBar"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 24 },
        "size": { "description": "BATCH 2 — the marker's size, 0.25 (tiny) to 4 (large); 1 is the chart's normal size.", "type": "number", "minimum": 0.25, "maximum": 4 },
        "color": { "description": "BATCH 2 — the marker's colour (the output's own colour).", "$ref": "#/$defs/colour" }
      }
    },
    "op_remove_marker": {
      "type": "object", "additionalProperties": false, "required": ["op", "output"],
      "properties": { "op": { "const": "remove_marker" }, "output": { "$ref": "#/$defs/outputKey" } }
    },
    "op_set_paint": {
      "type": "object", "additionalProperties": false, "required": ["op", "output", "channel", "color"],
      "properties": {
        "op": { "const": "set_paint" }, "output": { "$ref": "#/$defs/outputKey" },
        "channel": { "enum": ["barcolor", "bgcolor"] }, "color": { "$ref": "#/$defs/colour" }
      }
    },
    "op_remove_paint": {
      "type": "object", "additionalProperties": false, "required": ["op", "output", "channel"],
      "properties": {
        "op": { "const": "remove_paint" }, "output": { "$ref": "#/$defs/outputKey" },
        "channel": { "enum": ["barcolor", "bgcolor"] }
      }
    },
    "op_request_info_value": {
      "type": "object", "additionalProperties": false, "required": ["op", "output", "format"],
      "properties": {
        "op": { "const": "request_info_value" }, "output": { "$ref": "#/$defs/outputKey" },
        "format": { "enum": ["auto", "yesno"] }
      }
    },
    "op_request_alert": {
      "description": "An alert on one output. A yes/no output: triggerPolicy. PHASE 5 — a NUMBER output: condition (above / below = the closed bar's value is above / below threshold; cross_above / cross_below = it crossed threshold since the bar before) with threshold. An unknown bar never fires and never re-arms.",
      "type": "object", "additionalProperties": false, "required": ["op", "output"],
      "properties": {
        "op": { "const": "request_alert" }, "output": { "$ref": "#/$defs/outputKey" },
        "triggerPolicy": { "enum": ["is_true", "becomes_true", "becomes_false"] },
        "condition": { "enum": ["above", "below", "cross_above", "cross_below"] },
        "threshold": { "type": "number" }
      },
      "oneOf": [ { "required": ["triggerPolicy"] }, { "required": ["condition", "threshold"] } ]
    },
    "op_cancel_request": {
      "type": "object", "additionalProperties": false, "required": ["op", "kind", "output"],
      "properties": {
        "op": { "const": "cancel_request" }, "kind": { "enum": ["alert", "info_value"] },
        "output": { "$ref": "#/$defs/outputKey" }
      }
    },
    "op_set_levels": {
      "description": "P3 — the definition's horizontal reference lines: the Builder's Levels box (ONE hlines guide). values replaces the whole list, in order; [] removes the guide.",
      "type": "object", "additionalProperties": false, "required": ["op", "values"],
      "properties": {
        "op": { "const": "set_levels" },
        "values": { "type": "array", "maxItems": 8, "items": { "type": "number" } }
      }
    },
    "op_set_fill": {
      "description": "P3 — shade the area between two SERIES outputs (plots[output].fill.with). color / opacity are the band's own; omitted, the band is drawn in the output's colour at a low alpha. PHASE 5 — a CONDITIONAL cloud: colorAbove where `output` is above `with` and colorBelow where it is below (both together); with `when` (a yes/no output), colorAbove where it is true and colorBelow where false. An unknown bar is left unshaded.",
      "type": "object", "additionalProperties": false, "required": ["op", "output", "with"],
      "properties": {
        "op": { "const": "set_fill" }, "output": { "$ref": "#/$defs/outputKey" },
        "with": { "$ref": "#/$defs/outputKey" },
        "color": { "$ref": "#/$defs/colour" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "colorAbove": { "$ref": "#/$defs/colour" },
        "colorBelow": { "$ref": "#/$defs/colour" },
        "when": { "$ref": "#/$defs/outputKey" }
      }
    },
    "op_remove_fill": {
      "type": "object", "additionalProperties": false, "required": ["op", "output"],
      "properties": { "op": { "const": "remove_fill" }, "output": { "$ref": "#/$defs/outputKey" } }
    },
    "colorState": {
      "description": "BATCH 2 — one colour state: the colour, and EITHER `when` (a yes/no formula tree) OR `relation` (a test of the coloured output itself, which follows that output's maths when it is edited).",
      "type": "object", "additionalProperties": false, "required": ["color"],
      "properties": {
        "color": { "$ref": "#/$defs/colour" },
        "when": { "$ref": "#/$defs/node" },
        "relation": { "enum": ["positive", "negative", "rising", "falling", "positive_rising", "positive_falling", "negative_rising", "negative_falling"] }
      },
      "oneOf": [ { "required": ["when"] }, { "required": ["relation"] } ]
    },
    "op_set_color_states": {
      "description": "BATCH 2 — up to FOUR condition-driven colours (counting `otherwise`). Target ONE output's line or histogram (`output`), or the chart's candles / background (`channel`: barcolor / bgcolor; `when` trees only). States are tested in order and the FIRST true one colours the bar; `otherwise` colours bars where none is true (omit it to leave those bars in the output's own colour, normal candles, or no shading). Needs two colours at least (two states, or one state + otherwise). states [] removes them. A bar whose test is unknown takes no state colour. Re-send the WHOLE list to change one state.",
      "type": "object", "additionalProperties": false, "required": ["op", "states"],
      "properties": {
        "op": { "const": "set_color_states" },
        "output": { "$ref": "#/$defs/outputKey" },
        "channel": { "enum": ["barcolor", "bgcolor"] },
        "states": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/colorState" } },
        "otherwise": { "$ref": "#/$defs/colour" }
      },
      "oneOf": [ { "required": ["output"] }, { "required": ["channel"] } ]
    },
    "op_set_color_rule": {
      "description": "PHASE 5 — per-bar colour of ONE output's line or histogram. sign: up at or above zero, down below. rising: up when higher than the bar before, down otherwise. condition: up where the yes/no output `when` is true, down where false. none: back to one colour (up/down omitted). An unknown bar takes no rule colour.",
      "type": "object", "additionalProperties": false, "required": ["op", "output", "rule"],
      "properties": {
        "op": { "const": "set_color_rule" }, "output": { "$ref": "#/$defs/outputKey" },
        "rule": { "enum": ["sign", "rising", "condition", "none"] },
        "up": { "$ref": "#/$defs/colour" },
        "down": { "$ref": "#/$defs/colour" },
        "when": { "$ref": "#/$defs/outputKey" }
      }
    },
    "tableCell": {
      "type": "object", "additionalProperties": false, "required": ["row", "col"],
      "properties": {
        "row": { "type": "integer", "minimum": 0, "maximum": 11 },
        "col": { "type": "integer", "minimum": 0, "maximum": 5 },
        "text": { "type": "string", "minLength": 1, "maxLength": 40 },
        "output": { "$ref": "#/$defs/outputKey" },
        "format": { "enum": ["auto", "integer", "decimal1", "decimal2", "decimal3"] },
        "prefix": { "type": "string", "maxLength": 6 },
        "suffix": { "type": "string", "maxLength": 6 },
        "color": { "$ref": "#/$defs/colour" },
        "background": { "$ref": "#/$defs/colour" },
        "bold": { "type": "boolean" },
        "colorWhen": { "$ref": "#/$defs/cellCondition" },
        "backgroundWhen": { "$ref": "#/$defs/cellCondition" },
        "labels": { "description": "BATCH 2 — the words a yes/no output's cell shows (default Yes / No), e.g. Bullish / Bearish.", "type": "object", "additionalProperties": false, "required": ["true", "false"],
          "properties": { "true": { "type": "string", "minLength": 1, "maxLength": 16 }, "false": { "type": "string", "minLength": 1, "maxLength": 16 } } },
        "size": { "description": "BATCH 2 — text size.", "enum": ["tiny", "small", "normal", "large", "huge"] },
        "span": { "description": "BATCH 2 — merge this cell with the cells to its right, this many columns wide in total (a title across the top).", "type": "integer", "minimum": 2, "maximum": 6 }
      },
      "oneOf": [ { "required": ["text"] }, { "required": ["output"] } ]
    },
    "cellCondition": {
      "description": "BATCH 2 — a colour that follows a yes/no output of this indicator: `true` where it is true, `false` where false. Where it is unknown the cell keeps its plain colour (`color` / `background`, or the theme's).",
      "type": "object", "additionalProperties": false, "required": ["output", "true", "false"],
      "properties": { "output": { "$ref": "#/$defs/outputKey" }, "true": { "$ref": "#/$defs/colour" }, "false": { "$ref": "#/$defs/colour" } }
    },
    "op_set_table": {
      "description": "OVERNIGHT D — a table drawn ON the chart at one of nine positions (the existing chart-table renderer). cells REPLACES the whole table: each cell is fixed text, or the LATEST value of an output of this indicator (a number output with an optional format / prefix / suffix; a yes/no output shows Yes or No, or its own `labels`). An unknown value shows as a dash. BATCH 2: a cell's text or background colour may follow a yes/no output (`colorWhen` / `backgroundWhen` — e.g. green where bullish, red where not), `size` sets its text size, and `span` merges it across columns (a title over the table). Use hidden outputs for values or tests that should appear only in the table.",
      "type": "object", "additionalProperties": false, "required": ["op", "cells"],
      "properties": {
        "op": { "const": "set_table" },
        "position": { "enum": ["top_left", "top_center", "top_right", "middle_left", "middle_center", "middle_right", "bottom_left", "bottom_center", "bottom_right"] },
        "cells": { "type": "array", "minItems": 1, "maxItems": 48, "items": { "$ref": "#/$defs/tableCell" } }
      }
    },
    "op_set_input": {
      "description": "OVERNIGHT E — add a member-settable number input, or change an existing one's label / default / range.",
      "type": "object", "additionalProperties": false, "required": ["op", "input"],
      "properties": { "op": { "const": "set_input" }, "input": { "$ref": "#/$defs/memberInput" } }
    },
    "op_remove_input": {
      "description": "OVERNIGHT E — remove a member input no formula reads any more.",
      "type": "object", "additionalProperties": false, "required": ["op", "key"],
      "properties": { "op": { "const": "remove_input" }, "key": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,23}$" } }
    },
    "op_remove_table": {
      "description": "OVERNIGHT D — remove this indicator's chart table (its outputs stay).",
      "type": "object", "additionalProperties": false, "required": ["op"],
      "properties": { "op": { "const": "remove_table" } }
    },
    "op_set_calculation_timeframe": {
      "description": "PHASE 5 — run the WHOLE indicator on another timeframe than the chart's (its instance's calculation timeframe), applied when it is saved to the chart; a HIGHER timeframe only. chart = the chart's own timeframe.",
      "type": "object", "additionalProperties": false, "required": ["op", "timeframe"],
      "properties": {
        "op": { "const": "set_calculation_timeframe" },
        "timeframe": { "enum": ["chart", "5", "15", "30", "60", "D", "W", "M"] }
      }
    }
  }
}
