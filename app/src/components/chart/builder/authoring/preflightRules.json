  "questionShape": {
    "description": "P3 - ONE deterministic question/advisory detector, shared by the pre-flight (a QUESTION is never intercepted) and the server's /converse routing (a question may name things UCT cannot build: the model may DISCUSS them). Per clause (split at sentence punctuation), after a discourse prefix: an AUTHORING request anywhere (an imperative edit verb, a polite 'can you add', 'I want', 'let's') makes the whole message authoring; otherwise a trailing '?' or an interrogative / advisory opener makes it a question. 'compare' as an opener is ADVISORY (the server's routing) but not a QUESTION (the pre-flight still refuses 'compare AAPL to SPY').",
    "clauseSplit": "(?<=[.!?;])\\s+|\\n+",
    "discourse": "^\\s*(?:(?:ok(?:ay)?|so|and|but|also|then|hey|hi|well|now|hmm+|um+|right|great|thanks|cool|quick question|question|just curious|curious|one more thing)\\b[\\s,:;.!-]*)*",
    "trailingQuestion": "\\?[\\s\"'’”)\\]]*$",
    "interrogativeLead": "^(?:what(?:'s|’s|s)?|which|why|how(?:'s|’s)?|when|where|who|whose|should|shouldn't|would|wouldn't|could|couldn't|can|can't|cannot|is|isn't|are|aren't|was|were|does|doesn't|did|didn't|will|won't|shall|may|might|am|do\\s+(?:i|you|we|they|it|these|those|people|traders))\\b",
    "advisoryLead": "^(?:explain|tell\\s+me|describe|recommend|suggest|advise|help\\s+me\\s+(?:understand|decide|choose|pick)|walk\\s+me\\s+through|i(?:'m|’m|\\s+am)\\s+(?:wondering|curious)|i\\s+wonder|i\\s+(?:want|need)\\s+to\\s+(?:know|understand|learn)|i(?:'d|’d|\\s+would)\\s+like\\s+to\\s+(?:know|understand|learn)|any\\s+(?:idea|ideas|thoughts|suggestions?|advice|tips?)|thoughts\\s+on|what\\s+about)\\b",
    "compareLead": "^(?:compare|contrast)\\b",
    "requestLead": "^(?:please\\s+)?(?:(?:(?:can|could|would|will)\\s+(?:you|u)\\s+(?:please\\s+)?)|(?:(?:i(?:'d|’d|\\s+would)\\s+like|i\\s+want|i\\s+need)(?:\\s+you)?\\s+to\\s+)|(?:let(?:'s|’s|\\s+us)\\s+)|(?:go\\s+ahead\\s+and\\s+))?(?:add|make|create|build|plot|draw|show|display|set|change|use|put|paint|colou?r|mark|alert|remove|delete|drop|replace|switch|turn|give|apply|insert|overlay|highlight|fill|shade|swap|increase|decrease|raise|lower|bump|rename|move|place|hide|convert|try|write|edit|update|modify|adjust|tweak|double|halve|combine|smooth|speed|slow|go\\s+with|how\\s+about)\\b",
    "wantLead": "^(?:please\\s+)?(?:i(?:'d|’d|\\s+would)\\s+like|i\\s+want|i\\s+need|give\\s+me)\\b"
  }
}
