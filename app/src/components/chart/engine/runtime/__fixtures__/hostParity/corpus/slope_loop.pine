//@version=5
indicator("hp slope", overlay=false)
len = 30
float sx = 0.0
float sy = 0.0
float sxy = 0.0
float sxx = 0.0
for i = 0 to len - 1
    x = float(i)
    y = close[i]
    sx += x
    sy += y
    sxy += x * y
    sxx += x * x
slope = (len * sxy - sx * sy) / (len * sxx - sx * sx)
plot(slope, "slope")
plot(ta.correlation(close, volume, 30), "corr")
