//@version=5
indicator("get_y2 minus a number", overlay=true)
var line ln = na
var label lb = na
if barstate.islast
    line.delete(ln)
    label.delete(lb)
    ln := line.new(bar_index - 5, low[5], bar_index, close)
    lb := label.new(bar_index, close, str.tostring(line.get_y2(ln) - 1.0, "#.00"))
