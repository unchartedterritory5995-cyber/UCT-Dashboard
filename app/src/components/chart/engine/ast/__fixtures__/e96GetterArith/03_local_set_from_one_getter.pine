//@version=5
indicator("getter into a local", overlay=true)
var line ln = na
var label lb = na
if barstate.islast
    line.delete(ln)
    label.delete(lb)
    ln := line.new(bar_index - 5, low[5], bar_index, close)
    float y = line.get_y2(ln)
    lb := label.new(bar_index, close, str.tostring(y, "#.00"))
