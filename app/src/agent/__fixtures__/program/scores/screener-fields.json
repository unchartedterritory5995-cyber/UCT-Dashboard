  },
  {
   "key": "min_volume_3d_prior",
   "label": "Min Volume (3d, prior)",
   "type": "range",
   "unit": null,
   "category": "technical",
   "description": "The lowest daily volume of the three sessions before the last one (TC2000's MINV3.1). The last session is left out, so one heavy day cannot lift it. Blank if any of the three has no volume. Measured at the last completed session."
  },
  {
   "key": "vol_trend_pct",
   "label": "Volume Trend (5d vs 20d)",
   "type": "range",
   "unit": "%",
   "category": "technical",
   "description": "Percent the 5-session average volume stands above (+) or below (-) the 20-session average, both ending at the last session. Blank if any of those sessions has no volume or the 20-session average is zero. Measured at the last completed session."
  },
  {
   "key": "vol_up_run",
   "label": "Rising-Volume Run",
   "type": "range",
   "unit": null,
   "category": "technical",
   "description": "Consecutive sessions, ending at the last one, each on more volume than the session before. 0 when the last session did not rise. A session with no volume ends the run. Measured at the last completed session."
  },
  {
   "key": "vol_down_run",
   "label": "Falling-Volume Run",
   "type": "range",
   "unit": null,
   "category": "technical",
   "description": "Consecutive sessions, ending at the last one, each on less volume than the session before. 0 when the last session did not fall. A session with no volume ends the run. Measured at the last completed session."
  },
  {
   "key": "new_high_lookback",
   "label": "Close Above Prior Highs",
   "type": "range",
   "unit": null,
   "category": "technical",
   "description": "How many consecutive prior sessions have a high below the last close, up to 252. At least N is a close above the N-session high, the last session excluded, so 20 is a 20-day breakout. A close that only equals a prior high does not count. A short history can only count the sessions it holds. Measured at the last completed session."
  },
  {
   "key": "new_low_lookback",
   "label": "Close Below Prior Lows",
   "type": "range",
   "unit": null,
   "category": "technical",
   "description": "How many consecutive prior sessions have a low above the last close, up to 252. At least N is a close below the N-session low, the last session excluded. Measured at the last completed session."
  },
  {
