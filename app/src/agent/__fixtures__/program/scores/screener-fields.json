  },
  {
   "key": "run_close_ema20",
   "label": "Sessions vs EMA20",
   "type": "range",
   "unit": null,
   "category": "technical",
   "description": "The close against its 20-day EMA. Positive counts consecutive sessions above, negative consecutive sessions below, and 0 means level on the last session. +1 is the session it crossed up, -1 the session it crossed down, so a cross within N sessions that still holds is 1 to N (or -1 to -N). A cross that has since reversed no longer counts. Counted over the 400 stored sessions at most. Blank until both sides exist. Measured at the last completed session."
  },
  {
   "key": "run_close_sma50",
   "label": "Sessions vs SMA50",
   "type": "range",
   "unit": null,
   "category": "technical",
   "description": "The close against its 50-day SMA. Positive counts consecutive sessions above, negative consecutive sessions below, and 0 means level on the last session. +1 is the session it crossed up, -1 the session it crossed down, so a cross within N sessions that still holds is 1 to N (or -1 to -N). A cross that has since reversed no longer counts. Counted over the 400 stored sessions at most. Blank until both sides exist. Measured at the last completed session."
  },
  {
   "key": "run_close_sma200",
   "label": "Sessions vs SMA200",
   "type": "range",
   "unit": null,
   "category": "technical",
   "description": "The close against its 200-day SMA. Positive counts consecutive sessions above, negative consecutive sessions below, and 0 means level on the last session. +1 is the session it crossed up, -1 the session it crossed down, so a cross within N sessions that still holds is 1 to N (or -1 to -N). A cross that has since reversed no longer counts. Counted over the 400 stored sessions at most. Blank until both sides exist. Measured at the last completed session."
  },
  {
   "key": "run_ema9_ema20",
   "label": "EMA9 vs EMA20 Run",
   "type": "range",
   "unit": null,
   "category": "technical",
   "description": "The 9-day EMA against the 20-day EMA. Positive counts consecutive sessions above, negative consecutive sessions below, and 0 means level on the last session. +1 is the session it crossed up, -1 the session it crossed down, so a cross within N sessions that still holds is 1 to N (or -1 to -N). A cross that has since reversed no longer counts. Counted over the 400 stored sessions at most. Blank until both sides exist. Measured at the last completed session."
  },
  {
   "key": "run_sma20_sma50",
   "label": "SMA20 vs SMA50 Run",
   "type": "range",
   "unit": null,
   "category": "technical",
   "description": "The 20-day SMA against the 50-day SMA. Positive counts consecutive sessions above, negative consecutive sessions below, and 0 means level on the last session. +1 is the session it crossed up, -1 the session it crossed down, so a cross within N sessions that still holds is 1 to N (or -1 to -N). A cross that has since reversed no longer counts. Counted over the 400 stored sessions at most. Blank until both sides exist. Measured at the last completed session."
  },
  {
   "key": "run_sma50_sma200",
   "label": "SMA50 vs SMA200 Run",
   "type": "range",
   "unit": null,
   "category": "technical",
   "description": "The 50-day SMA against the 200-day SMA: +1 is a golden cross, -1 a death cross. Positive counts consecutive sessions above, negative consecutive sessions below, and 0 means level on the last session. +1 is the session it crossed up, -1 the session it crossed down, so a cross within N sessions that still holds is 1 to N (or -1 to -N). A cross that has since reversed no longer counts. Counted over the 400 stored sessions at most. Blank until both sides exist. Measured at the last completed session."
  },
  {
