         "rsi"
        ]
       }
      },
      "modelTurns": 0
     },
     "canonical": {
      "ops": [
       {
        "action": "widget.add",
        "target": "$workspace",
        "args": {
         "type": "chart",
         "as": "new1"
        }
       },
       {
        "action": "chart.setSymbol",
        "target": "new1",
        "args": {
         "symbol": "AMD"
        }
       },
       {
        "action": "widget.add",
        "target": "$workspace",
        "args": {
         "type": "chart",
         "as": "new2"
        }
       },
       {
        "action": "chart.setSymbol",
        "target": "new2",
        "args": {
         "symbol": "QQQ"
        }
       },
       {
        "action": "indicator.add",
        "target": "new1",
        "args": {
         "defId": "rsi",
         "inputs": null
        }
       },
       {
        "action": "indicator.add",
        "target": "new2",
        "args": {
         "defId": "rsi",
         "inputs": null
        }
       }
      ],
      "routes": [
       "widget.add",
       "chart.setSymbol",
       "indicator.add"
      ]
     }
    },
    {
     "say": "undo",
     "expect": {
      "restored": true,
      "modelTurns": 0
     }
    }
   ]
