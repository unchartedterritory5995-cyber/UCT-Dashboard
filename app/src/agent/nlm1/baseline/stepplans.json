{
 "version": 1,
 "about": "NLM-1 STRUCTURED STEP PLANS — no-model scripted-plan harness (nlm1StepPlans.test.jsx). Each step's `plan` is a scripted CORRECT planner answer in the proposed step-reference schema (op `id`, later ops naming an earlier op's result as \"$<id>.chart\"); it is desugared onto today's executor (nlm1/stepPlan.js) and replayed through the REAL panel as the model's answer, then FINAL STATE and grouped Undo are asserted. A case whose plan needs a result the runtime does not carry yet records it in `expectUnsupported` (the runtime work the design names). This file is the case format for the separate planner eval: the scripted plan is replaced by the model's. A step may carry `names`: the words a real request uses to name its target chart(s); the harness appends them to its opaque line, because the panel (rightly) refuses to act on a chart of a multi-chart board that the member's words did not name.",
 "cases": [
  {
   "id": "P1.create-then-tf-and-indicator-on-it",
   "board": "HALF",
   "steps": [
    {
     "say": "add a chart for AMD, make it weekly and put RSI on it",
     "plan": {
      "ops": [
       {
        "id": "step1",
        "action": "widget.add",
        "target": "$workspace",
        "args": {
         "type": "chart"
        }
       },
       {
        "id": "step2",
        "action": "chart.setSymbol",
        "target": "$step1.chart",
        "args": {
         "symbol": "AMD"
        }
       },
       {
        "id": "step3",
        "action": "chart.setTimeframe",
        "target": "$step1.chart",
        "args": {
         "timeframe": "W"
        }
       },
       {
        "id": "step4",
        "action": "indicator.add",
        "target": "$step1.chart",
        "args": {
         "defId": "rsi",
         "inputs": null
        }
       }
      ]
     },
     "expect": {
      "bySymbol": {
       "AMD": {
        "tf": "W",
        "has": [
         "rsi"
        ]
       },
       "NVDA": {
        "tf": "D",
        "hasNot": [
         "rsi"
        ]
       }
      }
     }
    },
    {
     "say": "undo",
     "expect": {
      "restored": true
     }
    }
   ]
  },
  {
   "id": "P2.two-creates-indicator-on-each",
   "board": "HALF",
   "steps": [
    {
     "say": "add charts for AMD and QQQ, each with the 21 ema",
     "plan": {
      "ops": [
       {
        "id": "a",
        "action": "widget.add",
        "target": "$workspace",
        "args": {
         "type": "chart"
        }
       },
       {
        "action": "chart.setSymbol",
        "target": "$a.chart",
        "args": {
         "symbol": "AMD"
        }
       },
       {
        "id": "q",
        "action": "widget.add",
        "target": "$workspace",
        "args": {
         "type": "chart"
        }
       },
       {
        "action": "chart.setSymbol",
        "target": "$q.chart",
        "args": {
         "symbol": "QQQ"
        }
       },
       {
        "action": "indicator.add",
        "target": "$a.chart",
        "args": {
         "defId": "movingAverage",
         "inputs": [
          {
           "key": "period",
           "value": 21
          },
          {
           "key": "maType",
           "value": "ema"
          }
         ]
        }
       },
       {
        "action": "indicator.add",
        "target": "$q.chart",
        "args": {
         "defId": "movingAverage",
         "inputs": [
          {
           "key": "period",
           "value": 21
          },
          {
           "key": "maType",
           "value": "ema"
          }
         ]
        }
       }
      ]
     },
     "expect": {
      "bySymbol": {
       "AMD": {
        "ma": [
         21
        ]
       },
       "QQQ": {
        "ma": [
         21
        ]
       },
       "NVDA": {
        "noMa": [
         21
        ]
       }
      }
     }
    },
    {
     "say": "undo",
     "expect": {
      "restored": true
     }
    }
   ]
  },
  {
   "id": "P3.explicit-existing-chart-then-ref",
   "board": "TWO",
   "steps": [
    {
     "say": "put TSLA on the right chart, make it weekly and add macd",
     "plan": {
      "ops": [
       {
        "id": "s1",
        "action": "chart.setSymbol",
        "target": "$charts[1]",
        "args": {
         "symbol": "TSLA"
        }
       },
       {
        "action": "chart.setTimeframe",
        "target": "$s1.chart",
        "args": {
         "timeframe": "W"
        }
       },
       {
        "action": "indicator.add",
        "target": "$s1.chart",
        "args": {
         "defId": "macd",
         "inputs": null
        }
       }
      ]
     },
     "expect": {
      "charts": {
       "symbols": [
        "NVDA",
        "TSLA"
       ],
       "tfs": [
        "D",
        "W"
       ]
      },
      "bySymbol": {
       "TSLA": {
        "has": [
         "macd"
        ]
       },
       "NVDA": {
        "hasNot": [
         "macd"
        ]
       }
      }
     },
     "names": "the right chart"
    },
    {
     "say": "undo",
     "expect": {
      "restored": true
     }
    }
   ]
  },
  {
   "id": "P4.create-and-explicit-existing-never-retargeted",
   "board": "HALF",
   "steps": [
    {
     "say": "add a chart for AMD and make the NVDA chart weekly",
     "plan": {
      "ops": [
       {
        "id": "n",
        "action": "widget.add",
        "target": "$workspace",
        "args": {
         "type": "chart"
        }
       },
       {
        "action": "chart.setSymbol",
        "target": "$n.chart",
        "args": {
         "symbol": "AMD"
        }
       },
       {
        "action": "chart.setTimeframe",
        "target": "$charts[0]",
        "args": {
         "timeframe": "W"
        }
       }
      ]
     },
     "expect": {
      "bySymbol": {
       "NVDA": {
        "tf": "W"
       },
       "AMD": {
        "tf": "D"
       }
      }
     }
    },
    {
     "say": "undo",
     "expect": {
      "restored": true
     }
    }
   ]
  },
  {
   "id": "P5.symbol-tf-indicator-one-existing",
   "board": "ONE",
   "steps": [
    {
     "say": "switch to AMD on the weekly with the 50 sma",
     "plan": {
      "ops": [
       {
        "id": "c",
        "action": "chart.setSymbol",
        "target": "$charts[0]",
        "args": {
         "symbol": "AMD"
        }
       },
       {
        "action": "chart.setTimeframe",
        "target": "$c.chart",
        "args": {
         "timeframe": "W"
        }
       },
       {
        "action": "indicator.add",
        "target": "$c.chart",
        "args": {
         "defId": "movingAverage",
         "inputs": [
          {
           "key": "period",
           "value": 50
          },
          {
           "key": "maType",
           "value": "sma"
          }
         ]
        }
       }
      ]
     },
     "expect": {
      "bySymbol": {
       "AMD": {
        "tf": "W",
        "ma": [
         50
        ]
       }
      }
     }
    },
    {
     "say": "undo",
     "expect": {
      "restored": true
     }
    }
   ]
  },
  {
   "id": "P6.style-the-indicator-a-step-added",
   "board": "HALF",
   "steps": [
    {
     "say": "add a chart for AMD with the 21 ema and make it orange",
     "plan": {
      "ops": [
       {
        "id": "c",
        "action": "widget.add",
        "target": "$workspace",
        "args": {
         "type": "chart"
        }
       },
       {
        "action": "chart.setSymbol",
        "target": "$c.chart",
        "args": {
         "symbol": "AMD"
        }
       },
       {
        "id": "e",
        "action": "indicator.add",
        "target": "$c.chart",
        "args": {
         "defId": "movingAverage",
         "inputs": [
          {
           "key": "period",
           "value": 21
          },
          {
           "key": "maType",
           "value": "ema"
          }
         ]
        }
       },
       {
        "action": "indicatorStyle.set",
        "target": "$c.chart",
        "args": {
         "instance": "$e.indicator",
         "property": "color",
         "value": "orange",
         "output": null
        }
       }
      ]
     },
     "expectUnsupported": [
      "the runtime does not report a step's indicator result yet"
     ]
    }
   ]
  },
  {
   "id": "P7.forward-reference-refused",
   "board": "HALF",
   "steps": [
    {
     "say": "(malformed plan: a reference to a LATER step)",
     "plan": {
      "ops": [
       {
        "action": "chart.setTimeframe",
        "target": "$later.chart",
        "args": {
         "timeframe": "W"
        }
       },
       {
        "id": "later",
        "action": "widget.add",
        "target": "$workspace",
        "args": {
         "type": "chart"
        }
       }
      ]
     },
     "expectUnsupported": [
      "names no EARLIER step"
     ]
    }
   ]
  }
 ]
}
