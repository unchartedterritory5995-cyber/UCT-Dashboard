  {
   "id": "R-A1.symbol-tf-indicator-one-chart",
   "cat": "A",
   "board": "TWO",
   "steps": [
    {
     "say": "switch the right chart to TSLA on the weekly with RSI",
     "expect": {
      "bySymbol": {
       "TSLA": {
        "tf": "W",
        "has": [
         "rsi"
        ]
       },
       "NVDA": {
        "tf": "D",
        "hasNot": [
         "rsi"
        ]
       }
      },
      "modelTurns": 0
     },
     "canonical": {
      "ops": [
       {
        "action": "chart.setSymbol",
        "target": "$charts[1]",
        "args": {
         "symbol": "TSLA"
        }
       },
       {
        "action": "chart.setTimeframe",
        "target": "$charts[1]",
        "args": {
         "timeframe": "W"
        }
       },
       {
        "action": "indicator.add",
        "target": "$indicatorEdits[1]",
        "args": {
         "defId": "rsi",
         "inputs": null
        }
       }
      ],
      "routes": [
       "chart.setSymbol",
       "chart.setTimeframe",
       "indicator.add"
      ]
     }
    },
    {
     "say": "undo",
     "expect": {
      "restored": true,
      "modelTurns": 0
     }
    }
   ]
  },
