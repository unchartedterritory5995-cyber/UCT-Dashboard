      "id": "GW-14.price-alert-needs-approval",
      "source": "agentAlerts (alert.create is confirm-risk: a proposal, written only on Apply)",
      "capabilities": [
        "alert.create"
      ],
      "board": "ONE",
      "steps": [
        {
          "say": "alert me if nvda goes above 150",
          "model": {
            "disposition": "propose",
            "ops": [
              {
                "action": "alert.create",
                "target": "$alertLibrary",
                "args": {
                  "symbol": "NVDA",
                  "price": 150,
                  "direction": "above"
                }
              }
            ]
          },
          "expect": {
            "proposal": true,
            "noCalls": [
              "^POST /api/watchlist-alerts"
            ]
          },
          "approve": true,
          "afterApprove": {
            "writes": [
              "^POST /api/watchlist-alerts .*\"sym\":\"NVDA\""
            ]
          }
        }
      ]
