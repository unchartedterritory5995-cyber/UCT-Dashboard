{
  "version": 1,
  "about": "GOLDEN WORKFLOWS — previously VERIFIED successful UCT Agent workflows (live production acceptance, owner sessions, hotfix #766), replayed deterministically through the real panel (faithful scripted model where the live run used the model; value-free). A baseline: an entry may only be removed or weakened with a recorded decision in docs/agent/COMPATIBILITY-DECISIONS.md (enforced by baseline.lock.json + tests/test_uct_agent_capreg_baseline.py). `source` names the evidence.",
  "workflows": [
    {
      "id": "GW-01.symbol-weekly-emas-log-undo",
      "source": "LIVE-TESTING-RESULTS-2026-11-03.md E-01 (E each; D/LM)",
      "capabilities": [
        "chart.setSymbol",
        "chart.setTimeframe",
        "indicator.add",
        "chart.setScale",
        "agent.undo"
      ],
      "board": "ONE_SPY",
      "steps": [
        {
          "say": "nvda",
          "model": {
            "ops": [
              {
                "action": "chart.setSymbol",
                "target": "$charts[0]",
                "args": {
                  "symbol": "NVDA"
                }
              }
            ]
          },
          "expect": {
            "charts": {
              "symbols": [
                "NVDA"
              ]
            },
            "receipt": true
          }
        },
        {
          "say": "weekly",
          "expect": {
            "charts": {
              "tf": "W"
            },
            "receipt": true,
            "modelTurns": 0
          }
        },
        {
          "say": "add the 9 and 20 ema",
          "expect": {
            "indicators": {
              "chart": 0,
              "include": [
                "movingAverage(9 ema)",
                "movingAverage(20 ema)"
              ]
            },
            "receipt": true,
            "modelTurns": 0
          }
        },
        {
          "say": "log scale",
          "model": {
            "ops": [
              {
                "action": "chart.setScale",
                "target": "$charts[0]",
                "args": {
                  "scale": "log"
                }
              }
            ]
          },
          "expect": {
            "setting": {
              "key": "logScale",
              "value": true
            },
            "receipt": true
          }
        },
        {
          "say": "undo",
          "expect": {
            "setting": {
              "key": "logScale",
              "value": false
            },
            "charts": {
              "tf": "W",
              "symbols": [
                "NVDA"
              ]
            },
            "modelTurns": 0
          }
        }
      ]
    },
