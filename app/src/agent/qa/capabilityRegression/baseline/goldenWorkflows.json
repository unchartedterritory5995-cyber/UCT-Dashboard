      "id": "GW-09.two-new-charts",
      "source": "hotfix #766 T1 (owner live regression, verified 11-03); AUDIT live production pass 2026-11-04 (edd353fc06): two new daily charts, re-tiled",
      "capabilities": [
        "widget.add",
        "chart.setSymbol",
        "chart.setTimeframe"
      ],
      "board": "HALF",
      "steps": [
        {
          "say": "Create a new chart for NVDA on the daily timeframe, then add a second chart for QQQ.",
          "model": {
            "ops": [
              {
                "action": "widget.add",
                "target": "$workspace",
                "args": {
                  "type": "chart",
                  "as": "new1"
                }
              },
              {
                "action": "chart.setSymbol",
                "target": "new1",
                "args": {
                  "symbol": "NVDA"
                }
              },
              {
                "action": "chart.setTimeframe",
                "target": "new1",
                "args": {
                  "timeframe": "D"
                }
              },
              {
                "action": "widget.add",
                "target": "$workspace",
                "args": {
                  "type": "chart",
                  "as": "new2"
                }
              },
              {
                "action": "chart.setSymbol",
                "target": "new2",
                "args": {
                  "symbol": "QQQ"
                }
              },
              {
                "action": "chart.setTimeframe",
                "target": "new2",
                "args": {
                  "timeframe": "D"
                }
              }
            ]
          },
          "expect": {
            "charts": {
              "count": 3,
              "symbolSet": [
                "NVDA",
                "NVDA",
                "QQQ"
              ],
              "keepsIds": [
                "c1"
              ]
            },
            "receipt": true,
            "refusal": false
          }
        },
        {
          "say": "undo",
          "expect": {
            "restored": true
          }
        }
      ]
    },
