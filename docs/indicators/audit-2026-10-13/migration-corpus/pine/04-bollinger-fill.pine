// WS5 audit corpus - written for this audit (UCT, 2026-10-13). Not a TradingView community script.
//@version=5
indicator("Bollinger (audit)", overlay = true)
length = input.int(20, "Length")
mult = input.float(2.0, "StdDev")
basis = ta.sma(close, length)
dev = mult * ta.stdev(close, length)
upper = basis + dev
lower = basis - dev
plot(basis, "Basis", color = color.orange)
p1 = plot(upper, "Upper", color = color.blue)
p2 = plot(lower, "Lower", color = color.blue)
fill(p1, p2, color = color.new(color.blue, 85))
