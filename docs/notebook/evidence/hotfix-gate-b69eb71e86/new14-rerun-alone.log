/* ── Responsive ── */
@media (max-width: 1024px) {
  /* ⛔ `PageHeader`'s full-bleed negative margin reads `--page-pad-top`/
     `--page-pad-x` off THIS element (see PageHeader.module.css's header
     comment) — changing `padding` here without also moving those two custom
     properties leaves the header pulling back by the DESKTOP inset (24px)
     while the page itself is only inset 10px, so the header overhangs the
     viewport by the 14px difference on both edges. Measured in real Chromium
