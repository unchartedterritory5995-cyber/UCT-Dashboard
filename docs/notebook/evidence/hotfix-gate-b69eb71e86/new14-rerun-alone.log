._sheetItemActive_r1jv9_1061 ._dropdownSym_r1jv9_197,
._sheetItemActive_r1jv9_1061 ._dropdownName_r1jv9_213 { color: var(--bg); }

/* ── Narrow layouts: the rail drops below the chart ──────────────── */
@media (max-width: 960px) {
  ._body_r1jv9_293 { flex-direction: column; }
}

/* ── Phone layout ────────────────────────────────────────────────── */
@media (max-width: 640px) {
  ._page_r1jv9_3 { padding: 14px 12px 80px; }
  ._topBar_r1jv9_19 { gap: 10px; }
  ._dropdownWrap_r1jv9_37 { width: 100%; }
  ._dropdownBtn_r1jv9_45 { width: 100%; min-width: 0; min-height: var(--tap-min); }
  /* Lookback strip → horizontal scroller with 44px targets. */
  ._lookbackBtns_r1jv9_227 {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  ._lookbackBtns_r1jv9_227::-webkit-scrollbar { display: none; }
  ._lookbackBtn_r1jv9_227 { flex: 0 0 auto; min-height: var(--tap-min); }
  ._resetSizeBtn_r1jv9_979 { flex: 0 0 auto; min-height: var(--tap-min); margin-left: 4px; }
  /* Chart fills the viewport; resize handles are pointer-only and idle here. */
  ._chartWrap_r1jv9_327 { padding: 12px; height: calc(100vh - 220px); }
}

/* TOUCH TIER (<=1024px) -- generated ------------------------------------------
   These selectors are declared finger targets by the PHONE block(s)
   in this file and nowhere else, so the TABLET tier (641-1024) -- which
   breakpoints.css calls TOUCH -- sat under the 44px `--tap-min` floor.
   Only the finger-target declarations are repeated here; the phone
   LAYOUT (padding, font-size, flex, overflow) deliberately does not
   travel. Rail: app/src/styles/tapFloor.test.js. */
@media (max-width: 1024px) {
  ._dropdownBtn_r1jv9_45 {
    min-width: 0;
    min-height: var(--tap-min);
  }
  ._lookbackBtn_r1jv9_227 {
    min-height: var(--tap-min);
  }
  ._resetSizeBtn_r1jv9_979 {
    min-height: var(--tap-min);
  }
}
