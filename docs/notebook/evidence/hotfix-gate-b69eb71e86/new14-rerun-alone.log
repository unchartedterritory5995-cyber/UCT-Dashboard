/* ── Table scroll container ─────────────────────────────────────────────────── */
/* Full-bleed: the monitor grid meets the sidebar and the page edges rather than
   floating as a rounded card. It escapes the page padding with negative margins
   (like the header bar) and keeps only a top hairline as the seam under the
   header — the dense grid gets every pixel of width and reads as one surface. */
._tableWrap_1ckcz_171 {
  overflow-x: auto;
  overflow-y: auto;
  flex: 1;
  min-height: 0;
  border: none;
  border-radius: 0;
  /* Isolate the grid's layout + paint so the sidebar's push (which resizes the
     content area) doesn't force expensive relayout/repaint of the whole table
     every animation frame — the table is width:max-content and independent, so
     containment lets the browser scope the work and keeps the push smooth. */
  contain: layout paint;
  /* Pull up 16px to cancel the shared PageHeader's bottom margin so the grid
     butts directly under the header's own border-bottom — one clean seam, no
     dark band, no double line. Sides/bottom escape the page padding (full-bleed). */
  margin: -16px calc(-1 * var(--page-pad-x, 24px)) calc(-1 * var(--page-pad-top, 20px));
}

/* ── Table ─────────────────────────────────────────────────────────────────── */
._table_1ckcz_171 {
  border-collapse: separate;
  border-spacing: 0;
  /* Brand font, not mono — tabular-nums keeps the columns aligned. */
  font-family: var(--font-sans);
  font-variant-numeric: tabular-nums;
  font-size: var(--text-md);
  white-space: nowrap;
  width: max-content;
}

/* ── Sticky thead — entire header block moves as one unit, no inter-row gaps */
._table_1ckcz_171 thead {
  position: sticky;
  top: 0;
  z-index: 3;
}

/* ── Header cells ────────────────────────────────────────────────────────────── */
._th_1ckcz_247 {
  padding: 8px 12px;
  text-align: center;
  font-weight: 700;
  letter-spacing: 0.2px;
  color: var(--text-bright);
  background: var(--bg-surface);
  border-bottom: 1px solid var(--header-line);
  border-right: 1px solid color-mix(in srgb, var(--text-heading) 4%, transparent);
}

._colLabel_1ckcz_269 {
