}
._resizeHandleLeft_r1jv9_845:hover { background: color-mix(in srgb, var(--text-heading) 12%, transparent); }

._resizeHandleBottom_r1jv9_871 {
  position: absolute;
  bottom: -3px;
  left: 0;
  width: 100%;
  height: 6px;
  cursor: ns-resize;
  background: transparent;
  transition: background 0.15s;
  z-index: 10;
}
._resizeHandleBottom_r1jv9_871:hover { background: color-mix(in srgb, var(--text-heading) 12%, transparent); }

._resizeHandleTop_r1jv9_897 {
  position: absolute;
  top: -3px;
  left: 0;
  width: 100%;
  height: 6px;
  cursor: ns-resize;
  background: transparent;
  transition: background 0.15s;
  z-index: 10;
}
._resizeHandleTop_r1jv9_897:hover { background: color-mix(in srgb, var(--text-heading) 12%, transparent); }

._resizeHandleCorner_r1jv9_923 {
  position: absolute;
  bottom: -3px;
  right: -3px;
  width: 18px;
  height: 18px;
  cursor: nwse-resize;
  background: transparent;
