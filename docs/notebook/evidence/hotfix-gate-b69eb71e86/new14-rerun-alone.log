/* ── Provisional intraday row ─────────────────────────────────────────────────
   The live row sits ABOVE today's history and must never be mistaken for a
   settled one. It reads as \"in progress\": a live stamp instead of a date, a
   gold rail down the left edge, and a faint sheen that stops entirely under
   prefers-reduced-motion. The 4:15 PM collector replaces it with the
   authoritative row, at which point the backend stops serving it at all. */

/* NO background on the data cells. `.liveRow td` outranks the `.bgG3`/`.bgR1`
   tier classes (0,1,1 vs 0,1,0), so a wash here silently flattens the heat map
   — which is the entire language of this table. Caught in the browser: the live
   row rendered every cell neutral while the row below it was fully coloured.
   Liveness is carried by the date cell and a hairline instead. */
._liveRow_1ckcz_2447 td {
  border-top: 1px solid color-mix(in srgb, var(--ut-gold) 30%, transparent);
  border-bottom-color: var(--accent);
}

._liveRow_1ckcz_2447 ._dateCell_1ckcz_349 {
  background: color-mix(in srgb, var(--ut-gold) 9%, transparent);
  box-shadow: inset 2px 0 0 var(--ut-gold);
  color: var(--ut-gold);
}

._table_1ckcz_171 tbody tr._liveRow_1ckcz_2447:hover ._dateCell_1ckcz_349 {
  background: color-mix(in srgb, var(--ut-gold) 14%, transparent);
}

._liveStamp_1ckcz_2487 {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-weight: 600;
  letter-spacing: 0.3px;
  font-variant-numeric: tabular-nums;
}

._livePulse_1ckcz_2505 {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--ut-gold);
  box-shadow: 0 0 0 0 color-mix(in srgb, var(--ut-gold) 55%, transparent);
  animation: _liveBeat_1ckcz_1 2.4s ease-out infinite;
  flex: none;
}

@keyframes _liveBeat_1ckcz_1 {
  0%   { box-shadow: 0 0 0 0 color-mix(in srgb, var(--ut-gold) 50%, transparent); }
  70%  { box-shadow: 0 0 0 6px color-mix(in srgb, var(--ut-gold) 0%, transparent); }
  100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--ut-gold) 0%, transparent); }
}

/* (Reconstructed-row date styling removed 2026-09-01 — owner wanted every
   historical date to read identically to a collected one; the `_reconstructed`
   data flag is still set, just no longer visually distinguished.) */

/* A row whose metrics haven't been fetched yet — the date is known from the
   timeline index, the values fill in when its block lands. A faint centered dot
   keeps the grid from flickering as blocks load during a scroll. */
._skeletonRow_1ckcz_2551 ._dateCell_1ckcz_349 { opacity: 0.6; }

._skelDot_1ckcz_2555 {
  color: var(--text-muted);
  opacity: 0.35;
}

/* A value carried from last night is NOT a live reading. Same treatment as a
   stale AAII survey, because it is the same fact about the number. */
._liveRow_1ckcz_2447 ._liveCarried_1ckcz_2569 {
  opacity: 0.42;
  font-style: italic;
}

/* Reconciles to roughly 10% rather than to a point — small counts sitting on a
   hard threshold against a 252-day extreme. Directionally right, not a number
   to trade a single name off. */
._liveRow_1ckcz_2447 ._liveApprox_1ckcz_2585::after {
  content: '≈';
  margin-left: 3px;
  font-size: var(--text-xs);
  opacity: 0.5;
  vertical-align: super;
}

@media (prefers-reduced-motion: reduce) {
  ._livePulse_1ckcz_2505 { animation: none; }
}

