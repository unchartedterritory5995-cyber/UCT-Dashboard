  color: var(--text);
}

/* Hairline rule on each metric family's first column — the quiet successor to
   the retired colored group-header strip. Keeps families scannable. */
._groupStart_1ckcz_283 {
  border-left: 1px solid color-mix(in srgb, var(--text-heading) 14%, transparent);
}

/* Date column — sticky left */
._dateCol_1ckcz_293 {
  position: sticky;
  left: 0;
  z-index: 3;
  background: var(--bg-elevated);
  border-right: 1px solid var(--border);
  text-align: left;
  min-width: 90px;
}

/* ── Body cells ──────────────────────────────────────────────────────────────── */
._td_1ckcz_315 {
  padding: 6px 12px;
  /* FIXED height (border-box) — every Monitor row is exactly 32px so the virtual
     scroller's scroll-to-index is pixel-exact across all ~4,700 sessions. Content
     is single-line (the table is white-space:nowrap), so nothing pushes past it.
     Must match MONITOR_ROW_H in Breadth.jsx. */
  height: 32px;
  box-sizing: border-box;
  /* Centered: each cell is a coloured heatmap tile, so the value reads best
     sitting in the middle of its tile rather than hugging the right edge. */
  text-align: center;
  color: var(--text);
  border-right: 1px solid color-mix(in srgb, var(--text-heading) 3%, transparent);
  border-bottom: 1px solid color-mix(in srgb, var(--text-heading) 3%, transparent);
  font-variant-numeric: tabular-nums;
}

