   50x21, 29x21, 67x21 on tablet. Appended at file END so equal-specificity
   base rules can't out-cascade it (source order decides). */
@media (max-width: 1024px) {
  ._hdrBtn_1ckcz_721 {
    min-height: var(--tap-min);
    display: inline-flex;
    align-items: center;
  }
}
