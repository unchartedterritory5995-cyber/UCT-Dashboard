--- count_notes ---
SELECT count(*) FROM j2_notes WHERE user_id = ? AND deleted_at IS NULL AND archived_at IS NULL
  {'id': 3, 'parent': 0, 'notused': 54, 'detail': 'SEARCH j2_notes USING COVERING INDEX idx_j2_notes_live_folder_title (user_id=? AND deleted_at=? AND archived_at=?)'}

--- folder_note_counts ---
