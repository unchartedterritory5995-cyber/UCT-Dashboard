--- get_symbol_backlinks detail query ---
SELECT note_id, COUNT(*) AS refs, GROUP_CONCAT(DISTINCT widget_id) AS widgets FROM j2_note_embeds WHERE user_id = ? AND symbol = ? AND note_id IN (?,?,?,?,?) GROUP BY note_id
