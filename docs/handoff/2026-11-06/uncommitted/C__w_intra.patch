+def server_partials(tape, period=PERIOD):
+    """What bar_broadcaster's _partials would hold after each accepted trade.
+
+    Mirrors the T path: bucket by the TRADE's timestamp, o on bucket create,
+    h/l extended, c = last accepted price, v summed. Emitted as the running
+    partial, which is exactly what the wire carries."""
+    # ⛔ BUCKET IDENTITY IN SECONDS, THE WIRE IN MILLISECONDS -- and the first cut
+    # mixed them: it stored `t` as ms and compared it against a seconds bucket, so
+    # `cur["t"] != bt` was ALWAYS true, a fresh partial was created per trade, and
+    # every frame went out flat (o=h=l=c). Five bars-lane scenarios failed on
+    # high/low and it read like a product defect. This is the same ms/s trap the
+    # design audit flagged for `mp["ts"]`, which is exactly why that conversion
+    # gets its own test rather than a careful reading.
+    out, cur, cur_bt = [], None, None
+    for ts, px in tape:
+        bt = int(ts // period) * period
+        if cur is None or cur_bt != bt:
+            cur_bt = bt
+            cur = {"t": bt * 1000, "o": px, "h": px, "l": px, "c": px, "v": 100}
+        else:
+            cur = {**cur, "h": max(cur["h"], px), "l": min(cur["l"], px),
+                   "c": px, "v": cur["v"] + 100}
+        out.append({"marketTs": ts, "bucket": bt, "bar": dict(cur)})
+    return out
