diff --git a/api/services/uct_agent/knowledge/evidence.py b/api/services/uct_agent/knowledge/evidence.py
index 2875a9348e..1d9a03c3be 100644
--- a/api/services/uct_agent/knowledge/evidence.py
+++ b/api/services/uct_agent/knowledge/evidence.py
@@ -306,6 +306,13 @@ def _cache_put(key, decision: dict) -> None:
         _CACHE[key] = (time.monotonic(), dict(decision))
 
 
+def _judge_key(meter, reply: str) -> Optional[tuple]:
+    rid = getattr(meter, "request_id", None) if meter is not None else None
+    if rid is None:
+        return None
+    return ("judge", str(getattr(meter, "user_id", "")), int(rid), hashlib.sha256(reply.encode("utf-8")).hexdigest())
+
+
 def _reset_for_test() -> None:
     with _CACHE_LOCK:
         _CACHE.clear()
@@ -744,7 +751,17 @@ def judge_backstop(res: dict, message: str, meter=None) -> dict:
     if not reply or reply in fixed_sentences() or (disp == "clarify" and all(
             x in fixed_sentences() or x in ("", "Which one do you mean?") for x in reply.split("\n"))):
         return res
-    block, why, use = judge_reply(reply, message, meter)
+    # QA round 4: a browser reroute / repair of the SAME request that comes back with the SAME text is not judged (or
+    # paid for) twice; any different text is judged again
+    jkey = _judge_key(meter, reply)
+    hit = _cache_get(jkey)
+    if hit is not None:
+        block, why, use = bool(hit["block"]), str(hit["why"]) + ":cached", {"input_tokens": 0, "output_tokens": 0,
+                                                                          "cost_usd": 0.0}
+    else:
+        block, why, use = judge_reply(reply, message, meter)
+        if not why.startswith(("judge_error", "judge_stop", "judge_json", "judge_schema", "judge_unaffordable")):
+            _cache_put(jkey, {"block": block, "why": why})
     usage = res.setdefault("usage", {})
     usage["judge"] = why
     usage["model_calls"] = int(usage.get("model_calls") or 0) + (1 if use.get("input_tokens") else 0)
diff --git a/tests/test_uct_agent_evidence.py b/tests/test_uct_agent_evidence.py
index 9897b141d4..820259b690 100644
--- a/tests/test_uct_agent_evidence.py
+++ b/tests/test_uct_agent_evidence.py
@@ -921,3 +921,25 @@ def test_r3_e1_refuses_planner_v2_with_no_paid_call(monkeypatch):
         assert out["usage"]["evidence"]["why"] == "e1_refuses_v2"
     assert c.calls == []
 
+
+
+def test_r4_a_reroute_with_the_same_text_is_not_judged_twice_but_new_text_is(monkeypatch):
+    use(monkeypatch, MISROUTES[1])
+    j = _judge(monkeypatch, JUDGE_CLEAR)
+    m = _Meter(request_id=99)
+    for _ in range(2):                                                          # first request, then its reroute
+        out = run("what is vwap", meter=m, caller=caller_of(_resp(env("answer", reply="VWAP is an average."))))
+    assert len(j.calls) == 1 and out["usage"]["judge"] == "judge:clear:cached"
+    run("what is vwap", meter=m, caller=caller_of(_resp(env("answer", reply="VWAP weights price by volume."))))
+    assert len(j.calls) == 2                                                    # different text: judged again
+    run("what is vwap", meter=_Meter(request_id=100), caller=caller_of(_resp(env("answer", reply="VWAP is an average."))))
+    assert len(j.calls) == 3                                                    # another request: judged again
+
+
+def test_r4_a_failed_judgement_is_never_cached(monkeypatch):
+    use(monkeypatch, MISROUTES[1])
+    j = _judge(monkeypatch, RuntimeError("down"), JUDGE_CLEAR)
+    m = _Meter(request_id=5)
+    a = run("what is vwap", meter=m, caller=caller_of(_resp(env("answer", reply="VWAP is an average."))))
+    b = run("what is vwap", meter=m, caller=caller_of(_resp(env("answer", reply="VWAP is an average."))))
+    assert a["envelope"]["reply"] == ev.NOT_RETRIEVED and b["usage"]["judge"] == "judge:clear" and len(j.calls) == 2
