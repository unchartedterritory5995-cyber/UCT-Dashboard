        {"id": "max_stop", "role": "risk", "locator": "stop_methods.max_pct", "measurable": "stop_distance_pct", "op": "<=", "value": 8.0, "unit": "pct", "timeframe": "daily", "basis": "stated", "strength": "required", "assumptions": []}
