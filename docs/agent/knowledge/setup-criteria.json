        {"id": "breakout_volume", "role": "entry", "locator": "entry_triggers.volume_min", "measurable": "rel_volume_weekly_10w", "op": ">=", "value": 1.5, "unit": "x", "timeframe": "weekly", "basis": "interpreted", "strength": "required", "assumptions": ["average window not stated: 10 weeks"]},
        {"id": "back_below_30w_ma", "role": "invalidation", "locator": "invalidation.structural", "measurable": "close_vs_sma30w", "op": "<", "value": 0, "unit": "pct", "timeframe": "weekly", "basis": "stated", "strength": "required", "assumptions": []},
        {"id": "max_stop", "role": "risk", "locator": "stop_methods.max_pct", "measurable": "stop_distance_pct", "op": "<=", "value": 10.0, "unit": "pct", "timeframe": "daily", "basis": "stated", "strength": "required", "assumptions": []}
