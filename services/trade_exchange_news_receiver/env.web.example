# web service additions for Trade Exchange News — variable NAMES only.
TXN_ENABLED=                     # "1" mounts the routes (admin-only) — runbook step W3
TXN_STORAGE_PERMISSION_CONFIRMED= # "1" ONLY after written permission; without it the pipeline never starts
TXN_INGEST_TOKEN_SHA256=         # digest(s) of the receiver bearer
TXN_JOURNAL=s3
TXN_JOURNAL_ENDPOINT_URL=
TXN_JOURNAL_ACCESS_KEY_ID=       # web's OWN R2 token (Object Read & Write, this bucket only; repair pass)
TXN_JOURNAL_SECRET_ACCESS_KEY=
TXN_JOURNAL_BUCKET=uct-trade-exchange-news
TXN_JOURNAL_RETENTION_HOURS=192  # must match the bucket lifecycle (8 days)
ALERT_NEWS_MATCH_ENABLED=        # "1" arms news alerts (admin-only routes) — optional, separate step
# optional: TXN_DEDUPE_WINDOW_S, TXN_HISTORY_MAX_AGE_HOURS, TXN_HISTORY_MAX_ITEMS, TXN_RECONCILE_INTERVAL_S
