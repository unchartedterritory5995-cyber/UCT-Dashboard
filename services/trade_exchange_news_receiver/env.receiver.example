# trade-exchange-news-receiver — variable NAMES only. Values come from
# tools/txn_mint_secrets.py (secrets) and the R2 dashboard; never commit values.
TXN_RECEIVER_ENABLED=            # "1" arms the hook (runbook step R5)
TXN_STORAGE_PERMISSION_CONFIRMED= # "1" ONLY after Trade Exchange's written permission (synthetic staging excepted)
TXN_WEBHOOK_TOKEN_SHA256=        # digest(s) of the hook secret, comma-separated during rotation
TXN_INGEST_TOKEN=                # plaintext bearer to web (secret)
TXN_WEB_INGEST_URL=http://web.railway.internal:8080/api/trade-exchange-news/internal/ingest
TXN_JOURNAL=s3
TXN_JOURNAL_ENDPOINT_URL=        # https://<account-id>.r2.cloudflarestorage.com
TXN_JOURNAL_ACCESS_KEY_ID=       # receiver's R2 token (Object Read & Write, this bucket only)
TXN_JOURNAL_SECRET_ACCESS_KEY=
TXN_JOURNAL_BUCKET=uct-trade-exchange-news
TXN_SOURCE_ALLOWLIST=TXNews1
TXN_AUTH_MODES=path,bearer,basic,header   # narrow once Trade Exchange confirms its method
TXN_ACK_STATUS=200
# optional: TXN_SENTRY_DSN, TXN_RATE_BURST, TXN_RATE_PER_SEC, TXN_JOURNAL_TIMEOUT_S
