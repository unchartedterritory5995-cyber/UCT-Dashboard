  {
   "id": "gap_up_on_volume",
   "request": "Mark a gap up of 4% or more on above-average volume (volume above its 50-day average) with an arrow under the bar.",
   "ops": [
    {
     "op": "create",
     "name": "Gap Up on Volume",
     "placement": "price",
     "primary": "gapUpVol",
