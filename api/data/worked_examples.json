{
 "version": 1,
 "examples": [
  {
   "id": "distribution_day_count",
   "request": "Count distribution days on this chart: a day that closes down at least 0.2 percent on higher volume than the day before. Show a running count over the last 25 sessions in a lower pane, and mark each distribution day with a small red dot above the bar.",
   "ops": [
    {
     "op": "create",
     "name": "Distribution Day Count",
     "placement": "pane",
     "primary": "ddCount",
     "outputs": [
      {
       "key": "ddCount",
       "label": "Distribution Days (25)",
       "tree": {
        "type": "call",
        "name": "sum",
        "args": [
         {
          "type": "op",
          "name": "?:",
          "args": [
           {
            "type": "op",
            "name": "&&",
            "args": [
             {
              "type": "op",
              "name": "<=",
              "args": [
               {
                "type": "series",
                "name": "close"
               },
               {
                "type": "op",
                "name": "*",
                "args": [
                 {
                  "type": "offset",
                  "value": 1,
                  "args": [
                   {
                    "type": "series",
                    "name": "close"
                   }
                  ]
                 },
                 {
                  "type": "num",
                  "value": 0.998
                 }
                ]
               }
              ]
             },
             {
              "type": "op",
              "name": ">",
              "args": [
               {
                "type": "series",
                "name": "volume"
               },
               {
                "type": "offset",
                "value": 1,
                "args": [
                 {
                  "type": "series",
                  "name": "volume"
                 }
                ]
               }
              ]
             }
            ]
           },
           {
            "type": "num",
            "value": 1
           },
           {
            "type": "num",
            "value": 0
           }
          ]
         },
         {
          "type": "num",
          "value": 25
         }
        ]
       }
      },
      {
       "key": "isDD",
       "label": "Distribution Day",
       "tree": {
        "type": "op",
        "name": "&&",
        "args": [
         {
          "type": "op",
          "name": "<=",
          "args": [
           {
            "type": "series",
            "name": "close"
           },
           {
            "type": "op",
            "name": "*",
            "args": [
             {
              "type": "offset",
              "value": 1,
              "args": [
               {
                "type": "series",
                "name": "close"
               }
              ]
             },
             {
              "type": "num",
              "value": 0.998
             }
            ]
           }
          ]
         },
         {
          "type": "op",
          "name": ">",
          "args": [
           {
            "type": "series",
            "name": "volume"
           },
           {
            "type": "offset",
            "value": 1,
            "args": [
             {
              "type": "series",
              "name": "volume"
             }
            ]
           }
          ]
         }
        ]
       }
      }
     ]
    },
    {
     "op": "set_marker",
     "output": "isDD",
     "shape": "circle",
     "position": "aboveBar",
     "size": 0.5,
     "color": "#F23645"
    }
   ]
  },
  {
   "id": "relative_strength_vs_spy",
   "request": "Plot the relative strength line against SPY (close divided by SPY's close) in a lower pane, with its 21-bar exponential average.",
   "ops": [
    {
     "op": "create",
     "name": "Relative Strength vs SPY",
     "placement": "pane",
     "primary": "rs",
     "outputs": [
      {
       "key": "rs",
       "label": "RS vs SPY",
       "tree": {
        "type": "op",
        "name": "/",
        "args": [
         {
          "type": "series",
          "name": "close"
         },
         {
          "type": "sym",
          "value": "SPY",
          "args": [
           {
            "type": "series",
            "name": "close"
           }
          ]
         }
        ]
       }
      },
      {
       "key": "rsEma",
       "label": "RS 21 EMA",
       "tree": {
        "type": "call",
        "name": "ema",
        "args": [
         {
          "type": "op",
          "name": "/",
          "args": [
           {
            "type": "series",
            "name": "close"
           },
           {
            "type": "sym",
            "value": "SPY",
            "args": [
             {
              "type": "series",
              "name": "close"
             }
            ]
           }
          ]
         },
         {
          "type": "num",
          "value": 21
         }
        ]
       }
      }
     ]
    }
   ]
  },
  {
   "id": "rs_new_high_vs_spy",
   "request": "Put a marker on the price chart when the relative strength line versus SPY makes a new 52 week high while price is still below its own 52 week high.",
   "ops": [
    {
     "op": "create",
     "name": "RS New High vs SPY",
     "placement": "price",
     "primary": "rs",
     "outputs": [
      {
       "key": "rs",
       "label": "RS vs SPY",
       "tree": {
        "type": "op",
        "name": "/",
        "args": [
         {
          "type": "series",
          "name": "close"
         },
         {
          "type": "sym",
          "value": "SPY",
          "args": [
           {
            "type": "series",
            "name": "close"
           }
          ]
         }
        ]
       },
       "hidden": true
      },
      {
       "key": "sig",
       "label": "RS new high, price below high",
       "tree": {
        "type": "op",
        "name": "&&",
        "args": [
         {
          "type": "op",
          "name": ">=",
          "args": [
           {
            "type": "op",
            "name": "/",
            "args": [
             {
              "type": "series",
              "name": "close"
             },
             {
              "type": "sym",
              "value": "SPY",
              "args": [
               {
                "type": "series",
                "name": "close"
               }
              ]
             }
            ]
           },
           {
            "type": "call",
            "name": "highest",
            "args": [
             {
              "type": "op",
              "name": "/",
              "args": [
               {
                "type": "series",
                "name": "close"
               },
               {
                "type": "sym",
                "value": "SPY",
                "args": [
                 {
                  "type": "series",
                  "name": "close"
                 }
                ]
               }
              ]
             },
             {
              "type": "num",
              "value": 252
             }
            ]
           }
          ]
         },
         {
          "type": "op",
          "name": "<",
          "args": [
           {
            "type": "series",
            "name": "high"
           },
           {
            "type": "call",
            "name": "highest",
            "args": [
             {
              "type": "series",
              "name": "high"
             },
             {
              "type": "num",
              "value": 252
             }
            ]
           }
          ]
         }
        ]
       }
      }
     ]
    },
    {
     "op": "set_marker",
     "output": "sig",
     "shape": "arrowUp",
     "position": "belowBar",
     "color": "#089981",
     "text": "RS high"
    }
   ]
  },
  {
   "id": "atr_extension",
   "request": "Show how extended price is above its 50 day simple moving average, measured in multiples of the 14 day ATR, and colour the line red above 7 and orange above 4.",
   "ops": [
    {
     "op": "create",
     "name": "ATR Extension",
     "placement": "pane",
     "primary": "ext",
     "outputs": [
      {
       "key": "ext",
       "label": "ATR Extension",
       "tree": {
        "type": "op",
        "name": "/",
        "args": [
         {
          "type": "op",
          "name": "-",
          "args": [
           {
            "type": "series",
            "name": "close"
           },
           {
            "type": "call",
            "name": "sma",
            "args": [
             {
              "type": "series",
              "name": "close"
             },
             {
              "type": "num",
              "value": 50
             }
            ]
           }
          ]
         },
         {
          "type": "call",
          "name": "atr",
          "args": [
           {
            "type": "series",
            "name": "high"
           },
           {
            "type": "series",
            "name": "low"
           },
           {
            "type": "series",
            "name": "close"
           },
           {
            "type": "num",
            "value": 14
           }
          ]
         }
        ]
       }
      }
     ]
    },
    {
     "op": "set_color_states",
     "output": "ext",
     "states": [
      {
       "color": "#F23645",
       "when": {
        "type": "op",
        "name": ">",
        "args": [
         {
          "type": "op",
          "name": "/",
          "args": [
