            "type": "op",
            "name": "-",
            "args": [
             {
              "type": "series",
              "name": "close"
             },
             {
              "type": "call",
              "name": "sma",
              "args": [
               {
                "type": "series",
                "name": "close"
               },
               {
                "type": "num",
                "value": 50
               }
              ]
             }
            ]
           },
           {
            "type": "call",
            "name": "atr",
            "args": [
             {
              "type": "series",
              "name": "high"
             },
             {
              "type": "series",
              "name": "low"
             },
             {
              "type": "series",
              "name": "close"
             },
             {
              "type": "num",
              "value": 14
             }
            ]
           }
          ]
         },
         {
          "type": "num",
          "value": 7
         }
        ]
       }
      },
      {
       "color": "#FF9800",
       "when": {
        "type": "op",
        "name": ">",
        "args": [
         {
          "type": "op",
          "name": "/",
          "args": [
           {
            "type": "op",
            "name": "-",
            "args": [
             {
              "type": "series",
              "name": "close"
             },
             {
              "type": "call",
              "name": "sma",
              "args": [
               {
                "type": "series",
                "name": "close"
               },
               {
                "type": "num",
                "value": 50
               }
              ]
             }
            ]
           },
           {
            "type": "call",
            "name": "atr",
            "args": [
             {
              "type": "series",
              "name": "high"
             },
             {
              "type": "series",
              "name": "low"
             },
             {
              "type": "series",
              "name": "close"
             },
             {
              "type": "num",
              "value": 14
             }
            ]
           }
          ]
         },
         {
          "type": "num",
          "value": 4
         }
        ]
       }
      }
     ],
     "otherwise": "#2962FF"
    },
    {
     "op": "set_levels",
     "values": [
      0,
      4,
      7
     ]
    }
   ]
