     {
      "type": "paragraph",
      "content": [
       {
        "type": "text",
        "text": "Risk the same small share of the account on every trade. The number of shares follows from the distance between the entry and the stop:"
       }
      ]
     },
     {
      "type": "blockMath",
      "attrs": {
       "latex": "\\text{shares} = \\frac{\\text{account} \\times \\text{risk per trade}}{\\text{entry} - \\text{stop}}"
      }
     },
     {
      "type": "paragraph",
      "content": [
       {
        "type": "text",
        "text": "Risking one percent of a 50,000 account with a two-point stop: "
       },
       {
        "type": "inlineMath",
        "attrs": {
         "latex": "\\frac{500}{2} = 250"
        }
       },
       {
        "type": "text",
        "text": " shares."
       }
      ]
     },
     {
      "type": "heading",
      "attrs": {
       "level": 3
      },
      "content": [
       {
        "type": "text",
        "text": "The same sum as code"
       }
      ]
     },
     {
      "type": "codeBlock",
      "attrs": {
       "language": "python"
      },
      "content": [
       {
        "type": "text",
        "text": "def position_size(account, risk, entry, stop):\n    return int(account * risk / (entry - stop))\n\nposition_size(50_000, 0.01, 42.0, 40.0)  # 250"
       }
      ]
