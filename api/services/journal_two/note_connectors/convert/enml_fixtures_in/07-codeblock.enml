<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd"><en-note><div>Scanner rule:</div><div style="box-sizing: border-box; padding: 8px; font-family: monospace; -en-codeblock: true;"><div>def rs(a, b):</div><div>    return a / b if b else 0</div><div><br/></div><div>  # end &lt;rule&gt;</div></div><div>after the code</div><div style="-en-codeblock:true"><div>x = 1</div><div><en-media hash="78be4697f74308567b03fded6354fb22" type="image/png"/></div></div></en-note>
