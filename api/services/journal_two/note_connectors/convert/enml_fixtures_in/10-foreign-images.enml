<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd"><en-note><div>A hotlink:</div><img src="https://e.example.com/pics/x.png"/><div>An unsafe image:</div><img src="javascript:alert(1)"/><div>A data image:</div><img src="data:image/png;base64,iVBORw0KGgo="/><div>A relative image, no clip source:</div><img src="/local/x.png"/><div>end</div></en-note>
