# Installed by OWNER-SETUP.md only after AUDIT and the owner approve runner registration.
# UCT_CI_LANE and UCT_CI_IMAGE live in /etc/uct-ci/runner.env, which holds no secret.
[Unit]
Description=uct-ci: ephemeral single-job runner slots
After=uct-ci-firewall.service
Requires=uct-ci-firewall.service

[Service]
EnvironmentFile=/etc/uct-ci/runner.env
ExecStart=/usr/bin/python3 /srv/uct/kit/launcher.py serve --lane ${UCT_CI_LANE} --image ${UCT_CI_IMAGE} --slots ${UCT_CI_SLOTS}
Restart=always
RestartSec=30
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
