      "tools/note_import_repair.py",
      "app/package-lock.json",
      "app/package.json",
      "app/public/Darkpool-data.csv",
      "app/public/Indexes-data.csv",
      "app/public/flow-data.csv",
      "app/public/massive-card-logo.png",
      "app/scripts/build-cot-facts.mjs",
      "app/scripts/build-flow-facts.mjs",
      "app/src/components/chart/builder/authoring/crossContext.json",
      "app/src/components/chart/builder/authoring/patchSchema.json",
      "app/src/components/chart/builder/authoring/preflightRules.json",
      "app/src/components/chart/engine/ast/barIndexShift.js",
      "app/src/components/chart/engine/ast/budget.js",
      "app/src/components/chart/engine/ast/callExpansions.js",
      "app/src/components/chart/engine/ast/closedTable.json",
      "app/src/components/chart/engine/ast/conceptVocabulary.json",
      "app/src/components/chart/engine/ast/guardIdText.js",
      "app/src/components/chart/engine/ast/interpret.js",
      "app/src/components/chart/engine/ast/parse.js",
      "app/src/components/chart/engine/ast/pineRuntimeFrontend.js",
      "app/src/components/chart/engine/ast/sentence.js",
      "app/src/components/chart/engine/ast/symbolScope.json",
      "app/src/components/chart/engine/runtime/ir.js",
      "app/src/components/chart/engine/runtime/runtimeRepaint.json",
      "app/src/components/chart/engine/scriptEngineVersion.js",
      "app/src/components/chart/indicators.js",
      "app/src/components/chart/supportLoop/doorNameCoverage.json",
      "app/src/components/chart/supportLoop/pineBuiltins.json",
      "app/src/constants/quotes.json",
      "app/src/constants/setupGroups.js",
      "app/src/lib/marketClock/calendarCompact.js",
      "app/src/lib/marketClock/market_calendar.json",
      "app/src/lib/marketClock/sessionCalendar.js",
