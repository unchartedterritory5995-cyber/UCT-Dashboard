      "app/src/pages/cot/cotCompose.js",
      "app/src/pages/cot/cotDivergence.js",
      "app/src/pages/cot/cotFacts.js",
      "app/src/pages/cot/cotFactsEntry.js",
      "app/src/pages/cot/cotProxies.js",
      "app/src/pages/cot/cotRead.js",
      "app/src/pages/modelbook/setupCatalog.js",
      "app/src/pages/modelbook/setupPlaybooks.js",
      "app/src/pages/optionsFlow/flowBootstrap.js",
      "app/src/pages/optionsFlow/flowCompute.js",
      "app/src/pages/optionsFlow/flowFactsEntry.js",
      "app/src/pages/optionsFlow/flowSearchProduct.js",
      "app/src/pages/optionsFlow/flowTopPicksProduct.js",
      "app/src/utils/barsBackfill.js",
      "app/src/utils/barsIDB.js"
