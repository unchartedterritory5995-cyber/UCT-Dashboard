import TradingView/ta/7 as ta 

//@version=5
indicator(
 title="Kalman PSaR [BackQuant]", 
 shorttitle = "KPSaR [BackQuant]", 
 overlay = true,
 timeframe = "", 
 timeframe_gaps = true
 )

const string psar_string = "PSAR Settings"
const string kalman_string = "Kalman Settings"
const string ui = "UI Settings"
const string smooth = "Smoothing"
processNoise_kRoc     = input.float(0.03, title="Process Noise", step = 0.01, group = kalman_string)
measurementNoise_kRoc = input.float(3.0, title="Measurement Noise", group = kalman_string)

start = input.float(0.02, "Min Step", step = 0.01, group = psar_string)
max = input.float(0.1, "Max Step", step = 0.1, group = psar_string)
inc = input.float(0.02, "Acceleration", step = 0.01, group = psar_string)

smoothing = input.bool(true, "Use Smoothing?", group = smooth)
string maType = input.string("SMA", "Smoothing MA",options = ["SMA", "Hull", "Ema", "Wma", "Dema", "RMA", "LINREG", "TEMA"], group = smooth)
smooth_L = input.int(10, "Smoothing Period", group = smooth)

simple bool         paintCandles         = input.bool(true, "Paint candles according to Trend?", group = ui)
simple bool         show_sar             = input.bool(true, "Show PSaR on Chart?", group = ui)
color longColor  = input.color(#33ff00, "Long Color", group = ui, inline = "Col")
color shortColor = input.color(#ff0000, "Short Color", group = ui, inline = "Col")
// Indicator Calculation 
N_kRoc = 5
f_init(series float pricesource_kRoc) =>
    var float[] stateEstimate = array.new_float(N_kRoc, na)
    var float[] errorCovariance = array.new_float(N_kRoc, 100.0)
    if na(array.get(stateEstimate, 0))
        for i = 0 to N_kRoc-1
            array.set(stateEstimate, i, pricesource_kRoc)
            array.set(errorCovariance, i, 1.0)

    [stateEstimate, errorCovariance]

f_kalman(series float pricesource_kRoc, float []stateEstimate, float []errorCovariance, simple float processNoise_kRoc, simple float measurementNoise_kRoc) =>
    var float result = na

    // Prediction Step
    predictedStateEstimate = array.new_float(N_kRoc)
    predictedErrorCovariance = array.new_float(N_kRoc)
    for i = 0 to N_kRoc-1
        array.set(predictedStateEstimate, i, array.get(stateEstimate, i)) // Simplified prediction
        array.set(predictedErrorCovariance, i, array.get(errorCovariance, i) + processNoise_kRoc)
    
    kalmanGain = array.new_float(N_kRoc)
    for i = 0 to N_kRoc-1
        kg = array.get(predictedErrorCovariance, i) / (array.get(predictedErrorCovariance, i) + measurementNoise_kRoc)
        array.set(kalmanGain, i, kg)
        array.set(stateEstimate, i, array.get(predictedStateEstimate, i) + kg * (pricesource_kRoc - array.get(predictedStateEstimate, i)))
        array.set(errorCovariance, i, (1 - kg) * array.get(predictedErrorCovariance, i))
    
    result := array.get(stateEstimate, 0)
    result

kalman_PSaR(start, inc, max, simple float processNoise_kRoc, simple float measurementNoise_kRoc) => 

    [stateEstimate_close, errorCovarianc_close] = f_init(close)
    [stateEstimate_high, errorCovariance_high]  = f_init(high)
    [stateEstimate_low, errorCovariance_low]    = f_init(low)

    kalman_close = f_kalman(close, stateEstimate_close, errorCovarianc_close, processNoise_kRoc, measurementNoise_kRoc)
    kalman_high  = f_kalman(high , stateEstimate_high, errorCovariance_high, processNoise_kRoc, measurementNoise_kRoc )
    kalman_low   = f_kalman (low  , stateEstimate_low, errorCovariance_low, processNoise_kRoc, measurementNoise_kRoc  )

    // PSar calculation

    var float result = na
    var float maxMin = na
    var float acceleration = na
    var bool isBelow = na
    bool isFirstTrendBar = false
    
    if bar_index == 1
        if close > close[1]
            isBelow := true
            maxMin := kalman_high
            result := kalman_low[1]
        else
            isBelow := false
            maxMin := kalman_low
            result := kalman_high[1]
        isFirstTrendBar := true
        acceleration := start
    
    result := result + acceleration * (maxMin - result)
    
    if isBelow
        if result > low
            isFirstTrendBar := true
            isBelow := false
            result := math.max(kalman_high, maxMin)
            maxMin := kalman_low
            acceleration := start
    else
        if result < high
            isFirstTrendBar := true
            isBelow := true
            result := math.min(kalman_low, maxMin)
            maxMin := kalman_high
            acceleration := start
            
    if not isFirstTrendBar
        if isBelow
            if high > maxMin
                maxMin := kalman_high
                acceleration := math.min(acceleration + inc, max)
        else
            if kalman_low < maxMin
                maxMin := kalman_low
                acceleration := math.min(acceleration + inc, max)
    
    if isBelow
        result := math.min(result, kalman_low[1])
        if bar_index > 1
            result := math.min(result, kalman_low[2])
        
    else
        result := math.max(result, kalman_high[1])
        if bar_index > 1
            result := math.max(result, kalman_high[2])
    
    
    result


ma(src, len, type) =>
    switch type
        "SMA" => ta.sma(src, len)
        "Hull" => ta.hma(src, len)
        "Ema" => ta.ema(src, len)
        "Wma" => ta.wma(src, len)
        "Dema" => ta.dema(src, len)
        "RMA" => ta.rma(src, len)
        "LINREG"=> ta.linreg(src, len, 0)
        "TEMA" => ta.tema(src, len)

psar = kalman_PSaR(start, inc, max, processNoise_kRoc, measurementNoise_kRoc)
if smoothing == true
    psar:=ma(psar, smooth_L, maType)


psar_long  = close>psar
psar_short =close<psar
var Trend = 0
if psar_long 
    Trend := 1

if psar_short
    Trend := -1

// Colouring
var barColour = #ffffff
if Trend == 1 
    barColour := longColor
if Trend == -1
    barColour := shortColor

// Plotting
plot(
 show_sar ? psar : na, 
 "Kalman PSaR", 
 color = barColour,
 linewidth = 4
 )

barcolor(paintCandles ? barColour : na)


// Alert Conditions
alertcondition(ta.crossunder(psar,close), title="Kalman PSaR Long", message="Kalman PSaR Long {{exchange}}:{{ticker}}")
alertcondition(ta.crossover(psar,close), title="Kalman PSaR Short", message="Kalman PSaR Short {{exchange}}:{{ticker}}")

