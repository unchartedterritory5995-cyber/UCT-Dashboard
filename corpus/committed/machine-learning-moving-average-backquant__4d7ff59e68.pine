//@version=6
indicator(
 title="Machine Learning Moving Average [BackQuant]",
 overlay=true,
 max_lines_count=500,
 max_labels_count=500,
 max_boxes_count=500
 )

// INPUTS
const string grpFeatures = "Feature Engineering"
const string grpCluster = "Clustering Settings"
const string grpML = "ML Prediction"
const string grpVis = "Visual Settings"

// Feature Settings
int rsiLen = input.int(14, "RSI Length", group=grpFeatures, tooltip="Length of the Relative Strength Index (RSI) for momentum measurement.")
int cciLen = input.int(20, "CCI Length", group=grpFeatures, tooltip="Length of the Commodity Channel Index (CCI) for trend detection.")
int atrLen = input.int(14, "ATR Length", group=grpFeatures, tooltip="Length of the Average True Range (ATR) for volatility measurement.")
int volumeLen = input.int(20, "Volume MA Length", group=grpFeatures, tooltip="Length of the Moving Average (MA) for volume.")
int momentumLen = input.int(10, "Momentum Length", group=grpFeatures, tooltip="Length of the momentum indicator for price change.")
bool useRSI = input.bool(true, "Use RSI", group=grpFeatures, inline="f1", tooltip="Enable or disable the use of the RSI feature.")
bool useCCI = input.bool(true, "Use CCI", group=grpFeatures, inline="f1", tooltip="Enable or disable the use of the CCI feature.")
bool useATR = input.bool(true, "Use ATR", group=grpFeatures, inline="f2", tooltip="Enable or disable the use of the ATR feature.")
bool useVol = input.bool(true, "Use Volume", group=grpFeatures, inline="f2", tooltip="Enable or disable the use of Volume as a feature.")
bool useMom = input.bool(true, "Use Momentum", group=grpFeatures, inline="f3", tooltip="Enable or disable the use of Momentum as a feature.")

// Clustering Settings
int numClusters = input.int(3, "Number of Clusters", group=grpCluster, minval = 2, maxval = 3, tooltip="Select the number of clusters: 2 for Bull/Bear or 3 for Bull/Neutral/Bear clusters.")
int lookbackPeriod = input.int(500, "Lookback Period", minval=100, maxval=2000, group=grpCluster, tooltip="Period used to look back for historical data to calculate features.")
float lowerPercentile = input.float(10, "Lower Percentile", minval=1, maxval=40, group=grpCluster, inline="perc", tooltip="The lower percentile value used for clustering.")
float upperPercentile = input.float(90, "Upper Percentile", minval=60, maxval=99, group=grpCluster, inline="perc", tooltip="The upper percentile value used for clustering.")

// ML Prediction Settings
int predictionBars = input.int(5, "Prediction Horizon", minval=1, maxval=20, group=grpML, inline="pred", tooltip="Number of bars (time periods) to predict ahead.")
int trainingWindow = input.int(100, "Training Window", minval=50, maxval=500, group=grpML, inline="pred", tooltip="Window size used for training the machine learning model.")
string mlMethod = input.string("Weighted Average", "ML Method", ["Weighted Average", "Cluster Momentum", "Regime Transition"], group=grpML, tooltip="Method used for generating machine learning predictions.")

// Visual Settings
bool showNumbers = input.bool(true, "Show Prediction Numbers", group=grpVis, inline="plt", tooltip="Show the predicted price and percentage change.")
bool showConfidence = input.bool(true, "Show Confidence %", group=grpVis, inline="plt", tooltip="Show the confidence percentage for the prediction.")
bool showClusters = input.bool(true, "Show Cluster Zones", group=grpVis, inline="plt", tooltip="Show visual zones indicating different clusters.")
bool showMA = input.bool(true, "Show ML Moving Average", group=grpVis, inline="plt", tooltip="Show the machine learning moving average line.")
bool paintCandles = input.bool(true, "Paint candles by trend?", group=grpVis, tooltip="Color bars by clusters to visualize the trend (Bullish, Bearish, Neutral).")
bool showTbl = input.bool(true, "Show Table?", group=grpVis, inline="tbl", tooltip="Display a table with relevant cluster and prediction data.")
bool darkMode = input.bool(true, "Change text to black", group=grpVis, inline="tbl", tooltip="Enable dark mode for text color (light mode uses black text).")
color bullColor = input.color(#00ff00, "Bullish Color", group=grpVis, inline = "col", tooltip="Color to represent bullish cluster.")
color neutralColor = input.color(color.gray, "Neutral Color", group=grpVis, inline = "col", tooltip="Color to represent neutral cluster.")
color bearColor = input.color(#ff0000, "Bearish Color", group=grpVis, inline = "col", tooltip="Color to represent bearish cluster.")


// Helper functions
f_zScore(src, length) =>
    float mean = ta.sma(src, length)
    float stdev = ta.stdev(src, length)
    stdev > 0 ? (src - mean) / stdev : 0

f_getPercentile(arr, pct) =>
    int sz = array.size(arr)
    if sz == 0
        na
    else
        int idx = math.floor((sz - 1) * pct / 100)
        array.get(arr, idx)

f_normalize(val, minVal, maxVal) =>
    maxVal != minVal ? (val - minVal) / (maxVal - minVal) : 0.5

// FEATURE CALCULATION
float rsi = ta.rsi(close, rsiLen)
float rsiZ = f_zScore(rsi, lookbackPeriod)

float cci = ta.cci(close, cciLen)
float cciZ = f_zScore(cci, lookbackPeriod)

float atr = ta.atr(atrLen)
float atrNorm = atr / close * 100
float atrZ = f_zScore(atrNorm, lookbackPeriod)

float volRatio = volume / ta.sma(volume, volumeLen)
float volZ = f_zScore(volRatio, lookbackPeriod)

float momentum = (close - close[momentumLen]) / close[momentumLen] * 100
float momZ = f_zScore(momentum, lookbackPeriod)

// Composite feature (weighted average of enabled features)
float compositeFeature = 0.0
int featureCount = 0

if useRSI
    compositeFeature += rsiZ
    featureCount += 1
if useCCI
    compositeFeature += cciZ
    featureCount += 1
if useATR
    compositeFeature += atrZ
    featureCount += 1
if useVol
    compositeFeature += volZ
    featureCount += 1
if useMom
    compositeFeature += momZ
    featureCount += 1

compositeFeature := featureCount > 0 ? compositeFeature / featureCount : 0

// Percentile Clustering, Big thank you to @InvestorUnknown for the idea.
var array<float> featureHistory = array.new_float()

array.push(featureHistory, compositeFeature)
if array.size(featureHistory) > lookbackPeriod
    array.shift(featureHistory)

array<float> sortedFeatures = array.copy(featureHistory)
array.sort(sortedFeatures)

float lowerPct = f_getPercentile(sortedFeatures, lowerPercentile)
float upperPct = f_getPercentile(sortedFeatures, upperPercentile)
float midPct = ta.sma(compositeFeature, lookbackPeriod)

// Calculate cluster centers
float cluster0Center = math.avg(lowerPct, midPct)
float cluster1Center = numClusters == 3 ? midPct : math.avg(upperPct, midPct)
float cluster2Center = math.avg(upperPct, midPct)

array<float> clusterCenters = numClusters == 2 ? array.from(cluster0Center, cluster2Center) : array.from(cluster0Center, cluster1Center, cluster2Center)

// Assign current bar to nearest cluster
float minDist = 999999
int currentCluster = 0
float secondMinDist = 999999
int secondCluster = 0

for i = 0 to array.size(clusterCenters) - 1
    float dist = math.abs(compositeFeature - array.get(clusterCenters, i))
    
    if dist < minDist
        secondMinDist := minDist
        secondCluster := currentCluster
        minDist := dist
        currentCluster := i
    else if dist < secondMinDist
        secondMinDist := dist
        secondCluster := i

// Calculate cluster confidence (0-100%)
float clusterConfidence = secondMinDist > 0 ? (1 - minDist / (minDist + secondMinDist)) * 100 : 100

// Cluster Statistics & Tracking
var array<float> cluster0Returns = array.new_float()
var array<float> cluster1Returns = array.new_float()
var array<float> cluster2Returns = array.new_float()
var array<int> cluster0Bars = array.new_int()
var array<int> cluster1Bars = array.new_int()
var array<int> cluster2Bars = array.new_int()

// Track returns and bar indices for each cluster
float barReturn = (close - close[1]) / close[1] * 100

if currentCluster == 0
    array.push(cluster0Returns, barReturn)
    array.push(cluster0Bars, bar_index)
    if array.size(cluster0Returns) > trainingWindow
        array.shift(cluster0Returns)
        array.shift(cluster0Bars)
else if currentCluster == 1
    array.push(cluster1Returns, barReturn)
    array.push(cluster1Bars, bar_index)
    if array.size(cluster1Returns) > trainingWindow
        array.shift(cluster1Returns)
        array.shift(cluster1Bars)
else if currentCluster == 2
    array.push(cluster2Returns, barReturn)
    array.push(cluster2Bars, bar_index)
    if array.size(cluster2Returns) > trainingWindow
        array.shift(cluster2Returns)
        array.shift(cluster2Bars)

// Calculate average returns per cluster
float cluster0AvgReturn = array.size(cluster0Returns) > 0 ? array.avg(cluster0Returns) : 0
float cluster1AvgReturn = array.size(cluster1Returns) > 0 ? array.avg(cluster1Returns) : 0
float cluster2AvgReturn = array.size(cluster2Returns) > 0 ? array.avg(cluster2Returns) : 0

// ML 'Prediction'
float predictedReturn = 0.0
float predictionConfidence = 0.0

if mlMethod == "Weighted Average"
    // Weight predictions by cluster confidence
    predictedReturn := currentCluster == 0 ? cluster0AvgReturn :currentCluster == 1 ? cluster1AvgReturn :cluster2AvgReturn
    predictionConfidence := clusterConfidence

else if mlMethod == "Cluster Momentum"
    // Use rate of feature change within cluster
    float featureMomentum = ta.change(compositeFeature, 3)
    float baseReturn = currentCluster == 0 ? cluster0AvgReturn :currentCluster == 1 ? cluster1AvgReturn : cluster2AvgReturn
    predictedReturn := baseReturn * (1 + featureMomentum)
    predictionConfidence := math.min(clusterConfidence * (1 + math.abs(featureMomentum) / 10), 100)

else // Regime Transition
    // Predict based on likelihood of cluster transition
    float transitionProb = minDist / (minDist + secondMinDist)
    float currentReturn = currentCluster == 0 ? cluster0AvgReturn :currentCluster == 1 ? cluster1AvgReturn :cluster2AvgReturn
    float nextReturn = secondCluster == 0 ? cluster0AvgReturn :secondCluster == 1 ? cluster1AvgReturn :cluster2AvgReturn
    
    predictedReturn := currentReturn * (1 - transitionProb) + nextReturn * transitionProb
    predictionConfidence := 100 - transitionProb * 50

// Calculate predicted price
float predictedPrice = close * (1 + predictedReturn * predictionBars / 100)
float predictedChange = ((predictedPrice - close) / close) * 100

// ML Moving Average (adaptive based on cluster regime)
var float mlMA = close
float adaptiveAlpha = 2 / (predictionBars + 1)
float regimeMultiplier = currentCluster == 0 ? 0.5 : currentCluster == 1 ? 1.0 : 1.5
mlMA := mlMA + adaptiveAlpha * regimeMultiplier * (close - mlMA)

// Visuals
// Color coding based on cluster
color currentColor = currentCluster == 0 ? bearColor :currentCluster == 1 ? neutralColor : bullColor

// Plot ML Moving Average
plot(showMA ? mlMA : na, "ML MA", color=currentColor, linewidth=2)

// Plot cluster zones
if showClusters and barstate.islast
    int zoneWidth = 50
    
    box.new(bar_index - zoneWidth, array.get(clusterCenters, 0) * close / compositeFeature, bar_index, midPct * close / compositeFeature,bgcolor=color.new(bearColor, 90),border_color=color.new(bearColor, 50),border_width=1)
    
    if numClusters == 3
        box.new(bar_index - zoneWidth, midPct * close / compositeFeature,bar_index, array.get(clusterCenters, 2) * close / compositeFeature,bgcolor=color.new(neutralColor, 90),border_color=color.new(neutralColor, 50),border_width=1)

    box.new(bar_index - zoneWidth, (numClusters == 2 ? midPct : array.get(clusterCenters, 2)) * close / compositeFeature,bar_index, upperPct * close / compositeFeature,bgcolor=color.new(bullColor, 90),border_color=color.new(bullColor, 50),border_width=1)

// On-chart prediction labels with numbers
if barstate.islast and showNumbers
    string predText = str.tostring(predictedPrice, format.mintick) + "\n"
    predText += "(" + (predictedChange > 0 ? "+" : "") + str.tostring(predictedChange, "#.##") + "%)"
    
    if showConfidence
        predText += "\n" + str.tostring(predictionConfidence, "#") + "% conf"
    
    label.new(bar_index + predictionBars, predictedPrice,text=predText,style=label.style_label_left,color=color.new(currentColor, 20),textcolor=color.white,size=size.normal)
    
    // Draw projection line
    line.new(bar_index, close, bar_index + predictionBars, predictedPrice,color=color.new(currentColor, 30),width=2,style=line.style_dashed)

// Current cluster info label
if barstate.islast
    string clusterName = currentCluster == 0 ? "BEARISH" :currentCluster == 1 ? "NEUTRAL" :"BULLISH"
    
    string infoText = "Cluster: " + clusterName + "\n"
    infoText += "Confidence: " + str.tostring(clusterConfidence, "#") + "%\n"
    infoText += "Avg Return: " + str.tostring(predictedReturn, "#.##") + "%"
    
    label.new(bar_index, high,text=infoText,style=label.style_label_down,color=color.new(currentColor, 30),textcolor=color.white,size=size.small)

// Table
if barstate.islast and showTbl
    var table statsTable = table.new(position.top_right, 2, 12, frame_color=#ffffff, frame_width=1, border_color=color.new(color.gray, 60), border_width=1)

    table.cell(statsTable, 0, 0, "ML-MA CLUSTERING", text_color=darkMode ? color.white : color.black, text_size=size.normal)
    table.merge_cells(statsTable, 0, 0, 1, 0)

    string currentRegime = currentCluster == 0 ? "BEARISH" : currentCluster == 1 ? "NEUTRAL" : "BULLISH"
    table.cell(statsTable, 0, 1, "Current Regime", text_color=darkMode ? color.white : color.black, text_size=size.normal)
    table.cell(statsTable, 1, 1, currentRegime, text_color=currentColor, text_size=size.normal)

    table.cell(statsTable, 0, 2, "Confidence", text_color=darkMode ? color.white : color.black, text_size=size.normal)
    table.cell(statsTable, 1, 2, str.tostring(clusterConfidence, "#.#") + "%", text_color=currentColor, text_size=size.normal)

    table.cell(statsTable, 0, 3, "Predicted Price", text_color=darkMode ? color.white : color.black, text_size=size.normal)
    table.cell(statsTable, 1, 3, str.tostring(predictedPrice, format.mintick), text_color=currentColor, text_size=size.normal)

    table.cell(statsTable, 0, 4, "Predicted Change", text_color=darkMode ? color.white : color.black, text_size=size.normal)
    color changeColor = predictedChange > 0 ? bullColor : bearColor
    table.cell(statsTable, 1, 4, (predictedChange > 0 ? "+" : "") + str.tostring(predictedChange, "#.##") + "%", text_color=changeColor, text_size=size.normal)

    table.cell(statsTable, 0, 5, "Horizon", text_color=darkMode ? color.white : color.black, text_size=size.normal)
    table.cell(statsTable, 1, 5, str.tostring(predictionBars) + " bars", text_color=color.gray, text_size=size.normal)

    table.cell(statsTable, 0, 6, "Bear Cluster Avg", text_color=darkMode ? color.white : color.black, text_size=size.normal)
    table.cell(statsTable, 1, 6, str.tostring(cluster0AvgReturn, "#.##") + "%", text_color=bearColor, text_size=size.normal)

    if numClusters == 3
        table.cell(statsTable, 0, 7, "Neutral Cluster Avg", text_color=darkMode ? color.white : color.black, text_size=size.normal)
        table.cell(statsTable, 1, 7, str.tostring(cluster1AvgReturn, "#.##") + "%", text_color=neutralColor, text_size=size.normal)

    table.cell(statsTable, 0, 8, "Bull Cluster Avg", text_color=darkMode ? color.white : color.black, text_size=size.normal)
    table.cell(statsTable, 1, 8, str.tostring(cluster2AvgReturn, "#.##") + "%", text_color=bullColor, text_size=size.normal)

    table.cell(statsTable, 0, 9, "ML Method", text_color=darkMode ? color.white : color.black, text_size=size.normal)
    table.cell(statsTable, 1, 9, mlMethod, text_color=color.gray, text_size=size.normal)


// ALERTS
bool regimeChange = currentCluster != currentCluster[1]
bool bullishShift = currentCluster > currentCluster[1]
bool bearishShift = currentCluster < currentCluster[1]

alertcondition(regimeChange, "Regime Change", "ML Cluster regime changed on {{exchange}}:{{ticker}}")
alertcondition(bullishShift, "Bullish Regime", "ML Cluster shifted to bullish regime on {{exchange}}:{{ticker}}")
alertcondition(bearishShift, "Bearish Regime", "ML Cluster shifted to bearish regime on {{exchange}}:{{ticker}}")
alertcondition(predictionConfidence > 80, "High Confidence Prediction", "High confidence prediction on {{exchange}}:{{ticker}}")

// Color bars by cluster
barcolor(paintCandles?currentColor:na)
