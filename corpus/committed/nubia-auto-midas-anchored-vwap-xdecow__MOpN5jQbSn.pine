ma4_top_p1 = plot(ma4_top_visible or md_show ? ma4_top_high : na, color=ma4_top_color, linewidth=6, style=plot.style_linebr, title='#4 Highest AVWAP')
ma4_top_p2 = plot(ma4_top_visible or md_show ? ma4_top_mid : na, color=na, editable=false)
fill(ma4_top_p1, ma4_top_p2, ma4_top_color, title='#4 Highest background')

ma4_bot_p1 = plot(ma4_bot_visible or md_show ? ma4_bot_low : na, color=ma4_bot_color, linewidth=6, style=plot.style_linebr, title='#4 Lowest AVWAP')
