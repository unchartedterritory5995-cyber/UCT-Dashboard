    tooltip="Pivot confirmed when price reverses by ATR × this value.")
float minSwingATR = input.float(0.8, "Min Swing Size (ATR multiple)",        minval=0.0, maxval=20.0, step=0.1, group=gSwg,
    tooltip="Swing legs smaller than ATR × this are discarded. Set 0 to disable.")

