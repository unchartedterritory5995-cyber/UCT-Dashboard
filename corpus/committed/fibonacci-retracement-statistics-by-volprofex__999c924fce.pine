float  htfMinSwingATR = input.float(1.5, "HTF Min Swing Size (ATR ×)",       minval=0.0, maxval=20.0, step=0.1, group=gHTF, inline="htfDev",
    tooltip="ATR multiplier for HTF pivot reversals and minimum swing leg size. Set Min Swing to 0 to disable.",
