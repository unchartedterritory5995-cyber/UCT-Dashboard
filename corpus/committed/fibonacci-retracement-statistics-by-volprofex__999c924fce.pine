//@version=6
indicator("Fibonacci Retracement Statistics by VolProfex", "VPX Fib", overlay=true, max_lines_count=500, max_boxes_count=500, max_labels_count=500)
// VPX_Fib_version = v1.122

// =====================================================
// Types
// =====================================================
type pivot
    int   barIndex
    float price
    bool  isHigh
    int   time

type trend
    int   startIdx
    int   endIdx
    int   startTime
    int   endTime
    float startPrice
    float endPrice
    bool  isUptrend
    float retracePct
    int   swingNumber

type htfSwing
    int   startTime
    int   endTime
    int   startBar
    int   endBar
    float highPrice
    float lowPrice
    bool  isBullish

type twInterval
    int   startTime
    int   endTime
    float highPrice
    float lowPrice

// =====================================================
// Input groups
// =====================================================
string gSwg  = "══════ SWING ENGINE ═════"
string gHTF  = "══════ HTF CONTEXT ══════"
string gFilt = "═════ SWING FILTERS ═════"
string gFib  = "════ FIB RETRACEMENTS ═══"
string gCnt  = "═════ FIB EXTENSIONS ════"
