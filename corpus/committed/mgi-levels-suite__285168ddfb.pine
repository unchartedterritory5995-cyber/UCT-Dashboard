//When lines are first created, the below values are used for the offset
initialLineOffset = time + timeframe.multiplier * (timeframe.in_seconds()*1000)

/////////////////////
///     UDTs     ////
/////////////////////
//Label Settings UDT
type ValueLineSettings
    bool   showLabel    = true
    int    labelOffset  = 0
    color  labelColor   = color.white
    string textSize     = size.normal
    string labelText    = ""
    bool   showPrice    = true
    bool   showLine     = true
    int    lineWidth    = 1
    color  lineColor    = color.white
    string extendOption = extend.none
    string lineStyle    = line.style_solid

//Creating a UDT to capture all relevant information for a given level
type ValueLine
    float price          = 0
    int   barIndex       = bar_index
    int   barTime        = time
    label llabel         = na
    line  level          = na
    bool  testedInFuture = false

//UDT created to calculate VWAP
type VWAP
    float volumePriceSum    = 0
    float volume            = 0
    float value             = 0
    float priceSum          = 0
    int   index             = 0
    float varianceNumerator = 0 
    float stdDev            = 0

///////////////////////////////////////////////////
////        Function Declaration        ///////////
///////////////////////////////////////////////////
// {
getLineStyle(string styleOption) =>
    lineStyleOption = switch styleOption
        "dotted (┈)" => line.style_dotted
        "dashed (╌)" => line.style_dashed
        "solid (─)"  => line.style_solid
    lineStyleOption
        
getLineExtend(string extendOption) =>  
    extendLineOption = switch extendOption 
        "Right" => extend.right
        "Both"  => extend.both
        "None"  => extend.none
    extendLineOption

getLabelTextSize(string labelTextSize) =>
    switch labelTextSize
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge

// SessionHigh() returns the highest price during the specified 
// session, optionally corrected for the given time zone.
// Returns "na" when the session hasn"t started or isn"t on the chart.
SessionHigh(sessionTime, sessionTimeZone=syminfo.timezone) =>
    var bool sessionInfo = (syminfo.session == session.regular and 
                     (syminfo.type == "stock" or syminfo.type == "fund" or syminfo.type == "dr"))
    dayOfWeek = dayofweek(time, sessionTimeZone)
    insideSession = not na(time(timeframe.period, sessionTime, sessionTimeZone))
    newDayofWeek  = sessionInfo and (dayOfWeek != dayOfWeek[1])

    var float sessionHighPrice = na
    var int   sessionHighBarIndex = na
    var int   sessionHighTime     = na

    if insideSession and (not insideSession[1] or newDayofWeek)
        sessionHighPrice := high
        sessionHighBarIndex := bar_index
        sessionHighTime     := time
    else if insideSession
        sessionHighPrice := math.max(sessionHighPrice, high)
        if sessionHighPrice != sessionHighPrice[1]
            sessionHighBarIndex := bar_index
            sessionHighTime     := time
    
    [sessionHighPrice, sessionHighBarIndex, sessionHighTime]

// SessionLow() returns the lowest price during the given session,
// optionally corrected for the specified time zone.
// Returns "na" when the session hasn"t started or isn"t on the chart.
SessionLow(sessionTime, sessionTimeZone=syminfo.timezone) =>
    var bool sessionInfo = (syminfo.session == session.regular and 
                     (syminfo.type == "stock" or syminfo.type == "fund" or syminfo.type == "dr"))
    dayOfWeek = dayofweek(time, sessionTimeZone)
    insideSession = not na(time(timeframe.period, sessionTime, sessionTimeZone))
    newDayofWeek  = sessionInfo and (dayOfWeek != dayOfWeek[1])
    
    var float sessionLowPrice    = na
    var int   sessionLowBarIndex = na
    var int   sessionLowTime     = na

    if insideSession and (not insideSession[1] or newDayofWeek)
        sessionLowPrice := low
        sessionLowBarIndex := bar_index
        sessionLowTime     := time
    else if insideSession
        sessionLowPrice := math.min(sessionLowPrice, low)
        if sessionLowPrice != sessionLowPrice[1]
            sessionLowBarIndex := bar_index
            sessionLowTime     := time

    [sessionLowPrice, sessionLowBarIndex, sessionLowTime]

// SessionOpen() returns the lowest price during the given session,
// optionally corrected for the specified time zone.
// Returns "na" when the session hasn"t started or isn"t on the chart.
SessionOpen(sessionTime, sessionTimeZone=syminfo.timezone) =>
    var bool sessionInfo = (syminfo.session == session.regular and 
                     (syminfo.type == "stock" or syminfo.type == "fund" or syminfo.type == "dr"))
    dayOfWeek = dayofweek(time, sessionTimeZone)
    insideSession = not na(time(timeframe.period, sessionTime, sessionTimeZone))
    newDayofWeek  = sessionInfo and (dayOfWeek != dayOfWeek[1])
    
    var float sessionOpenPrice    = na

    if insideSession and (not insideSession[1] or newDayofWeek)
        sessionOpenPrice := open

    sessionOpenPrice

// NewMonth() returns a boolean if the next trading session is the start of a new month when using extended hours charts
// optionally corrected for the specified time zone.
NewMonth(int timeInput, sessionTimeZone=syminfo.timezone) =>
    bool newMonth = na
    dayOfWeek  = dayofweek(timeInput, sessionTimeZone)
    dayOfMonth = dayofmonth(timeInput, sessionTimeZone)
    monthNum   = month(timeInput, sessionTimeZone)
    numDaysInMonth = switch monthNum
        1 => 31
        2 => year(timeInput, sessionTimeZone) % 4 == 0 ? 29 : 28
        3 => 31
        4 => 30
        5 => 31
        6 => 30
        7 => 31
        8 => 31
        9 => 30
        10 => 31
        11 => 30
        12 => 31

    //Condiitonal statment to deal with friday session being the end of the month
    if dayOfWeek == dayofweek.friday
        //if day of week is friday and days in month is 31 and current day of month is 29
        //then a new month at the start of next week"s session
        if numDaysInMonth == 31 and (dayOfMonth >= 29 or (monthNum == 5 and dayOfMonth == 28))
            newMonth := true
        else if numDaysInMonth == 30 and dayOfMonth >= 28
            newMonth := true
        else if numDaysInMonth == 29 and dayOfMonth >= 27
            newMonth := true
        else if numDaysInMonth == 28 and dayOfMonth >= 26
            newMonth := true
    //On any other day (i.e. Monday - Thursday) and the days of the month is equal to the number of days in the month 
    //then the next session will be a new month
    else if dayOfMonth == numDaysInMonth
        newMonth := true
    else 
        newMonth := false
   
    newMonth

checkForTestedLevels(array<ValueLine> prevClose_Arr, array<ValueLine> prevOpen_Arr , array<ValueLine> prevHigh_Arr, array<ValueLine> prevLow_Arr, float sessHigh, float sessLow) =>
    if prevClose_Arr.size() > 0 and prevOpen_Arr.size() > 2 and prevHigh_Arr.size() > 0 and prevLow_Arr.size() > 0
        for i = 0 to prevClose_Arr.size() - 1
            closeLine       = prevClose_Arr.get(i)
            openLine        = prevOpen_Arr.get(i)
            highLine        = prevHigh_Arr.get(i)
            lowLine         = prevLow_Arr.get(i)
            prevSessionLow  = sessLow
            prevSessionHigh = sessHigh 

            //Check if previous close lines have been traded through
            if prevSessionLow < closeLine.price and prevSessionHigh > closeLine.price and closeLine.testedInFuture == false
                closeLine.testedInFuture := true
            if prevSessionLow < openLine.price and prevSessionHigh > openLine.price and openLine.testedInFuture == false
                openLine.testedInFuture := true
            //Check for if previous high lines have been tested by the last session"s highs
            if prevSessionHigh > highLine.price and highLine.testedInFuture == false   
                highLine.testedInFuture := true
            //Check for if previous low lines have been tested by the last session"s lows
            if prevSessionLow < lowLine.price and lowLine.testedInFuture == false
                lowLine.testedInFuture := true 

//ValueLine Methods
method resetLine(ValueLine valueLine, _price = open, _barIndex = bar_index, _barTime = time) =>
    valueLine.llabel.delete()
    valueLine.level.delete()
    valueLine.price    := _price
    valueLine.barIndex := _barIndex
    valueLine.barTime  := _barTime

method deepCopy(ValueLine valueLine) =>
    ValueLine.new(price    = valueLine.price, 
                  barIndex = valueLine.barIndex, 
                  barTime  = valueLine.barTime, 
                  llabel   = valueLine.llabel.copy(), 
                  level    = valueLine.level.copy())

method updateIntraDayLine(ValueLine valueLine, ValueLineSettings settings) =>
    valueLine_Name    = settings.labelText + (settings.showPrice ? ": " + str.tostring(valueLine.price, format.mintick) : "")
    if na(valueLine.llabel)
        valueLine.llabel := settings.showLabel ? label.new(
                             x         = time(timeframe.period, -settings.labelOffset), 
                             y         = valueLine.price, 
                             text      = valueLine_Name, 
                             xloc      = xloc.bar_time, 
                             textcolor = settings.labelColor,  
                             textalign = text.align_left, 
                             style     = label.style_none, 
                             size      = settings.textSize) : na
    valueLine.llabel.set_x(time(timeframe.period, -settings.labelOffset))
    valueLine.llabel.set_y(valueLine.price)
    valueLine.llabel.set_text(valueLine_Name)
    if na(valueLine.level)
        valueLine.level  := settings.showLine ? line.new(
                             x1     = valueLine.barTime, 
                             y1     = valueLine.price, 
                             x2     = initialLineOffset, 
                             y2     = valueLine.price, 
                             xloc   = xloc.bar_time, 
                             extend = settings.extendOption, 
                             color  = settings.lineColor,
                             style  = settings.lineStyle, 
                             width  = settings.lineWidth) : na
    valueLine.level.set_x1(valueLine.barTime)
    valueLine.level.set_x2(time(timeframe.period, -settings.labelOffset))
    valueLine.level.set_y1(valueLine.price)
    valueLine.level.set_y2(valueLine.price)

//Value Line Array Methods
method addValueLine(array<ValueLine> ValueLines, ValueLine valueLine, ValueLineSettings settings) =>
    valueLine_Name    = settings.labelText + (settings.showPrice ? ": " + str.tostring(valueLine.price, format.mintick) : "")
    valueLine.llabel.delete()
    valueLine.level.delete()
    valueLine.llabel  := settings.showLabel ? label.new(
                         x         = time(timeframe.period, -settings.labelOffset),
                         y         = valueLine.price, 
                         text      = valueLine_Name, 
                         xloc      = xloc.bar_time, 
                         textcolor = settings.labelColor,  
                         textalign = text.align_left, 
                         style     = label.style_none, 
                         size      = settings.textSize) : na
    valueLine.level   := settings.showLine ? line.new(
                         x1     = valueLine.barTime, 
                         y1     = valueLine.price, 
                         x2     = time(timeframe.period, -settings.labelOffset), 
                         y2     = valueLine.price, 
                         xloc   = xloc.bar_time,
                         extend = settings.extendOption, 
                         color  = settings.lineColor,
                         style  = settings.lineStyle, 
                         width  = settings.lineWidth) : na
    ValueLines.push(valueLine)

method updateLines(array<ValueLine> ValueLines, int numLines, bool showOlderLabels, int labelOffset, bool saveUntestedLines = false, bool showInactivePositions = false) =>
    sizeArr           = ValueLines.size()

    if sizeArr > 0
        //Remove any line that is still stored beyond the numLines value
        //also update label locations and lines locations of all but current line
        for i = sizeArr - 1 to 0  
            valueLine = ValueLines.get(i)

            if saveUntestedLines == true
                if valueLine.testedInFuture == true
                    if showInactivePositions
                        valueLine.level.set_extend(extend.none)
                        valueLine.llabel.delete()
                    else
                        valueLine.level.delete()
                        valueLine.llabel.delete()     
                else if valueLine.testedInFuture == false
                    if i < sizeArr - 1
                        valueLine.level.set_xloc(x1=valueLine.barTime, x2=time, xloc=xloc.bar_time )
                        valueLine.llabel.set_x(time(timeframe.period, -labelOffset))
                        if not showOlderLabels
                            label.delete(valueLine.llabel)
                    else if i == sizeArr - 1
                        valueLine.level.set_xloc(x1=valueLine.barTime, x2=time, xloc=xloc.bar_time)
                        valueLine.llabel.set_x(time(timeframe.period, -labelOffset))
            else if saveUntestedLines == false  
                //if lines in array go above what user wants on screen, delete lines and labels for that valueline
                if i < sizeArr - numLines
                    label.delete(valueLine.llabel)
                    line.delete(valueLine.level)
                //Update prior line to stop at the previous bar
                else if i == sizeArr - 2
                    valueLine.level.set_x2(time[1])
                    valueLine.llabel.set_x(time(timeframe.period, -labelOffset))
                    if not showOlderLabels
                        valueLine.level.set_extend(extend.none)
                        label.delete(valueLine.llabel)
                else if i == sizeArr - 1
                    valueLine.level.set_xloc(x1=valueLine.barTime, x2=time(timeframe.period, -labelOffset), xloc=xloc.bar_time )
                    valueLine.llabel.set_x(time(timeframe.period, -labelOffset))

method deleteLines(array<ValueLine> ValueLines, int maxValueLines) =>
    sizeArr = ValueLines.size()
    if sizeArr > 0
        //Check if number of values in ValueLine array is greater than the max allowed
        if sizeArr > maxValueLines
            //If level is not na, shift out value and then delete line
            firstEntry = ValueLines.shift()

            if not na(firstEntry.level)
                line.delete(firstEntry.level)
            if not na(firstEntry.llabel)
                label.delete(firstEntry.llabel)

//VWAP Methods
method calculateVWAP(VWAP vwap, bool inSession, bool reset) =>
    //Calculate VWAP
    if reset
        vwap.volumePriceSum    := 0
        vwap.volume            := 0
        vwap.value             := 0
        vwap.priceSum          := 0
        vwap.index             := 0
        vwap.varianceNumerator := 0
        vwap.stdDev            := 0

    if inSession
        vwap.volumePriceSum    := vwap.volumePriceSum + (hlc3 * volume)
        vwap.volume            := vwap.volume + volume
        vwap.value             := vwap.volumePriceSum/vwap.volume
        vwap.priceSum          := vwap.priceSum + hlc3
        vwap.index             := vwap.index + 1
        vwap.varianceNumerator := nz(vwap.varianceNumerator + math.pow(hlc3 - (vwap.priceSum / vwap.index), 2))
    
    //Calculate these values no matter what
    vwap.stdDev := math.sqrt(nz(vwap.varianceNumerator / (vwap.index - 1)))
// }

