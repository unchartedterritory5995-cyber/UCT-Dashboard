// } End of Monthly settings

//Timeframe variables
lastBarDayOfWeek     = dayofweek(time, "America/New_York")[1] 
currBarDayOfWeek     = dayofweek(time, "America/New_York")
endTimeofRTHRange    = str.substring(rthRangeSess, 0, 4) //Gets end time of rth session range
insideOpeningRange   = not na(time(timeframe.period, openRangeSess, "America/New_York"))
insideIBRange        = not na(time(timeframe.period, IBSess       , "America/New_York"))
newOpenRangeSess     = insideOpeningRange    and not insideOpeningRange[1]
endOfOpenRangeSess   = insideOpeningRange[1] and not insideOpeningRange
newIBRangeSess       = insideIBRange         and not insideIBRange[1]
endOfIBRangeSess     = insideIBRange[1]      and not insideIBRange
newDay               = dayofweek(time, "America/New_York") != lastBarDayOfWeek
ONSessionRange       = syminfo.type == "stock" or syminfo.type == "fund" or syminfo.type == "dr"
                         ? "1600-" + endTimeofRTHRange
                         : "1800-" + endTimeofRTHRange
insideONSession      = not na(time(timeframe.period, ONSessionRange, "America/New_York"))
insideUSSession      = not na(time(timeframe.period, rthRangeSess, "America/New_York"))
lonOpenSession       = not na(time(timeframe.period, "0300-0301", "America/New_York"))
lonCloseSession      = not na(time(timeframe.period, "1130-1131", "America/New_York"))
midnightOpenSess     = not na(time(timeframe.period, "0000-0001", "America/New_York"))
sessClose5PM         = not na(time(timeframe.period, "1659-1700", "America/New_York"))
newUSSession         = insideUSSession     and not insideUSSession[1]
endOf5PMSession      = sessClose5PM[1]     and not sessClose5PM
endOfUSSession       = insideUSSession[1]  and not insideUSSession
newLonSession        = lonOpenSession      and not lonOpenSession[1]
endLonSession        = lonCloseSession     and not lonCloseSession[1]
newMidnightSession   = midnightOpenSess    and not midnightOpenSess[1]
newONsession         = insideONSession     and not insideONSession[1]
shortUSSession       = (newONsession and (syminfo.type == "futures" and time[1] == time(timeframe.period, "1300-1301", "America/New_York")[1]))
                         or (session.ispostmarket and not na(time(timeframe.period, "1300-1301", "America/New_York")))
rthOnlyChart         = syminfo.session == session.regular and (syminfo.type == "stock" or syminfo.type == "fund" or syminfo.type == "dr")
rthOpenSess          = rthOnlyChart ? newDay : newUSSession

//Week Holiday Filters
goodFridayWeek    = (lastBarDayOfWeek == dayofweek.thursday and 
                             (currBarDayOfWeek == dayofweek.sunday or currBarDayOfWeek == dayofweek.monday)
                             and timeframe.change("D"))
shortenedSessWeek = (lastBarDayOfWeek == dayofweek.friday and shortUSSession)

//Weekly Time Variables
newWeekRTH           = lastBarDayOfWeek > currBarDayOfWeek
newWeekETH           = (currBarDayOfWeek == dayofweek.friday and endOfUSSession) or
                         shortenedSessWeek or
                         goodFridayWeek
newWeek              = rthOnlyChart ? newWeekRTH : newWeekETH


//Monthly Holiday Filters
goodFridayMonth = (lastBarDayOfWeek == dayofweek.thursday and 
                     (currBarDayOfWeek == dayofweek.sunday or currBarDayOfWeek == dayofweek.monday)
                     and timeframe.change("D"))
//Monthly Time Variables
newMonthRTH          = dayofmonth(time, "America/New_York")[1] > dayofmonth(time, "America/New_York")
newMonthETH          = (NewMonth(time) and endOfUSSession) or goodFridayMonth
newMonth             = rthOnlyChart ? newMonthRTH : newMonthETH

//Determines RTH vs. ETH for futures charts
//regardless of having RTH or ETH selected
simple bool futuresRTH    = syminfo.type == "futures" and syminfo.session == "us_regular"

//Value Lines to keep track of Session Open, Daily, Weekly, Monthly High/Lows
var ValueLine rthOpen       = ValueLine.new()
var ValueLine currDayHigh   = ValueLine.new()
var ValueLine currDayLow    = ValueLine.new()
var ValueLine prevWeekHigh  = ValueLine.new()
var ValueLine prevWeekLow   = ValueLine.new()
var ValueLine prevMonthHigh = ValueLine.new()
var ValueLine prevMonthLow  = ValueLine.new()

//Array Initialization
var ORHigh_Arr              = array.new<ValueLine>(1, ValueLine.new())
var ORLow_Arr               = array.new<ValueLine>(1, ValueLine.new())
var ORMid_Arr               = array.new<ValueLine>(1, ValueLine.new())
var IBHigh_Arr              = array.new<ValueLine>(1, ValueLine.new())
var IBLow_Arr               = array.new<ValueLine>(1, ValueLine.new())
var IBMid_Arr               = array.new<ValueLine>(1, ValueLine.new())
var prevHigh_Arr            = array.new<ValueLine>(2, ValueLine.new())
var prevLow_Arr             = array.new<ValueLine>(2, ValueLine.new())
var prevOpen_Arr            = array.new<ValueLine>(2, ValueLine.new())
var prev50HL_Arr            = array.new<ValueLine>(1, ValueLine.new())
var prev50OC_Arr            = array.new<ValueLine>(1, ValueLine.new())
var t2Open_Arr              = array.new<ValueLine>(1, ValueLine.new())
var t2Close_Arr             = array.new<ValueLine>(1, ValueLine.new())
var t2High_Arr              = array.new<ValueLine>(1, ValueLine.new())
var t2Low_Arr               = array.new<ValueLine>(1, ValueLine.new())
var prevClose_Arr           = array.new<ValueLine>(2, ValueLine.new())
var prev5PMClose_Arr        = array.new<ValueLine>(1, ValueLine.new())
var prevDayVWAP_Arr         = array.new<ValueLine>(1, ValueLine.new())
var prevDayVWAP_LBand1_Arr  = array.new<ValueLine>(1, ValueLine.new())
var prevDayVWAP_UBand1_Arr  = array.new<ValueLine>(1, ValueLine.new())
var prevDayVWAP_LBand2_Arr  = array.new<ValueLine>(1, ValueLine.new())
var prevDayVWAP_UBand2_Arr  = array.new<ValueLine>(1, ValueLine.new())
var prevDayVWAP_LBand3_Arr  = array.new<ValueLine>(1, ValueLine.new())
var prevDayVWAP_UBand3_Arr  = array.new<ValueLine>(1, ValueLine.new())
var globexOpen_Arr          = array.new<ValueLine>(1, ValueLine.new())
var londonOpen_Arr          = array.new<ValueLine>(1, ValueLine.new())
var londonClose_Arr         = array.new<ValueLine>(1, ValueLine.new())
var midnightOpen_Arr        = array.new<ValueLine>(1, ValueLine.new())
var onHigh_Arr              = array.new<ValueLine>(1, ValueLine.new())
var onLow_Arr               = array.new<ValueLine>(1, ValueLine.new())

var prevWeekHigh_Arr        = array.new<ValueLine>(1, ValueLine.new())
var prevWeekLow_Arr         = array.new<ValueLine>(1, ValueLine.new())
var prevWeek50HL_Arr        = array.new<ValueLine>(1, ValueLine.new())
var prevWeek50OC_Arr        = array.new<ValueLine>(1, ValueLine.new())
var rthWeekOpen_Arr         = array.new<ValueLine>(2, ValueLine.new())
var prevWeekClose_Arr       = array.new<ValueLine>(1, ValueLine.new())
var prevWeekVWAP_Arr        = array.new<ValueLine>(1, ValueLine.new())
var prevWeekVWAP_LBand1_Arr = array.new<ValueLine>(1, ValueLine.new())
var prevWeekVWAP_UBand1_Arr = array.new<ValueLine>(1, ValueLine.new())
var prevWeekVWAP_LBand2_Arr = array.new<ValueLine>(1, ValueLine.new())
var prevWeekVWAP_UBand2_Arr = array.new<ValueLine>(1, ValueLine.new())
var prevWeekVWAP_LBand3_Arr = array.new<ValueLine>(1, ValueLine.new())
var prevWeekVWAP_UBand3_Arr = array.new<ValueLine>(1, ValueLine.new())

var prevMonthHigh_Arr        = array.new<ValueLine>(1, ValueLine.new())
var prevMonthLow_Arr         = array.new<ValueLine>(1, ValueLine.new())
var prevMonth50HL_Arr        = array.new<ValueLine>(1, ValueLine.new())
var prevMonth50OC_Arr        = array.new<ValueLine>(1, ValueLine.new())
var rthMonthOpen_Arr         = array.new<ValueLine>(2, ValueLine.new())
var prevMonthClose_Arr       = array.new<ValueLine>(1, ValueLine.new())
var prevMonthVWAP_Arr        = array.new<ValueLine>(1, ValueLine.new())
var prevMonthVWAP_LBand1_Arr = array.new<ValueLine>(1, ValueLine.new())
var prevMonthVWAP_UBand1_Arr = array.new<ValueLine>(1, ValueLine.new())
var prevMonthVWAP_LBand2_Arr = array.new<ValueLine>(1, ValueLine.new())
var prevMonthVWAP_UBand2_Arr = array.new<ValueLine>(1, ValueLine.new())
var prevMonthVWAP_LBand3_Arr = array.new<ValueLine>(1, ValueLine.new())
var prevMonthVWAP_UBand3_Arr = array.new<ValueLine>(1, ValueLine.new())

//VWAP Variables
var VWAP vwapMonthly  = VWAP.new()
var VWAP vwapWeekly   = VWAP.new()
var VWAP vwapDaily    = VWAP.new()

//Opening Range Calculations
[ORsessionHighPrice, ORsessionHighBarIndex, ORsessionHighTime] = request.security_lower_tf(ticker.modify(syminfo.tickerid, session.extended), use30STimeFrame ? "30S" : "1", SessionHigh(openRangeSess, "America/New_York"))
[ORsessionLowPrice , ORsessionLowBarIndex, ORsessionLowTime]   = request.security_lower_tf(ticker.modify(syminfo.tickerid, session.extended), use30STimeFrame ? "30S" : "1", SessionLow(openRangeSess, "America/New_York"))

//IB Calculations
[IBsessionHighPrice, IBsessionHighBarIndex, IBsessionHighTime] = request.security_lower_tf(ticker.modify(syminfo.tickerid, session.extended), use30STimeFrame ? "30S" : "1", SessionHigh(IBSess, "America/New_York") )
[IBsessionLowPrice , IBsessionLowBarIndex, IBsessionLowTime]   = request.security_lower_tf(ticker.modify(syminfo.tickerid, session.extended), use30STimeFrame ? "30S" : "1", SessionLow(IBSess, "America/New_York"))

//RTH High Calculations
[sessionHighPrice, sessionHighBarIndex, sessionHighTime] = SessionHigh("0930-1600", "America/New_York")
[sessionLowPrice , sessionLowBarIndex, sessionLowTime]   = SessionLow("0930-1600", "America/New_York")

//Overnight Calculations
[ONsessionHighPrice, ONsessionHighBarIndex, ONsessionHighTime] = SessionHigh(ONSessionRange, "America/New_York")
[ONsessionLowPrice, ONsessionLowBarIndex , ONsessionLowTime]   = SessionLow(ONSessionRange, "America/New_York")

//Overnight Levels when an RTH Chart is being shown need to be gathered via request secutiry function with extended hours checked
[ONsessionHighPrice_RS, ONsessionHighBarIndex_RS, ONsessionHighTime_RS] = request.security(ticker.modify(syminfo.tickerid, session.extended), "30", SessionHigh(ONSessionRange, "America/New_York"), lookahead=barmerge.lookahead_on)
[ONsessionLowPrice_RS, ONsessionLowBarIndex_RS, ONsessionLowTime_RS]    = request.security(ticker.modify(syminfo.tickerid, session.extended), "30", SessionLow(ONSessionRange, "America/New_York"), lookahead=barmerge.lookahead_on)
globexOpenPrice_RS   = request.security(syminfo.tickerid, "D", open, lookahead=barmerge.lookahead_on)
londonOpenPrice_RS   = request.security(ticker.modify(syminfo.tickerid, session.extended), "30", SessionOpen("0300-0301", "America/New_York"), lookahead=barmerge.lookahead_on)
midnightOpenPrice_RS = request.security(ticker.modify(syminfo.tickerid, session.extended), "30", SessionOpen("0000-0001", "America/New_York"), lookahead=barmerge.lookahead_on)
prev5PMClosePrice_RS = request.security(ticker.modify(syminfo.tickerid, session.extended), "D", barstate.isconfirmed ? close : close[1], lookahead=barmerge.lookahead_on)

//Logic for plotting Opening Range
if newOpenRangeSess
    ORHigh_Arr.addValueLine(ValueLine.new(0, bar_index, time), ORHighSettings)
    ORLow_Arr.addValueLine(ValueLine.new(1.0E16, bar_index, time), ORLowSettings)
    ORMid_Arr.addValueLine(ValueLine.new(hl2, bar_index, time), ORMidSettings)

    updateLines(ORHigh_Arr , numDailyPeriods, false, labeloffsetDaily)
    updateLines(ORLow_Arr  , numDailyPeriods, false, labeloffsetDaily)
    updateLines(ORMid_Arr  , numDailyPeriods, false, labeloffsetDaily)
    deleteLines(ORHigh_Arr , numDailyPeriods)
    deleteLines(ORLow_Arr  , numDailyPeriods)
    deleteLines(ORMid_Arr  , numDailyPeriods)

if newIBRangeSess
    IBHigh_Arr.addValueLine(ValueLine.new(0, bar_index, time), IBHighSettings)
    IBLow_Arr.addValueLine(ValueLine.new(1.0E16, bar_index, time), IBLowSettings)
    IBMid_Arr.addValueLine(ValueLine.new(hl2, bar_index, time), IBMidSettings)

    updateLines(IBHigh_Arr , numDailyPeriods, false, labeloffsetDaily)
    updateLines(IBLow_Arr  , numDailyPeriods, false, labeloffsetDaily)
    updateLines(IBMid_Arr  , numDailyPeriods, false, labeloffsetDaily)
    deleteLines(IBHigh_Arr , numDailyPeriods)
    deleteLines(IBLow_Arr  , numDailyPeriods)
    deleteLines(IBMid_Arr  , numDailyPeriods)

if insideOpeningRange and barstate.isconfirmed
    //Use last value in OR valueline arrays and update them if a new high or low is made during the OR session
    currORHigh = ORHigh_Arr.last()
    currORLow  = ORLow_Arr.last()
    currORMid  = ORMid_Arr.last()

    if currORHigh.price < ORsessionHighPrice.max()
        currORHigh.barIndex := bar_index
        currORHigh.barTime  := time
        currORHigh.price    := ORsessionHighPrice.max()
    
    if currORLow.price > ORsessionLowPrice.min()
        currORLow.barIndex := bar_index
        currORLow.barTime  := time
        currORLow.price    := ORsessionLowPrice.min()

    currORMid.price := (currORHigh.price + currORLow.price) / 2

    updateIntraDayLine(currORHigh, ORHighSettings)
    updateIntraDayLine(currORLow , ORLowSettings)
    updateIntraDayLine(currORMid , ORMidSettings)


if insideIBRange and barstate.isconfirmed
    //Use last value in IB valueline array and update them
    currIBHigh = IBHigh_Arr.last()
    currIBLow  = IBLow_Arr.last()
    currIBMid  = IBMid_Arr.last()

    if currIBHigh.price < IBsessionHighPrice.max()
        currIBHigh.barIndex := bar_index
        currIBHigh.barTime  := time
        currIBHigh.price    := IBsessionHighPrice.max()
    
    if currIBLow.price > IBsessionLowPrice.min()
        currIBLow.barIndex := bar_index
        currIBLow.barTime  := time
        currIBLow.price    := IBsessionLowPrice.min()
    
    currIBMid.price := (currIBHigh.price + currIBLow.price) / 2

    updateIntraDayLine(currIBHigh, IBHighSettings)
    updateIntraDayLine(currIBLow , IBLowSettings)
    updateIntraDayLine(currIBMid , IBMidSettings)

//Logic for plotting Initial Balance
if newONsession and syminfo.type == "futures"
    globexOpen_Arr.addValueLine(ValueLine.new(globexOpenPrice_RS, bar_index, time), globexOpenSettings)
    globexOpen_Arr.updateLines(numDailyPeriods, false, labeloffsetDaily)
    globexOpen_Arr.deleteLines(numDailyPeriods)

if newLonSession
    londonOpen_Arr.addValueLine(ValueLine.new(open, bar_index, time), londonOpenSettings)
    londonOpen_Arr.updateLines(numDailyPeriods, false, labeloffsetDaily)
    londonOpen_Arr.deleteLines(numDailyPeriods)

if endLonSession
    londonClose_Arr.addValueLine(ValueLine.new(close[1], bar_index, time), londonCloseSettings)
    londonClose_Arr.updateLines(numDailyPeriods, false, labeloffsetDaily)
    londonClose_Arr.deleteLines(numDailyPeriods)

if newMidnightSession
    midnightOpen_Arr.addValueLine(ValueLine.new(open, bar_index, time), midnightOpenSettings)
    midnightOpen_Arr.updateLines(numDailyPeriods, false, labeloffsetDaily)
    midnightOpen_Arr.deleteLines(numDailyPeriods)

if rthOpenSess    
    //Reset Current Day High/Low Value Lines
    currDayHigh.resetLine(high, bar_index, time)
    currDayLow.resetLine(low, bar_index, time)
    
    //for RTH stock charts use newday to filter when to save prev day prices
    if futuresRTH or rthOnlyChart
        //Filter to determine if we are in RTH for either futures or stocks/funds, if we are, use the request security data from line 430, otherwise use the sessionHigh/Low function
        onHigh_Arr.addValueLine(ValueLine.new(ONsessionHighPrice_RS, bar_index, time), onHighSettings)
        onLow_Arr.addValueLine(ValueLine.new(ONsessionLowPrice_RS, bar_index, time), onLowSettings)

        londonOpen_Arr.addValueLine(ValueLine.new(londonOpenPrice_RS, bar_index, time), londonOpenSettings)   
        midnightOpen_Arr.addValueLine(ValueLine.new(midnightOpenPrice_RS, bar_index, time), midnightOpenSettings)

        //Update previous lines in array
        updateLines(onHigh_Arr      , numDailyPeriods, false, labeloffsetDaily)
        updateLines(onLow_Arr       , numDailyPeriods, false, labeloffsetDaily)
        updateLines(londonOpen_Arr  , numDailyPeriods, false, labeloffsetDaily)
        updateLines(midnightOpen_Arr, numDailyPeriods, false, labeloffsetDaily)

        deleteLines(londonOpen_Arr        , numDailyPeriods)
        deleteLines(midnightOpen_Arr      , numDailyPeriods)
        deleteLines(onHigh_Arr            , numDailyPeriods)
        deleteLines(onLow_Arr             , numDailyPeriods)

        if syminfo.type == "futures"
            globexOpen_Arr.addValueLine(ValueLine.new(globexOpenPrice_RS, bar_index, time), globexOpenSettings)
            prev5PMClose_Arr.addValueLine(ValueLine.new(prev5PMClosePrice_RS, bar_index, time), prev5PMCloseSettings)
            updateLines(globexOpen_Arr  , numDailyPeriods, false, labeloffsetDaily)
            updateLines(prev5PMClose_Arr, numDailyPeriods, false, labeloffsetDaily)
            deleteLines(globexOpen_Arr  , numDailyPeriods)
            deleteLines(prev5PMClose_Arr, numDailyPeriods)

    if rthOnlyChart
        //Check to see if high,low, or close levels have been tested
        if showUntestedHLCLevels    
            checkForTestedLevels(prevClose_Arr, prevOpen_Arr, prevHigh_Arr, prevLow_Arr, sessionHighPrice[1], sessionLowPrice[1])      
        
        //Daily Level Calculations for RTH Charts (i.e. strictly 9:30AM - 4PM)
        //Copy prev Open and T2 values for from current prevDay OHLC arrays
        //Add new prev Open Line
        prevOpen_Arr.addValueLine(rthOpen.deepCopy(), prevOpenSettings)
        if prevOpen_Arr.size() > 1
            t2Open_Arr.addValueLine(prevOpen_Arr.get(prevOpen_Arr.size() - 2).deepCopy(), t2OpenSettings)
        if prevHigh_Arr.size() > 1
            t2High_Arr.addValueLine(prevHigh_Arr.last().deepCopy(), t2HighSettings)
        if prevLow_Arr.size() > 1
            t2Low_Arr.addValueLine(prevLow_Arr.last().deepCopy(), t2LowSettings)
        if prevClose_Arr.size() > 1
            t2Close_Arr.addValueLine(prevClose_Arr.last().deepCopy(), t2CloseSettings)

        //Copy current day high/low into prev Day High/Low arrays
        prevHigh_Arr.addValueLine(ValueLine.new(sessionHighPrice[1], sessionHighBarIndex[1], sessionHighTime[1]), prevHighSettings)
        prevLow_Arr.addValueLine(ValueLine.new(sessionLowPrice[1], sessionLowBarIndex[1], sessionLowTime[1]), prevLowSettings)
        prevClose_Arr.addValueLine(ValueLine.new(close[1], bar_index[1], time[1]), prevCloseSettings)
        prev50HL_Arr.addValueLine(ValueLine.new(math.round_to_mintick((sessionHighPrice[1] + sessionLowPrice[1]) / 2),
                                 bar_index,
                                 time),
                                 prevMidHLSettings)
        prev50OC_Arr.addValueLine(ValueLine.new(math.round_to_mintick((close[1] + rthOpen.price) / 2),
                                 bar_index,
                                 time),
                                 prevMidOCSettings)
        
        //Add Daily VWAP values
        prevDayVWAP_Arr.addValueLine(ValueLine.new(vwapDaily.value, bar_index, time), prevDayVWAPSettings)    
        prevDayVWAP_LBand1_Arr.addValueLine(ValueLine.new(vwapDaily.value - vwapDaily.stdDev    , bar_index, time), prevDayVSD1Settings)
        prevDayVWAP_UBand1_Arr.addValueLine(ValueLine.new(vwapDaily.value + vwapDaily.stdDev    , bar_index, time), prevDayVSD1Settings)
        prevDayVWAP_LBand2_Arr.addValueLine(ValueLine.new(vwapDaily.value - vwapDaily.stdDev * 2, bar_index, time), prevDayVSD2Settings)
        prevDayVWAP_UBand2_Arr.addValueLine(ValueLine.new(vwapDaily.value + vwapDaily.stdDev * 2, bar_index, time), prevDayVSD2Settings)
        prevDayVWAP_LBand3_Arr.addValueLine(ValueLine.new(vwapDaily.value - vwapDaily.stdDev * 3, bar_index, time), prevDayVSD3Settings)
        prevDayVWAP_UBand3_Arr.addValueLine(ValueLine.new(vwapDaily.value + vwapDaily.stdDev * 3, bar_index, time), prevDayVSD3Settings)

        if prevWeekHigh.price < sessionHighPrice[1]
            prevWeekHigh := ValueLine.new(sessionHighPrice[1], sessionHighBarIndex[1], sessionHighTime[1])
        if prevWeekLow.price > sessionLowPrice[1]
            prevWeekLow := ValueLine.new(sessionLowPrice[1], sessionLowBarIndex[1], sessionLowTime[1])

        if prevMonthHigh.price < sessionHighPrice[1]
            prevMonthHigh    := ValueLine.new(sessionHighPrice[1], sessionHighBarIndex[1], sessionHighTime[1])
        if prevMonthLow.price > sessionLowPrice[1]
            prevMonthLow   := ValueLine.new(sessionLowPrice[1], sessionLowBarIndex[1], sessionLowTime[1])

        //Update Lines after new line has been added
        updateLines(prevHigh_Arr          , numDailyPeriods, false, labeloffsetDaily, showUntestedHLCLevels, showInactiveHLCLevels)
        updateLines(prevOpen_Arr          , numDailyPeriods, false, labeloffsetDaily, showUntestedHLCLevels, showInactiveHLCLevels)
        updateLines(prevLow_Arr           , numDailyPeriods, false, labeloffsetDaily, showUntestedHLCLevels, showInactiveHLCLevels)
        updateLines(prev50HL_Arr          , numDailyPeriods, false, labeloffsetDaily)
        updateLines(prev50OC_Arr          , numDailyPeriods, false, labeloffsetDaily)   
        updateLines(prevClose_Arr         , numDailyPeriods, false, labeloffsetDaily, showUntestedHLCLevels, showInactiveHLCLevels) 
        updateLines(t2Open_Arr            , numDailyPeriods, false, labeloffsetDaily)
        updateLines(t2Close_Arr           , numDailyPeriods, false, labeloffsetDaily)  
        updateLines(t2High_Arr            , numDailyPeriods, false, labeloffsetDaily)  
        updateLines(t2Low_Arr             , numDailyPeriods, false, labeloffsetDaily)
        updateLines(prevDayVWAP_Arr       , numDailyPeriods, false, labeloffsetDaily)
        updateLines(prevDayVWAP_LBand1_Arr, numDailyPeriods, false, labeloffsetDaily)
        updateLines(prevDayVWAP_UBand1_Arr, numDailyPeriods, false, labeloffsetDaily)
        updateLines(prevDayVWAP_LBand2_Arr, numDailyPeriods, false, labeloffsetDaily)
        updateLines(prevDayVWAP_UBand2_Arr, numDailyPeriods, false, labeloffsetDaily)
        updateLines(prevDayVWAP_LBand3_Arr, numDailyPeriods, false, labeloffsetDaily)
        updateLines(prevDayVWAP_UBand3_Arr, numDailyPeriods, false, labeloffsetDaily)

        //Delete Lines over the max limi
        deleteLines(prevOpen_Arr          , showUntestedHLCLevels and showDailyLevels ? 1000 : numDailyPeriods + 2)
        deleteLines(prevHigh_Arr          , showUntestedHLCLevels and showDailyLevels ? 1000 : numDailyPeriods + 2)
        deleteLines(prevLow_Arr           , showUntestedHLCLevels and showDailyLevels ? 1000 : numDailyPeriods + 2)
        deleteLines(prev50HL_Arr          , numDailyPeriods)
        deleteLines(prev50OC_Arr          , numDailyPeriods)
        deleteLines(prevClose_Arr         , showUntestedHLCLevels and showDailyLevels ? 1000 : numDailyPeriods + 2)
        deleteLines(t2Open_Arr            , numDailyPeriods)
        deleteLines(t2Close_Arr           , numDailyPeriods)
        deleteLines(t2High_Arr            , numDailyPeriods)
        deleteLines(t2Low_Arr             , numDailyPeriods)
        deleteLines(prevDayVWAP_Arr       , numDailyPeriods)
        deleteLines(prevDayVWAP_LBand1_Arr, numDailyPeriods)
        deleteLines(prevDayVWAP_UBand1_Arr, numDailyPeriods)
        deleteLines(prevDayVWAP_LBand2_Arr, numDailyPeriods)
        deleteLines(prevDayVWAP_UBand2_Arr, numDailyPeriods)
        deleteLines(prevDayVWAP_LBand3_Arr, numDailyPeriods)
        deleteLines(prevDayVWAP_UBand3_Arr, numDailyPeriods)

    //Update RTH Open Daily Line
    rthOpen.resetLine(open, bar_index, time)

    //Time of last Open
    lastSessOpenTime = prevOpen_Arr.last().barTime

    //Check for new week
    if dayofweek(time, "America/New_York") == dayofweek.monday or 
         (dayofweek(lastSessOpenTime, "America/New_York") == dayofweek.friday and 
             dayofweek(time, "America/New_York") == dayofweek.tuesday)
        rthWeekOpen_Arr.addValueLine(rthOpen.deepCopy(), weeklyOpenSettings)
        rthWeekOpen_Arr.updateLines(numWklyPeriods, false, labeloffsetWeekly)
        rthWeekOpen_Arr.deleteLines(numWklyPeriods + 1)
    //Check for new month
    if dayofmonth(lastSessOpenTime, "America/New_York") >= 28 and
         dayofmonth(time, "America/New_York") < dayofmonth(lastSessOpenTime, "America/New_York")
        rthMonthOpen_Arr.addValueLine(rthOpen.deepCopy(), monOpenSettings)
        rthMonthOpen_Arr.updateLines(numMonPeriods, false, labeloffsetMonthly)
        rthMonthOpen_Arr.deleteLines(numMonPeriods + 1)

//Logic for Plotting Current Daily High/Low on each new bar
if insideUSSession and barstate.isconfirmed
    if currDayHigh.price < sessionHighPrice
        currDayHigh.barIndex := sessionHighBarIndex
        currDayHigh.barTime  := sessionHighTime
        currDayHigh.price    := sessionHighPrice
    
    if currDayLow.price > sessionLowPrice    
        currDayLow.barIndex := sessionLowBarIndex
        currDayLow.barTime  := sessionLowTime
        currDayLow.price    := sessionLowPrice
    
    // updateIntraDayLine(currDayHigh, currHighSettings)
    // updateIntraDayLine(currDayLow , currLowSettings)
    // updateIntraDayLine(rthOpen    , rthOpenSettings)

//Reset ON High/Low when new ON session starts
if newONsession
    //Add a new value line to the arrray for tracking of current ON High/Low
    onHigh_Arr.addValueLine(ValueLine.new(high, bar_index, time), onHighSettings)
    onLow_Arr.addValueLine(ValueLine.new(low, bar_index, time), onLowSettings)
    updateLines(onHigh_Arr      , numDailyPeriods, false, labeloffsetDaily)
    updateLines(onLow_Arr       , numDailyPeriods, false, labeloffsetDaily)

    if syminfo.type == "futures"
        prev5PMClose_Arr.addValueLine(ValueLine.new(close[1], bar_index[1], time[1]), prev5PMCloseSettings)
        updateLines(prev5PMClose_Arr, numDailyPeriods, false, labeloffsetDaily)
        deleteLines(prev5PMClose_Arr, numDailyPeriods)

//Monitor ON Session High/Low
if insideONSession and barstate.isconfirmed
    //Use last value in ON valueline arrays and update them if a new high or low is made during the ON session
    currOnHigh = onHigh_Arr.last()
    currOnLow  = onLow_Arr.last()

    if currOnHigh.price < ONsessionHighPrice
        currOnHigh.barIndex := ONsessionHighBarIndex
        currOnHigh.barTime  := ONsessionHighTime
        currOnHigh.price    := ONsessionHighPrice
    
    if currOnLow.price > ONsessionLowPrice
        currOnLow.barIndex := ONsessionLowBarIndex
        currOnLow.barTime  := ONsessionLowTime
        currOnLow.price    := ONsessionLowPrice

    currOnHigh.updateIntraDayLine(onHighSettings)
    currOnLow.updateIntraDayLine(onLowSettings)

//for ETH charts and capturing RTH close information at 4:00PM close
if (endOfUSSession or shortUSSession) and not rthOnlyChart
    //Check to see if high,low, or close levels have been tested
    if showUntestedHLCLevels
        checkForTestedLevels(prevClose_Arr, prevOpen_Arr, prevHigh_Arr, prevLow_Arr, sessionHighPrice[1], sessionLowPrice[1])   

    //Copy T2 values for from current prevDay OHLC arrays
    prevOpen_Arr.addValueLine(rthOpen.deepCopy(), prevOpenSettings)
    if prevOpen_Arr.size() > 1
        t2Open_Arr.addValueLine(prevOpen_Arr.get(prevOpen_Arr.size() - 2).deepCopy(), t2OpenSettings)
    if prevHigh_Arr.size() > 1
        t2High_Arr.addValueLine(prevHigh_Arr.last().deepCopy(), t2HighSettings)
    if prevLow_Arr.size() > 1
        t2Low_Arr.addValueLine(prevLow_Arr.last().deepCopy(), t2LowSettings)
    if prevClose_Arr.size() > 1
        t2Close_Arr.addValueLine(prevClose_Arr.last().deepCopy(), t2CloseSettings)

    //Delete line and label once rth Open value has been pushed to prevOpen array to prevent overlapping
    rthOpen.llabel.delete()
    rthOpen.level.delete()

    //Copy current day high/low into prev Day High/Low arrays
    //If including overnight High, compare values first
    currOnHigh = onHigh_Arr.last()
    currOnLow  = onLow_Arr.last()

    if includeGlobexHL and currOnHigh.price > currDayHigh.price
        prevHigh_Arr.addValueLine(currOnHigh.copy(), prevHighSettings)
    else
        prevHigh_Arr.addValueLine(ValueLine.new(sessionHighPrice[1], sessionHighBarIndex[1], sessionHighTime[1]), prevHighSettings)
    
    if includeGlobexHL and currOnLow.price < currDayLow.price 
        prevLow_Arr.addValueLine(currOnLow.copy(), prevLowSettings)
    else
        prevLow_Arr.addValueLine(currDayLow.copy(), prevLowSettings)

    //Use PrevHigh/PrevLow Array values
    dailyHigh = prevHigh_Arr.last()
    dailyLow  = prevLow_Arr.last()

    prevClose_Arr.addValueLine(ValueLine.new(close[1], bar_index[1], time[1]), prevCloseSettings)
    prev50HL_Arr.addValueLine(ValueLine.new(math.round_to_mintick((dailyHigh.price + dailyLow.price) / 2),
                             bar_index,
                             time),
                             prevMidHLSettings)
    prev50OC_Arr.addValueLine(ValueLine.new(math.round_to_mintick((close[1] + rthOpen.price) / 2),
                             bar_index,
                             time),
                             prevMidOCSettings)
    
    //Add Daily VWAP values
    prevDayVWAP_Arr.addValueLine(ValueLine.new(vwapDaily.value, bar_index, time), prevDayVWAPSettings)    
    prevDayVWAP_LBand1_Arr.addValueLine(ValueLine.new(vwapDaily.value - vwapDaily.stdDev    , bar_index, time), prevDayVSD1Settings)
    prevDayVWAP_UBand1_Arr.addValueLine(ValueLine.new(vwapDaily.value + vwapDaily.stdDev    , bar_index, time), prevDayVSD1Settings)
    prevDayVWAP_LBand2_Arr.addValueLine(ValueLine.new(vwapDaily.value - vwapDaily.stdDev * 2, bar_index, time), prevDayVSD2Settings)
    prevDayVWAP_UBand2_Arr.addValueLine(ValueLine.new(vwapDaily.value + vwapDaily.stdDev * 2, bar_index, time), prevDayVSD2Settings)
    prevDayVWAP_LBand3_Arr.addValueLine(ValueLine.new(vwapDaily.value - vwapDaily.stdDev * 3, bar_index, time), prevDayVSD3Settings)
    prevDayVWAP_UBand3_Arr.addValueLine(ValueLine.new(vwapDaily.value + vwapDaily.stdDev * 3, bar_index, time), prevDayVSD3Settings)

    //Update Lines after new line has been added
    updateLines(prevHigh_Arr          , numDailyPeriods, false, labeloffsetDaily, showUntestedHLCLevels, showInactiveHLCLevels)
    updateLines(prevOpen_Arr          , numDailyPeriods, false, labeloffsetDaily, showUntestedHLCLevels, showInactiveHLCLevels)
    updateLines(prevLow_Arr           , numDailyPeriods, false, labeloffsetDaily, showUntestedHLCLevels, showInactiveHLCLevels)
    updateLines(prev50HL_Arr          , numDailyPeriods, false, labeloffsetDaily)
    updateLines(prev50OC_Arr          , numDailyPeriods, false, labeloffsetDaily)   
    updateLines(prevClose_Arr         , numDailyPeriods, false, labeloffsetDaily, showUntestedHLCLevels, showInactiveHLCLevels) 
    updateLines(t2Open_Arr            , numDailyPeriods, false, labeloffsetDaily)
    updateLines(t2Close_Arr           , numDailyPeriods, false, labeloffsetDaily)  
    updateLines(t2High_Arr            , numDailyPeriods, false, labeloffsetDaily)  
    updateLines(t2Low_Arr             , numDailyPeriods, false, labeloffsetDaily)
    updateLines(prevDayVWAP_Arr       , numDailyPeriods, false, labeloffsetDaily)
    updateLines(prevDayVWAP_LBand1_Arr, numDailyPeriods, false, labeloffsetDaily)
    updateLines(prevDayVWAP_UBand1_Arr, numDailyPeriods, false, labeloffsetDaily)
    updateLines(prevDayVWAP_LBand2_Arr, numDailyPeriods, false, labeloffsetDaily)
    updateLines(prevDayVWAP_UBand2_Arr, numDailyPeriods, false, labeloffsetDaily)
    updateLines(prevDayVWAP_LBand3_Arr, numDailyPeriods, false, labeloffsetDaily)
    updateLines(prevDayVWAP_UBand3_Arr, numDailyPeriods, false, labeloffsetDaily)

    //Delete Lines over the max limi
    deleteLines(prevOpen_Arr          , showUntestedHLCLevels and showDailyLevels ? 1000 : numDailyPeriods + 2)
    deleteLines(prevHigh_Arr          , showUntestedHLCLevels and showDailyLevels ? 1000 : numDailyPeriods + 2)
    deleteLines(prevLow_Arr           , showUntestedHLCLevels and showDailyLevels ? 1000 : numDailyPeriods + 2)
    deleteLines(prev50HL_Arr          , numDailyPeriods)
    deleteLines(prev50OC_Arr          , numDailyPeriods)
    deleteLines(prevClose_Arr         , showUntestedHLCLevels and showDailyLevels ? 1000 : numDailyPeriods + 2)
    deleteLines(t2Open_Arr            , numDailyPeriods)
    deleteLines(t2Close_Arr           , numDailyPeriods)
    deleteLines(t2High_Arr            , numDailyPeriods)
    deleteLines(t2Low_Arr             , numDailyPeriods)
    deleteLines(prevDayVWAP_Arr       , numDailyPeriods)
    deleteLines(prevDayVWAP_LBand1_Arr, numDailyPeriods)
    deleteLines(prevDayVWAP_UBand1_Arr, numDailyPeriods)
    deleteLines(prevDayVWAP_LBand2_Arr, numDailyPeriods)
    deleteLines(prevDayVWAP_UBand2_Arr, numDailyPeriods)
    deleteLines(prevDayVWAP_LBand3_Arr, numDailyPeriods)
    deleteLines(prevDayVWAP_UBand3_Arr, numDailyPeriods)

    if prevWeekHigh.price < dailyHigh.price
        prevWeekHigh := ValueLine.new(dailyHigh.price, dailyHigh.barIndex, dailyHigh.barTime)
    if prevWeekLow.price > dailyLow.price
        prevWeekLow := ValueLine.new(dailyLow.price, dailyLow.barIndex, dailyLow.barTime)

    if prevMonthHigh.price < dailyHigh.price
        prevMonthHigh    := ValueLine.new(dailyHigh.price, dailyHigh.barIndex, dailyHigh.barTime)
    if prevMonthLow.price > dailyLow.price
        prevMonthLow   := ValueLine.new(dailyLow.price, dailyLow.barIndex, dailyLow.barTime)

//Weekly level Calculations
if newWeek
    //Get the Value Line information from last weeks RTH Open
    lastWeekRTH = rthOnlyChart ? rthWeekOpen_Arr.get(rthWeekOpen_Arr.size() - 2) : rthWeekOpen_Arr.last()

    //Add Weekly Close
    prevWeekClose_Arr.addValueLine(prevClose_Arr.last().deepCopy(), weeklyCloseSettings)

    //Get last weeks RTH value to update HL2 and OC2 barIndex/barTime
    if rthWeekOpen_Arr.size() > 1              
        prevWeek50HL_Arr.addValueLine(ValueLine.new((prevWeekHigh.price + prevWeekLow.price) / 2,
                                         bar_index,
                                         time),
                                         prevWeekHalfHLSettings)
        prevWeek50OC_Arr.addValueLine(ValueLine.new((prevClose_Arr.last().price + lastWeekRTH.price) / 2,
                                         bar_index,
                                         time),
                                         prevWeekHalfOCSettings)
    
    //push values to their respective arrays
    prevWeekHigh_Arr.addValueLine(prevWeekHigh.copy(), prevWeekHighSettings)
    prevWeekLow_Arr.addValueLine(prevWeekLow.copy(), prevWeekLowSettings)

    //Reset Value Lines used to track Weekly High/Low
    prevWeekLow.price  := 1.0e16
    prevWeekHigh.price := 0

    //Add weekly VWAP values
    prevWeekVWAP_Arr.addValueLine(ValueLine.new(vwapWeekly.value, bar_index, time), weeklyVWAPSettings)
    prevWeekVWAP_UBand1_Arr.addValueLine(ValueLine.new(vwapWeekly.value + vwapWeekly.stdDev    , bar_index, time), weeklySD1Settings)
    prevWeekVWAP_LBand1_Arr.addValueLine(ValueLine.new(vwapWeekly.value - vwapWeekly.stdDev    , bar_index, time), weeklySD1Settings)
    prevWeekVWAP_UBand2_Arr.addValueLine(ValueLine.new(vwapWeekly.value + vwapWeekly.stdDev * 2, bar_index, time), weeklySD2Settings)
    prevWeekVWAP_LBand2_Arr.addValueLine(ValueLine.new(vwapWeekly.value - vwapWeekly.stdDev * 2, bar_index, time), weeklySD2Settings)
    prevWeekVWAP_UBand3_Arr.addValueLine(ValueLine.new(vwapWeekly.value + vwapWeekly.stdDev * 3, bar_index, time), weeklySD3Settings)
    prevWeekVWAP_LBand3_Arr.addValueLine(ValueLine.new(vwapWeekly.value - vwapWeekly.stdDev * 3, bar_index, time), weeklySD3Settings)

    //Update previous weekly lines in the arrays
    updateLines(prevWeekHigh_Arr       , numWklyPeriods, false, labeloffsetWeekly)
    updateLines(prevWeekLow_Arr        , numWklyPeriods, false, labeloffsetWeekly)
    updateLines(prevWeek50HL_Arr       , numWklyPeriods, false, labeloffsetWeekly)
    updateLines(prevWeek50OC_Arr       , numWklyPeriods, false, labeloffsetWeekly)
    updateLines(prevWeekClose_Arr      , numWklyPeriods, false, labeloffsetWeekly)
    updateLines(prevWeekVWAP_Arr       , numWklyPeriods, false, labeloffsetWeekly)
    updateLines(prevWeekVWAP_UBand1_Arr, numWklyPeriods, false, labeloffsetWeekly)
    updateLines(prevWeekVWAP_LBand1_Arr, numWklyPeriods, false, labeloffsetWeekly)
    updateLines(prevWeekVWAP_UBand2_Arr, numWklyPeriods, false, labeloffsetWeekly)
    updateLines(prevWeekVWAP_LBand2_Arr, numWklyPeriods, false, labeloffsetWeekly)
    updateLines(prevWeekVWAP_UBand3_Arr, numWklyPeriods, false, labeloffsetWeekly)
    updateLines(prevWeekVWAP_LBand3_Arr, numWklyPeriods, false, labeloffsetWeekly)

    deleteLines(prevWeekHigh_Arr       , numWklyPeriods)
    deleteLines(prevWeekLow_Arr        , numWklyPeriods)
    deleteLines(prevWeek50HL_Arr       , numWklyPeriods)
    deleteLines(prevWeek50OC_Arr       , numWklyPeriods)
    deleteLines(prevWeekClose_Arr      , numWklyPeriods)
    deleteLines(prevWeekVWAP_Arr       , numWklyPeriods)
    deleteLines(prevWeekVWAP_LBand1_Arr, numWklyPeriods)
    deleteLines(prevWeekVWAP_UBand1_Arr, numWklyPeriods)
    deleteLines(prevWeekVWAP_LBand2_Arr, numWklyPeriods)
    deleteLines(prevWeekVWAP_UBand2_Arr, numWklyPeriods)
    deleteLines(prevWeekVWAP_LBand3_Arr, numWklyPeriods)
    deleteLines(prevWeekVWAP_UBand3_Arr, numWklyPeriods)

//Monthly Level Calculations
if newMonth

    //Get the Value Line information from last months RTH Open
    lastMonthRTH = rthOnlyChart ? rthMonthOpen_Arr.get(rthMonthOpen_Arr.size() - 2) : rthMonthOpen_Arr.last()

    //Add monthly Close
    prevMonthClose_Arr.addValueLine(prevClose_Arr.last().deepCopy(), monCloseSettings)

    //get last months RTH value to update HL2 and OC2 barIndex/barTime
    if rthMonthOpen_Arr.size() > 1
        prevMonth50HL_Arr.addValueLine(ValueLine.new((prevMonthHigh.price + prevMonthLow.price) / 2,
                                         bar_index,
                                         time),
                                         prevMonHalfHLSettings)
        prevMonth50OC_Arr.addValueLine(ValueLine.new((prevClose_Arr.last().price + lastMonthRTH.price) / 2,
                                         bar_index,
                                         time),
                                         prevMonHalfOCSettings)
    //push values to their respective arrays
    prevMonthHigh_Arr.addValueLine(prevMonthHigh.copy(), prevMonHighSettings)
    prevMonthLow_Arr.addValueLine(prevMonthLow.copy(), prevMonLowSettings)

    //Reset Value Lines used to track Weekly High/Low
    prevMonthLow.price  := 1.0e16
    prevMonthHigh.price := 0

    //Add weekly VWAP values
    prevMonthVWAP_Arr.addValueLine(ValueLine.new(vwapMonthly.value, bar_index, time), monthlyVWAPSettings)
    prevMonthVWAP_UBand1_Arr.addValueLine(ValueLine.new(vwapMonthly.value + vwapMonthly.stdDev    , bar_index, time), monthlySD1Settings)
    prevMonthVWAP_LBand1_Arr.addValueLine(ValueLine.new(vwapMonthly.value - vwapMonthly.stdDev    , bar_index, time), monthlySD1Settings)
    prevMonthVWAP_UBand2_Arr.addValueLine(ValueLine.new(vwapMonthly.value + vwapMonthly.stdDev * 2, bar_index, time), monthlySD2Settings)
    prevMonthVWAP_LBand2_Arr.addValueLine(ValueLine.new(vwapMonthly.value - vwapMonthly.stdDev * 2, bar_index, time), monthlySD2Settings)
    prevMonthVWAP_UBand3_Arr.addValueLine(ValueLine.new(vwapMonthly.value + vwapMonthly.stdDev * 3, bar_index, time), monthlySD3Settings)
    prevMonthVWAP_LBand3_Arr.addValueLine(ValueLine.new(vwapMonthly.value - vwapMonthly.stdDev * 3, bar_index, time), monthlySD3Settings)

    //Monthly Line Updates
    updateLines(prevMonthHigh_Arr       , numMonPeriods, false, labeloffsetMonthly)
    updateLines(prevMonthLow_Arr        , numMonPeriods, false, labeloffsetMonthly)
    updateLines(prevMonth50HL_Arr       , numMonPeriods, false, labeloffsetMonthly)
    updateLines(prevMonth50OC_Arr       , numMonPeriods, false, labeloffsetMonthly)
    updateLines(prevMonthClose_Arr      , numMonPeriods, false, labeloffsetMonthly)
    updateLines(prevMonthVWAP_Arr       , numMonPeriods, false, labeloffsetMonthly)
    updateLines(prevMonthVWAP_UBand1_Arr, numMonPeriods, false, labeloffsetMonthly)
    updateLines(prevMonthVWAP_LBand1_Arr, numMonPeriods, false, labeloffsetMonthly)
    updateLines(prevMonthVWAP_UBand2_Arr, numMonPeriods, false, labeloffsetMonthly)
    updateLines(prevMonthVWAP_LBand2_Arr, numMonPeriods, false, labeloffsetMonthly)
    updateLines(prevMonthVWAP_UBand3_Arr, numMonPeriods, false, labeloffsetMonthly)
    updateLines(prevMonthVWAP_LBand3_Arr, numMonPeriods, false, labeloffsetMonthly)

    deleteLines(prevMonthHigh_Arr       , numMonPeriods)
    deleteLines(prevMonthLow_Arr        , numMonPeriods)
    deleteLines(prevMonth50HL_Arr       , numMonPeriods)
    deleteLines(prevMonth50OC_Arr       , numMonPeriods)
    deleteLines(prevMonthClose_Arr      , numMonPeriods)
    deleteLines(prevMonthVWAP_Arr       , numMonPeriods)
    deleteLines(prevMonthVWAP_UBand1_Arr, numMonPeriods)
    deleteLines(prevMonthVWAP_LBand1_Arr, numMonPeriods)
    deleteLines(prevMonthVWAP_UBand2_Arr, numMonPeriods)
    deleteLines(prevMonthVWAP_LBand2_Arr, numMonPeriods)
    deleteLines(prevMonthVWAP_UBand3_Arr, numMonPeriods)
    deleteLines(prevMonthVWAP_LBand3_Arr, numMonPeriods) 
    
//VWAP Calculations (Must be after all the adding of the valuelines due to RTH tickers)
vwapDaily.calculateVWAP(insideUSSession, rthOpenSess)
vwapWeekly.calculateVWAP(insideUSSession, newWeekRTH)
vwapMonthly.calculateVWAP(insideUSSession, newMonthRTH)
log.info(syminfo.type)
//Only update lines on last bar to reduce number of
if barstate.islast
    //Update current daily intraday lines
    updateIntraDayLine(currDayHigh                  , currHighSettings)
    updateIntraDayLine(currDayLow                   , currLowSettings)
    updateIntraDayLine(rthOpen                      , rthOpenSettings)
    updateIntraDayLine(ORHigh_Arr.last()            , ORHighSettings)
    updateIntraDayLine(ORLow_Arr.last()             , ORLowSettings)
    updateIntraDayLine(ORMid_Arr.last()             , ORMidSettings)
    updateIntraDayLine(IBHigh_Arr.last()            , IBHighSettings)
    updateIntraDayLine(IBLow_Arr.last()             , IBLowSettings)
    updateIntraDayLine(IBMid_Arr.last()             , IBMidSettings)  
    updateIntraDayLine(globexOpen_Arr.last()        , globexOpenSettings)
    updateIntraDayLine(prevOpen_Arr.last()          , prevOpenSettings)
    updateIntraDayLine(londonOpen_Arr.last()        , londonOpenSettings)
    updateIntraDayLine(londonClose_Arr.last()       , londonCloseSettings)
    updateIntraDayLine(midnightOpen_Arr.last()      , midnightOpenSettings)
    updateIntraDayLine(onHigh_Arr.last()            , onHighSettings)
    updateIntraDayLine(onLow_Arr.last()             , onLowSettings)
    updateIntraDayLine(prevHigh_Arr.last()          , prevHighSettings)
    updateIntraDayLine(prevLow_Arr.last()           , prevLowSettings)
    updateIntraDayLine(prev50HL_Arr.last()          , prevMidHLSettings)
    updateIntraDayLine(prev50OC_Arr.last()          , prevMidOCSettings)   
    updateIntraDayLine(prevClose_Arr.last()         , prevCloseSettings)
    updateIntraDayLine(prev5PMClose_Arr.last()      , prev5PMCloseSettings) 
    updateIntraDayLine(t2Open_Arr.last()            , t2OpenSettings)
    updateIntraDayLine(t2Close_Arr.last()           , t2CloseSettings)  
    updateIntraDayLine(t2High_Arr.last()            , t2HighSettings)  
    updateIntraDayLine(t2Low_Arr.last()             , t2LowSettings)
    updateIntraDayLine(prevDayVWAP_Arr.last()       , prevDayVWAPSettings)
    updateIntraDayLine(prevDayVWAP_LBand1_Arr.last(), prevDayVSD1Settings)
    updateIntraDayLine(prevDayVWAP_UBand1_Arr.last(), prevDayVSD1Settings)
    updateIntraDayLine(prevDayVWAP_LBand2_Arr.last(), prevDayVSD2Settings)
    updateIntraDayLine(prevDayVWAP_UBand2_Arr.last(), prevDayVSD2Settings)
    updateIntraDayLine(prevDayVWAP_LBand3_Arr.last(), prevDayVSD3Settings)
    updateIntraDayLine(prevDayVWAP_UBand3_Arr.last(), prevDayVSD3Settings)

    //Weekly Line Updates
    updateIntraDayLine(prevWeekHigh_Arr.last()       , prevWeekHighSettings)
    updateIntraDayLine(prevWeekLow_Arr.last()        , prevWeekLowSettings)
    updateIntraDayLine(prevWeek50HL_Arr.last()       , prevWeekHalfHLSettings)
    updateIntraDayLine(prevWeek50OC_Arr.last()       , prevWeekHalfOCSettings)
    updateIntraDayLine(rthWeekOpen_Arr.last()        , weeklyOpenSettings)
    updateIntraDayLine(prevWeekClose_Arr.last()      , weeklyCloseSettings)
    updateIntraDayLine(prevWeekVWAP_Arr.last()       , weeklyVWAPSettings)
    updateIntraDayLine(prevWeekVWAP_UBand1_Arr.last(), weeklySD1Settings)
    updateIntraDayLine(prevWeekVWAP_LBand1_Arr.last(), weeklySD1Settings)
    updateIntraDayLine(prevWeekVWAP_UBand2_Arr.last(), weeklySD2Settings)
    updateIntraDayLine(prevWeekVWAP_LBand2_Arr.last(), weeklySD2Settings)
    updateIntraDayLine(prevWeekVWAP_UBand3_Arr.last(), weeklySD3Settings)
    updateIntraDayLine(prevWeekVWAP_LBand3_Arr.last(), weeklySD3Settings)

    //Monthly Line Updates
    updateIntraDayLine(prevMonthHigh_Arr.last()       , prevMonHighSettings)
    updateIntraDayLine(prevMonthLow_Arr.last()        , prevMonLowSettings)
    updateIntraDayLine(prevMonth50HL_Arr.last()       , prevMonHalfHLSettings)
    updateIntraDayLine(prevMonth50OC_Arr.last()       , prevMonHalfOCSettings)
    updateIntraDayLine(rthMonthOpen_Arr.last()        , monOpenSettings)
    updateIntraDayLine(prevMonthClose_Arr.last()      , monCloseSettings)
    updateIntraDayLine(prevMonthVWAP_Arr.last()       , monthlyVWAPSettings)
    updateIntraDayLine(prevMonthVWAP_UBand1_Arr.last(), monthlySD1Settings)
    updateIntraDayLine(prevMonthVWAP_LBand1_Arr.last(), monthlySD1Settings)
    updateIntraDayLine(prevMonthVWAP_UBand2_Arr.last(), monthlySD2Settings)
    updateIntraDayLine(prevMonthVWAP_LBand2_Arr.last(), monthlySD2Settings)
    updateIntraDayLine(prevMonthVWAP_UBand3_Arr.last(), monthlySD3Settings)
    updateIntraDayLine(prevMonthVWAP_LBand3_Arr.last(), monthlySD3Settings)
