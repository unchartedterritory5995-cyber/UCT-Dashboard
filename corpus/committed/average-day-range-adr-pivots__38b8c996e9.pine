string i_ma_2_timeframe = input.timeframe(defval = '', title = '', inline = 'ma_2_2', group = g_ma)

bool i_ma_3_show = input.bool(defval = false, title = '', inline = 'ma_3_1', group = g_ma)
int i_ma_3_length = input.int(defval = 99, title = '', inline = 'ma_3_1', group = g_ma)
