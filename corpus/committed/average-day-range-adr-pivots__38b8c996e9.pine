//@version=6
indicator(title = 'Average Day Range (ADR) Pivots', shorttitle = 'ADR Pivots', overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

//__________________________ Menu ADR Start

string g_gi = '███████████████ Common Inputs ███████████████'

