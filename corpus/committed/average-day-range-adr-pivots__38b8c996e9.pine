string g_ma = '██████████████ Moving Average ██████████████'

bool i_ma_1_show = input.bool(defval = false, title = '', inline = 'ma_1_1', group = g_ma)
int i_ma_1_length = input.int(defval = 7, title = '', inline = 'ma_1_1', group = g_ma)
