// === Swing Detection ===
swingGroup = "Swing Detection"
primarySwingLen = input.int(13, "Primary Wave Swing Length", minval=3, maxval=100, group=swingGroup, tooltip="Bars to confirm major swings (lower = more sensitive)")
secondarySwingLen = input.int(5, "Sub-Wave Swing Length", minval=2, maxval=50, group=swingGroup, tooltip="Bars to confirm minor swings")
minSwingPct = input.float(5.0, "Min Swing % (Primary)", minval=0.5, maxval=30.0, step=0.5, group=swingGroup, tooltip="Minimum % move for primary waves (crypto: 5-10%)")
minSubSwingPct = input.float(2.0, "Min Swing % (Sub)", minval=0.1, maxval=15.0, step=0.1, group=swingGroup)

// === Multi-Timeframe Analysis ===
mtfGroup = "Multi-Timeframe Analysis"
enableMTF = input.bool(true, "Enable MTF Validation", group=mtfGroup, tooltip="Cross-reference wave counts with higher timeframes")
autoDetectHTF = input.bool(true, "Auto-Detect HTF from Chart", group=mtfGroup, tooltip="Automatically pick sensible higher timeframes based on your chart TF. Disable to set manually.")
htf1Manual = input.timeframe("240", "Manual HTF 1 (if auto off)", group=mtfGroup, tooltip="First higher timeframe — only used when auto-detect is off")
htf2Manual = input.timeframe("D", "Manual HTF 2 (if auto off)", group=mtfGroup, tooltip="Second higher timeframe — only used when auto-detect is off")
htfSwingLenManual = input.int(8, "Manual HTF Swing Length (if auto off)", minval=3, maxval=50, group=mtfGroup, tooltip="Swing sensitivity for HTF pivot detection — only used when auto-detect is off")
htfMinSwingPctManual = input.float(8.0, "Manual HTF Min Swing % (if auto off)", minval=0.1, maxval=50.0, step=0.5, group=mtfGroup, tooltip="Minimum swing size on HTF — only used when auto-detect is off")
htfConfWeight = input.float(0.20, "HTF Confidence Weight", minval=0.0, maxval=0.50, step=0.05, group=mtfGroup, tooltip="How much HTF alignment affects CTF confidence (0 = disabled)")
showHTFPivots = input.bool(false, "Show HTF Pivot Markers", group=mtfGroup, tooltip="Draw HTF swing points on chart")

// Auto-detect: map chart timeframe → sensible HTF1 / HTF2
// timeframe.in_seconds() is "simple int" so switch produces "simple string"
// | Chart TF    | HTF1 | HTF2 |
// |-------------|------|------|
// | ≤1m         | 15m  | 1H   |
// | 2m – 5m     | 1H   | 4H   |
// | 6m – 15m    | 4H   | D    |
// | 16m – 1H    | 4H   | D    |
// | 2H – 4H     | D    | W    |
// | Daily       | W    | M    |
// | Weekly+     | M    | 3M   |

autoTF1 = switch
    timeframe.in_seconds() <= 60    => "15"
    timeframe.in_seconds() <= 300   => "60"
    timeframe.in_seconds() <= 900   => "240"
    timeframe.in_seconds() <= 3600  => "240"
    timeframe.in_seconds() <= 14400 => "D"
    timeframe.in_seconds() <= 86400 => "W"
    => "M"

autoTF2 = switch
    timeframe.in_seconds() <= 60    => "60"
    timeframe.in_seconds() <= 300   => "240"
    timeframe.in_seconds() <= 900   => "D"
    timeframe.in_seconds() <= 3600  => "D"
    timeframe.in_seconds() <= 14400 => "W"
    timeframe.in_seconds() <= 86400 => "M"
    => "3M"

htf1Timeframe = autoDetectHTF ? autoTF1 : htf1Manual
htf2Timeframe = autoDetectHTF ? autoTF2 : htf2Manual

// Human-readable TF label for info panel
htf1Label = switch htf1Timeframe
    "1"   => "1m"
    "3"   => "3m"
    "5"   => "5m"
    "15"  => "15m"
    "30"  => "30m"
    "60"  => "1H"
    "120" => "2H"
    "240" => "4H"
    "D"   => "Daily"
    "W"   => "Weekly"
    "M"   => "Monthly"
    "3M"  => "3M"
    => htf1Timeframe

htf2Label = switch htf2Timeframe
    "1"   => "1m"
    "3"   => "3m"
    "5"   => "5m"
    "15"  => "15m"
    "30"  => "30m"
    "60"  => "1H"
    "120" => "2H"
    "240" => "4H"
    "D"   => "Daily"
    "W"   => "Weekly"
    "M"   => "Monthly"
    "3M"  => "3M"
    => htf2Timeframe

// Auto-detect HTF swing parameters based on asset type + HTF resolution
// syminfo.type: "crypto", "forex", "stock", "index", "futures", "cfd", "fund", etc.
//
// Min Swing % by asset class (typical volatility):
// | Asset   | HTF Min Swing % | Rationale                         |
// |---------|-----------------|-----------------------------------|
// | Crypto  | 5.0 – 8.0%     | High vol, large swings            |
// | Stock   | 3.0 – 5.0%     | Moderate vol                      |
// | Index   | 2.0 – 3.0%     | Diversified, lower per-unit vol   |
// | Forex   | 0.8 – 1.5%     | Low vol, tight ranges             |
// | Futures | 2.0 – 4.0%     | Varies, middle ground             |
// | CFD     | 2.0 – 3.0%     | Usually index/commodity-like      |
//
// Swing length scales with HTF resolution:
// Faster HTF (4H) → more bars needed (8-10)
// Slower HTF (W/M) → fewer bars needed (4-6)

autoMinSwingPct = switch syminfo.type
    "crypto" => 5.0
    "forex"  => 1.0
    "stock"  => 3.5
    "dr"     => 3.5
    "fund"   => 2.5
    "index"  => 2.5
    "cfd"    => 2.5
    => 3.0  // futures, commodity, others

// Adjust swing % by HTF resolution — higher TF can use slightly smaller %
// because the candles themselves are larger
autoMinSwingPctAdj = switch htf1Timeframe
    "15"  => autoMinSwingPct * 0.6
    "60"  => autoMinSwingPct * 0.8
    "240" => autoMinSwingPct * 1.0
    "D"   => autoMinSwingPct * 0.9
    "W"   => autoMinSwingPct * 0.8
    "M"   => autoMinSwingPct * 0.7
    => autoMinSwingPct

// Swing length: fewer bars needed on higher TFs (each bar covers more time)
autoSwingLen = switch htf1Timeframe
    "15"  => 10
    "60"  => 8
    "240" => 7
    "D"   => 6
    "W"   => 5
    "M"   => 4
    => 8

htfSwingLen = autoDetectHTF ? autoSwingLen : htfSwingLenManual
htfMinSwingPct = autoDetectHTF ? autoMinSwingPctAdj : htfMinSwingPctManual

// Asset class label for info panel
assetClassLabel = switch syminfo.type
    "crypto" => "Crypto"
    "forex"  => "Forex"
    "stock"  => "Stock"
    "dr"     => "Stock"
    "fund"   => "Fund"
    "index"  => "Index"
    "cfd"    => "CFD"
    "futures"=> "Futures"
    => syminfo.type

