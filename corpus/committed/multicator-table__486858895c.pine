//@version=6
indicator('Multicator Table', overlay = true, max_labels_count = 300, max_lines_count = 150, max_boxes_count = 50, max_polylines_count = 40)

// Color pack for table, HUD, and frames.
type ThemePalette
    color tableBg
    color tableHeader
    color tableText
    color frame
    color bull
    color bear
    color neutral
    color accentText
    color hudBg
    color hudBorder
    color hudText

// Builds the color pack for the selected theme.
themePalette(bool dark) =>
    ThemePalette.new(
         dark ? color.new(#070b14, 8) : color.new(#f4f7fb, 0),
         dark ? color.new(#031018, 0) : color.new(#e4eef5, 0),
         dark ? color.new(#eaffff, 0) : color.new(#0b1c28, 0),
         dark ? color.new(#00f3ff, 20) : color.new(#0b4f6c, 0),
         dark ? color.new(#00ff9c, 35) : color.new(#c8f7d6, 0),
         dark ? color.new(#ff2d6a, 28) : color.new(#ffd0d6, 0),
         dark ? color.new(#0d1524, 0) : color.new(#e8eef4, 0),
         dark ? color.new(#eaffff, 0) : color.new(#0b1c28, 0),
         dark ? color.new(#05080f, 18) : color.new(#dfe7ef, 8),
         dark ? color.new(#00f3ff, 25) : color.new(#0b4f6c, 0),
         dark ? color.new(#eaffff, 0) : color.new(#0b1c28, 0))

