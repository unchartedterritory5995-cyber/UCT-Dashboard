# === Required for production ===
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
RESEND_API_KEY=re_...
DASHBOARD_URL=https://web-production-05cb6.up.railway.app
PUSH_SECRET=your-push-secret-here
ADMIN_EMAILS=admin@example.com

# === Optional ===
FROM_EMAIL=UCT Intelligence <noreply@uctintelligence.com>
AUTH_DB_PATH=/data/auth.db
SENTRY_DSN=https://...@sentry.io/...

# === Data Sources ===
MASSIVE_API_KEY=your-massive-api-key
MASSIVE_SECRET_KEY=your-massive-secret-key
FINNHUB_API_KEY=your-finnhub-key
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=sk-...   # voice TTS (slice 1) + future Realtime/Whisper
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
FINVIZ_API_KEY=your-finviz-elite-key

# === Voice & AI Features ===
VITE_PICOVOICE_ACCESS_KEY=replace-with-key-from-picovoice-console
PERPLEXITY_API_KEY=pplx-...     # Perplexity Sonar (web search, finance research, deep research)
FRED_API_KEY=                   # FRED economic data — free at https://fred.stlouisfed.org/docs/api/api_key.html
FMP_API_KEY=                    # Financial Modeling Prep premium endpoints
ALPHAVANTAGE_API_KEY=           # AlphaVantage news + sentiment (fallback for cached news pipeline)
DEEP_RESEARCH_MODEL=claude-sonnet-4-6   # override the Claude model used by voice deep_research

# === Twitter / Social ===
TWITTERAPI_IO_API_KEY=          # TwitterAPI.io for the curated trader feed (Deltaone, FinancialJuice, Benzinga, WallStEngine)
TWITTERAPI_IO_ENABLED=          # Set to '1' to turn on the scheduler that polls Twitter
REDDIT_CLIENT_ID=               # Reddit app credentials for r/wsb, r/stocks sentiment
REDDIT_CLIENT_SECRET=

# === TheFly Squawk Feed ===
THEFLY_API_KEY=                 # If you have a TheFly subscription
THEFLY_BASE_URL=                # Optional override; defaults to https://api.thefly.com/v1

# === Workers / Feature Flags ===
WORKER_ENABLED=                 # Set to '1' on the worker pod only (separate from web)
RECONCILE_ENABLED=              # Set to '1' to enable the bars reconciliation worker
