.env
.worktrees
.worktrees/
__pycache__/
*.pyc
node_modules/
app/dist/
app/node_modules/
*.egg-info/
.pytest_cache/
data/
# Voice KB corpus is version-controlled — deploys with the code
!api/data/voice_kb/
!api/data/voice_kb/**
# Phase 3B Lane A VCP gold-standard validation evidence (rubric, candidate
# pool, frozen case packets, blinded review results, adjudication + metrics)
# is version-controlled -- it is the reproducible evidence trail for the
# program's decision log, not regenerable scratch output.
!docs/uct-scanner-intelligence/vcp_gold_standard/data/
!docs/uct-scanner-intelligence/vcp_gold_standard/data/**
# Phase 5 Tier-1 multi-pattern validation evidence (per-family audit
# results: validation cards, defect-class findings, geometry/provenance
# readiness, P0-P3 issue lists) -- reproducible evidence trail for the
# program's decision log, same rationale as the VCP gold-standard data above.
!docs/uct-scanner-intelligence/tier1_validation/data/
!docs/uct-scanner-intelligence/tier1_validation/data/**
*.json.bak
backups/
.superpowers/
app/public/dev-login.html

# Mobile audit screenshots (local only)
tools/mobile_audit_out/
tools/wave_l_e2e_out/
tools/wave_n_e2e_out/
tools/wave_n_perf_out/
tools/wave_n_mobile_out/
tools/wave_o_mobile_out/
tools/wave_o_perf_out/
tools/wave_o_e2e_out/
tools/wave_o6_e2e_out/
tools/wave_o6_mobile_out/
tools/wave_o6_perf_out/

# Local UI consistency sweep output (screenshots + font probe)
tools/ui_sweep_out/

# Chart parity gate captures + diffs (local only; regenerate with tools/chart_parity.py)
tools/chart_parity_out/
# ...and every SUFFIXED output dir. B5 Task 11 ran six pairs at once
# (--out tools/chart_parity_out_main, _sep, _axis, _hgt, _bandsdet,
# _panesdet); only the bare name was ignored, so a 3,000-PNG scratch dir
# showed up as untracked next to the commit it must never be part of.
tools/chart_parity_out_*/
# The built dists a parity run serves (`cp -r app/dist .parity-dist-a`).
.parity-dist-*/

# Alert replay scratch output (`tools/alert_replay.py --diff --out …`). Multi-MB
# per run and regenerable; the COMMITTED artifacts of that tool are
# tests/fixtures/alerts/{replay_bars,fire_log_forming,fire_diff_declared}.json.
tools/alert_replay_out/

# Entity Master seed-script scratch output (local dev/verification runs of
# scripts/entity_master_seed.py) — real market data regenerable from the
# same sources any time; never a committed artifact.
_local_seed_data/
tools/_local_backend.log

# SnapTrade smoke-test state (contains a userSecret)
tools/.snaptrade_smoke_state.json
tools/.snaptrade_captures/

# Desk video taxonomy dump/apply working files (local only)
tools/taxonomy_out/

# Track E live-run logs + mechanically-extracted evidence (tools/track_e_run_golden_journey.py).
# Never contains the key itself (only its length is ever logged) but does carry real model
# outputs from real runs -- kept local, not committed.
tools/_track_e_runs/

# Golden Journey #1-3 automation evidence (tools/golden_journey_pine_thinkscript_pcf.py) —
# screenshots + a JSON verdict from real runs against a throwaway isolated sandbox, kept
# local, not committed.
tools/_gj_runs/

# Local Python virtual environment (local dev only)
.venv/

# Pine intake bench — pasted scripts are evidence, never committed fixtures
tests/fixtures/pine-inbox/
tests/fixtures/thinkscript-inbox/

# UI stress harness output (screenshots + findings; regenerated per run)
tools/ui_stress_out*/
tools/ui_stress_out_run*.log

# Per-run lane scratch (backups, mutation captures, baseline stdout/stderr).
# Untracked and disposable; listed so an accidental `git add -A` cannot sweep it in.
/scratchpad/

# Mutated copies written by the linter's guard-deleted control (lint.test.js).
# They live OUTSIDE `app/src` on purpose: a dozen rails walk that tree with
# readdirSync+readFileSync, and a file that appears and vanishes mid-walk killed
# whole test files with ENOENT at module scope. Per-run, deleted in a `finally`.
/app/.mutations/

# C0 visual-journey run output. The report.json of each CITED run is committed
# by explicit path (it is the evidence behind a number in
# C0_STATUS_AND_BLOCKER.md); the per-script screenshots are large, are
# regenerated by every run, and are not cited.
tools/c0_out*/*.png
tools/c0_ctrl*/*.png
tools/c0_param*/
tools/c0_out/
tools/c0_out2/
tools/c0_out3/
tools/c0_out4/
tools/c0_out_oos/
tools/c0_ctrl/
tools/c0r_out*/*.png
tools/c1_out*/*.png
tools/c1_keep/
tools/c2a_out*/*.png
# ── Company Panel: local review + audit artifacts (never deploy) ────────────
# Seeded local stores, probe output, the visual-QA harness and the QA vite
# override. All are development-only and some are large.
_local_news/
_probe_out/
app/newsqa.html
app/src/newsqa.jsx
app/vite.qa.config.js
tools/capture_phone_out/
tools/capture_extension_out/
tools/share_phone_out/
tools/wave_l_e2e_out/
tools/semantic_benchmark_out/
tools/prod_asset_proof_out/
# local-only earnings-strip design harness (never deployed)
app/stripqa.html
app/src/stripqa.jsx
app/vite.strip.config.js
app/_stripqa/
app/vite.local.config.js
app/stripqa2.html
app/src/stripqa2.jsx

# Pine survey local cache — fetched third-party sources + chart snapshots.
# NEVER committed: licence-gated (see docs/pine/LICENSING.md). Re-fetchable via
# tools/pine_survey/tvfetch.py.
tools/pine_survey/cache/

# Per-chunk logs from tools/pytest_chunks.py (the R7 full-lane runner). One
# full run is ~40 MB across 12 logs and is evidence for ONE run, not an
# artifact. Cite a chunk log by path in a commit message; never commit it.
.pytest_chunks/

# ⛔ WORKTREE OWNERSHIP (CLAUDE.md, owner ruling 2026-09-12). Every worktree
# carries one at its root naming the session that created it, so a cleanup can
# tell what it is about to delete. Per-worktree and never committed.
.uct-session-owner
