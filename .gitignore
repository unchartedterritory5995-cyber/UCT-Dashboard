.env
.worktrees
.worktrees/
__pycache__/
*.pyc
node_modules/
app/dist/
app/node_modules/
*.egg-info/
.pytest_cache/
data/
# Voice KB corpus is version-controlled — deploys with the code
!api/data/voice_kb/
!api/data/voice_kb/**
*.json.bak
backups/
.superpowers/
app/public/dev-login.html

# Mobile audit screenshots (local only)
tools/mobile_audit_out/

# Local UI consistency sweep output (screenshots + font probe)
tools/ui_sweep_out/

# Chart parity gate captures + diffs (local only; regenerate with tools/chart_parity.py)
tools/chart_parity_out/
# ...and every SUFFIXED output dir. B5 Task 11 ran six pairs at once
# (--out tools/chart_parity_out_main, _sep, _axis, _hgt, _bandsdet,
# _panesdet); only the bare name was ignored, so a 3,000-PNG scratch dir
# showed up as untracked next to the commit it must never be part of.
tools/chart_parity_out_*/
# The built dists a parity run serves (`cp -r app/dist .parity-dist-a`).
.parity-dist-*/

# Alert replay scratch output (`tools/alert_replay.py --diff --out …`). Multi-MB
# per run and regenerable; the COMMITTED artifacts of that tool are
# tests/fixtures/alerts/{replay_bars,fire_log_forming,fire_diff_declared}.json.
tools/alert_replay_out/
tools/_local_backend.log

# SnapTrade smoke-test state (contains a userSecret)
tools/.snaptrade_smoke_state.json
tools/.snaptrade_captures/

# Desk video taxonomy dump/apply working files (local only)
tools/taxonomy_out/

# Local Python virtual environment (local dev only)
.venv/

# Pine intake bench — pasted scripts are evidence, never committed fixtures
tests/fixtures/pine-inbox/
tests/fixtures/thinkscript-inbox/

# UI stress harness output (screenshots + findings; regenerated per run)
tools/ui_stress_out*/
tools/ui_stress_out_run*.log

# Per-run lane scratch (backups, mutation captures, baseline stdout/stderr).
# Untracked and disposable; listed so an accidental `git add -A` cannot sweep it in.
/scratchpad/
